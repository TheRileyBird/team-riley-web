---
import '../styles/global.css';
import BookingModal from '../components/BookingModal.astro';
import socialShareImage from '../assets/images/Team-Riley-Social-Share.png';

interface Props {
  title: string;
  description?: string;
  robots?: string;
}

const {
  title,
  description = "Team Riley Web - Digital Health For Your Business",
  robots
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialShareImageUrl = new URL(socialShareImage.src, Astro.site);
const socialShareImageAlt = 'Team Riley Web - Digital Health For Your Business';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
          new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-KLGBNQ8P');</script>
    <!-- End Google Tag Manager -->

    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="viewport" content="width=device-width" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:site_name" content="Team Riley Web" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialShareImageUrl} />
    <meta property="og:image:secure_url" content={socialShareImageUrl} />
    <meta property="og:image:type" content={`image/${socialShareImage.format}`} />
    <meta property="og:image:width" content={socialShareImage.width} />
    <meta property="og:image:height" content={socialShareImage.height} />
    <meta property="og:image:alt" content={socialShareImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialShareImageUrl} />
    <meta name="twitter:image:alt" content={socialShareImageAlt} />

    <title>{title}</title>
  </head>
  <body class="font-sans text-gray-800 antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KLGBNQ8P"
                      height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <slot />
    <BookingModal />

    <script is:inline src="https://app.teamrileyweb.com/js/form_embed.js"></script>
    <script src="https://beta.leadconnectorhq.com/loader.js" data-resources-url="https://beta.leadconnectorhq.com/chat-widget/loader.js" data-widget-id="6a14e7d9ee7b17216c7ee4b7"></script>
    <script
      src="https://app.teamrileyweb.com/js/external-tracking.js"
      data-tracking-id="tk_898b61fdfd724c8db3ed5fd5dcab5134">
    </script>
  </body>
</html>
