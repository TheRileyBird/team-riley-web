---
/**
 * Portfolio. Sections, cards and the feature panel all come from the active
 * market's content file (src/verticals/<market>/content.ts) — this page owns the
 * layout, never the work.
 *
 *   content.portfolio.sections[] ──▶ PortfolioCarousel (4+ cards) or a grid
 *                                └──▶ PortfolioCard per project
 *   content.portfolio.feature    ──▶ the full-width highlight panel (optional)
 *   content.portfolio.reviews    ──▶ floating client quotes (empty = none rendered)
 *
 * A market with no clients of its own shows concept work, labelled by the card, and
 * no reviews at all rather than another market's praise.
 */
import { content, site } from '../../active';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navigation from '../../../components/Navigation.astro';
import PageHeader from '../../../components/PageHeader.astro';
import ClientReviewMessages from '../../../components/ClientReviewMessages.astro';
import PortfolioCarousel from '../../../components/PortfolioCarousel.astro';
import PortfolioCard from '../../../components/PortfolioCard.astro';
import SectionHeader from '../../../components/SectionHeader.astro';
import Footer from '../../../components/Footer.astro';
import {
  ExternalLink, Smartphone, Zap, Globe, Stethoscope, Dumbbell, Sparkles, Scale,
  Gavel, Users, LineChart, PiggyBank, ShieldCheck
} from '@lucide/astro';
import { Image } from 'astro:assets';

const { header, sections, feature, reviews } = content.portfolio;

const sectionIcons: Record<string, typeof Scale> = {
  stethoscope: Stethoscope,
  dumbbell: Dumbbell,
  sparkles: Sparkles,
  gavel: Gavel,
  users: Users,
  'line-chart': LineChart,
  'piggy-bank': PiggyBank,
  shield: ShieldCheck
};

const sectionStyles = {
  primary: {
    background: 'bg-white',
    tile: 'from-primary-500 to-primary-600',
    pill: 'bg-primary-100 text-primary-700'
  },
  secondary: {
    background: 'bg-gradient-to-b from-secondary-300/10 to-white',
    tile: 'from-secondary-500 to-secondary-600',
    pill: 'bg-secondary-300/20 text-secondary-700'
  },
  accent: {
    background: 'bg-gradient-to-b from-accent-50/50 to-white',
    tile: 'from-accent-500 to-accent-600',
    pill: 'bg-accent-100 text-accent-700'
  }
};

// Two quotes float beside each section, alternating sides, until we run out.
const reviewPositions = [{ top: '-1rem' }, { bottom: '-1.5rem' }];
const reviewsForSection = (index: number) =>
  reviews.slice(index * 2, index * 2 + 2).map((review, offset) => ({
    ...review,
    side: (index * 2 + offset) % 2 === 0 ? 'right' : 'left',
    ...(reviewPositions[offset] ?? { top: '0rem' })
  }));
---

<BaseLayout title={content.portfolio.title} description={content.portfolio.description}>
  <Navigation />

  <main class="relative overflow-hidden">
    <PageHeader
      badge="Our Work"
      title={`<span class="animated-gradient-text">${header.heading.highlight}</span> <span class="text-gray-900"><br class="hidden lg:block">${header.heading.trail ?? ''}</span>`}
      subtitle={header.subtitle}
    />

    {sections.map((section, index) => {
      const Icon = sectionIcons[section.icon] ?? Scale;
      const styles = sectionStyles[section.color];
      return (
        <section
          id={section.id}
          class:list={[
            'relative overflow-visible pb-20 md:pb-28 scroll-mt-32',
            index > 0 ? 'pt-20 md:pt-28' : 'pt-12 md:pt-16',
            styles.background
          ]}
        >
          <ClientReviewMessages reviews={reviewsForSection(index)} />
          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center gap-4 mb-4">
              <div class={`w-14 h-14 bg-gradient-to-br ${styles.tile} rounded-2xl flex items-center justify-center`}>
                <Icon class="w-7 h-7 text-white" />
              </div>
              <div>
                <span class:list={['inline-block px-3 py-1 text-sm font-semibold rounded-full mb-1', styles.pill]}>
                  {section.pill}
                </span>
                <h2 class="text-3xl md:text-4xl font-bold text-gray-900">{section.heading}</h2>
              </div>
            </div>
            <p class="text-lg text-gray-600 mb-12 max-w-3xl">{section.intro}</p>

            {section.carousel ? (
              <PortfolioCarousel color={section.color}>
                {section.projects.map((project) => (
                  <PortfolioCard project={project} color={section.color} />
                ))}
              </PortfolioCarousel>
            ) : (
              <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                {section.projects.map((project) => (
                  <PortfolioCard project={project} color={section.color} />
                ))}
              </div>
            )}
          </div>
        </section>
      );
    })}

    {feature && (
      <section
        id={feature.sectionId}
        class="relative overflow-hidden py-20 md:py-28 bg-gradient-to-b from-ink-950 via-ink-900 to-ink-950 scroll-mt-32"
      >
        <div class="absolute inset-0 opacity-20">
          <div class="absolute -top-20 right-10 w-96 h-96 bg-primary-600 rounded-full blur-3xl"></div>
          <div class="absolute bottom-0 left-10 w-80 h-80 bg-accent-500 rounded-full blur-3xl"></div>
        </div>

        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="max-w-7xl mx-auto items-center flex flex-col text-center">
            <div class="items-center gap-4 mb-4">
              <div class="flex flex-col items-center">
                <div class="w-14 h-14 mb-3 bg-gradient-to-br from-gray-100 to-white rounded-2xl flex items-center justify-center shadow-large">
                  <Scale class="w-7 h-7 text-gray-950" />
                </div>
                <h2 class="text-3xl md:text-4xl font-bold text-white">{feature.sectionHeading}</h2>
              </div>
            </div>
            <p class="text-lg text-gray-300 mb-12 max-w-xl">{feature.sectionIntro}</p>
          </div>

          <div class="grid lg:grid-cols-[1.1fr_.9fr] gap-0 overflow-hidden rounded-3xl border border-white/10 bg-white shadow-2xl">
            <div class="relative min-h-[320px] lg:min-h-[520px] overflow-hidden bg-gray-100">
              <Image src={feature.image} alt={feature.imageAlt} class="w-full h-full object-cover object-top" />
            </div>

            <div class="p-8 md:p-12 flex flex-col justify-center">
              <div class="w-14 h-14 rounded-2xl bg-ink-950 flex items-center justify-center mb-8 shadow-medium">
                <Scale class="w-7 h-7 text-white" />
              </div>
              <span class="text-sm font-bold text-primary-700 uppercase tracking-wider mb-3">{feature.eyebrow}</span>
              <h3 class="text-3xl md:text-4xl font-bold text-gray-900 mb-5">{feature.name}</h3>
              <p class="text-xl font-semibold text-gray-800 mb-5">{feature.subtitle}</p>
              {feature.paragraphs.map((paragraph) => (
                <p class="text-gray-700 leading-relaxed mb-6">{paragraph}</p>
              ))}
              <div class="flex flex-wrap gap-2 mb-8 mt-2">
                {feature.tags.map((tag) => (
                  <span class="px-3 py-1 bg-gray-100 text-gray-800 text-sm rounded-full">{tag}</span>
                ))}
              </div>
              {feature.href && (
                <a
                  href={feature.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-primary-700 font-semibold hover:text-primary-800 transition-colors"
                >
                  View Live Site
                  <ExternalLink class="w-4 h-4" />
                </a>
              )}
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Process Highlight -->
    <section class="relative overflow-hidden py-20 md:py-28 bg-gradient-to-b from-gray-100 to-white">
      <ClientReviewMessages reviews={reviewsForSection(sections.length)} />
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <SectionHeader
          badge="Our Process"
          title="Dedicated Care for Every Project"
          subtitle="Here's what you can expect when you work with us"
        />

        <div class="grid md:grid-cols-3 gap-8 mb-12">
          <div class="text-center p-8 bg-white rounded-2xl border border-gray-200 hover:shadow-large transition-all duration-300">
            <div class="w-16 h-16 bg-gradient-to-br from-primary-600 to-primary-700 rounded-full flex items-center justify-center mx-auto mb-6">
              <Smartphone class="w-8 h-8 text-white" />
            </div>
            <h4 class="text-xl font-bold text-gray-900 mb-3">Mobile-First Design</h4>
            <p class="text-gray-700">Every site is designed for mobile devices first, ensuring the best experience for all visitors.</p>
          </div>

          <div class="text-center p-8 bg-white rounded-2xl border border-gray-200 hover:shadow-large transition-all duration-300">
            <div class="w-16 h-16 bg-gradient-to-br from-accent-400 to-accent-500 rounded-full flex items-center justify-center mx-auto mb-6">
              <Zap class="w-8 h-8 text-white" />
            </div>
            <h4 class="text-xl font-bold text-gray-900 mb-3">Lightning Fast</h4>
            <p class="text-gray-700">Optimized performance means faster loading times, better SEO, and happier visitors.</p>
          </div>

          <div class="text-center p-8 bg-white rounded-2xl border border-gray-200 hover:shadow-large transition-all duration-300">
            <div class="w-16 h-16 bg-gradient-to-br from-secondary-500 to-secondary-600 rounded-full flex items-center justify-center mx-auto mb-6">
              <Globe class="w-8 h-8 text-white" />
            </div>
            <h4 class="text-xl font-bold text-gray-900 mb-3">SEO Foundations</h4>
            <p class="text-gray-700">Clean page structure, titles, meta descriptions and indexing setup on every page, so search engines can crawl and understand your site.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
