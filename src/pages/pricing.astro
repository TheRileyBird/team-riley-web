---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PricingSection from '../components/PricingSection.astro';
import ServiceColumnSection from '../components/ServiceColumnSection.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Pricing - Team Riley" description="Simple, transparent pricing for professional web design and development services">
  <Navigation />

  <PageHeader
    badge="Simple Pricing"
    title='<span class="animated-gradient-text">Zero</span> <span class="text-gray-900">Friction</span>'
    subtitle="All plans include unlimited updates, ongoing support, and no hidden fees. Cancel anytime."
  />

  <!-- Pricing Section -->
  <PricingSection showHeader={false} />

  <!-- Client Growth AI Platform -->
  <ServiceColumnSection
    serviceName="Patient Flow"
    serviceHighlight="AI"
    description="Client Growth AI automation that helps health clinics capture more leads, book more appointments, and grow faster"
    subDescription="Complete business automation · Lead management · Patient engagement · Marketing campaigns"
    theme="dark"
    blurColors={{ top: 'bg-cyan-600', bottom: 'bg-blue-500' }}
    reverse={false}
    tiers={[
      {
        name: 'Basic Automation System',
        price: '$97',
        priceUnit: '/month',
        description: 'Best for small practices',
        features: [
          'CRM for leads',
          'Calendar booking',
          'Missed-call text back',
          'Basic lead capture',
          'Central inbox'
        ]
      },
      {
        name: 'Growth Automation',
        price: '$197',
        priceUnit: '/month',
        description: 'Our proven growth system',
        features: [
          'Everything above',
          'Automated follow-ups',
          'Appointment reminders',
          'Review generation',
          'Lead pipelines',
          'Monthly optimization'
        ],
        featured: true
      },
      {
        name: 'AI Growth System',
        price: '$297',
        priceUnit: '/month',
        description: 'For clinics ready to scale',
        features: [
          'AI lead responder',
          'Advanced automation',
          'Marketing campaigns',
          'Landing pages',
          'Reporting dashboards'
        ]
      }
    ]}
  />

  <!-- Social Media Management -->
  <ServiceColumnSection
    serviceName="Social Media"
    serviceHighlight="Management"
    description="Consistent, engaging social media content that builds your brand and connects with your audience"
    subDescription="Content creation · Strategic planning · Community engagement · Performance tracking · Brand storytelling"
    theme="light"
    reverse={true}
    tiers={[
      {
        name: 'Basic',
        price: '$199',
        priceUnit: '/month',
        description: 'Perfect for consistent content',
        features: [
          '$99 one-time setup fee',
          '4 Posts Per Month',
          'Custom branded graphics and captions',
          'Profile Optimization (Bio, Links, Branding)',
          'Instagram or Facebook or LinkedIn'
        ],
        additionalNote: '+$150 per additional platform'
      },
      {
        name: 'Essential',
        price: '$299',
        priceUnit: '/month',
        description: 'Ideal for busy professionals',
        features: [
          '$149 one-time setup fee',
          '6 Posts Per Month',
          '1 Reel Per Month',
          'Custom branded graphics and captions',
          'Profile Optimization (Bio, Links, Branding)'
        ],
        featured: true,
        additionalNote: '+$150 per additional platform'
      },
      {
        name: 'Essential Plus',
        price: '$499',
        priceUnit: '/month',
        description: 'Consistent and engaging presence',
        features: [
          '$149 one-time setup fee',
          '10 Posts Per Month',
          '3 Reels Per Month',
          'Custom branded graphics and captions',
          'Profile Optimization (Bio, Links, Branding)'
        ],
        additionalNote: '+$150 per additional platform'
      },
      {
        name: 'Strategist',
        price: '$740',
        priceUnit: '/month',
        description: 'For growing businesses',
        features: [
          '$375 one-time setup fee',
          '12 Posts Per Month',
          '5 Reels Per Month',
          'Custom branded graphics and captions',
          'Profile Optimization (Bio, Links, Branding)',
          'Direct Slack Channel for Instant Communication'
        ],
        additionalNote: '+$150 per additional platform'
      },
      {
        name: 'Influencer',
        price: '$2,500',
        priceUnit: '/month',
        description: 'High-performing content strategy',
        features: [
          '$750 one-time setup fee',
          '20 Posts Per Month',
          'Up to 8 Reels Per Month',
          'Custom branded graphics and captions',
          'Profile Optimization (Bio, Links, Branding)',
          'Monthly Content Strategy Plan',
          'Direct Slack Channel for Instant Communication'
        ],
        additionalNote: '+$150 per additional platform'
      },
      {
        name: 'Influencer Plus',
        price: '$3,500',
        priceUnit: '/month',
        description: 'Premium content production',
        features: [
          '$750 one-time setup fee',
          '20 Posts Per Month',
          'Up to 10 Reels Per Month',
          'Custom branded graphics and captions',
          'Profile Optimization (Bio, Links, Branding)',
          'Monthly Content Strategy Plan',
          'Direct Slack Channel for Instant Communication',
          'Monthly 2 hour Photo/Video Shoot'
        ],
        additionalNote: '+$150 per additional platform'
      }
    ]}
  />

  <!-- SEO Services -->
  <ServiceColumnSection
    serviceName="Search Engine"
    serviceHighlight="Optimization"
    description="Rank higher in Google and get found by clients actively searching for your services"
    subDescription="Monthly performance reports · Keyword research · Local SEO · Content creation · Technical optimization"
    theme="dark"
    blurColors={{ top: 'bg-primary-600', bottom: 'bg-cyan-500' }}
    additionalNote="Additional locations: $300/month each"
    reverse={false}
    tiers={[
      {
        name: 'Silver',
        price: '$1,000',
        priceUnit: '/month',
        description: 'Perfect for single-location practices',
        features: [
          'Up to 3 locations',
          'Up to 100 keywords tracked',
          '6 SEO blog posts/year',
          '4 specialty pages/year'
        ],
        setupFee: '$500 one-time setup fee'
      },
      {
        name: 'Gold',
        price: '$1,800',
        priceUnit: '/month',
        description: 'Most popular for growing practices',
        features: [
          'Up to 6 locations',
          'Up to 250 keywords tracked',
          '14 SEO blog posts/year',
          '10 specialty pages/year'
        ],
        setupFee: '$500 one-time setup fee',
        featured: true
      },
      {
        name: 'Platinum',
        price: '$3,200',
        priceUnit: '/month',
        description: 'Enterprise-level SEO strategy',
        features: [
          'Up to 9 locations',
          'Up to 500 keywords tracked',
          '24 SEO blog posts/year',
          '20 specialty pages/year'
        ],
        setupFee: '$500 one-time setup fee'
      }
    ]}
  />

  <!-- PPC Management -->
  <ServiceColumnSection
    serviceName="PPC"
    serviceHighlight="Management"
    description="Google, Bing, and YouTube ads that target the right clients at the right time"
    subDescription="Campaign setup · Keyword research · Ad copywriting · Bid optimization · Monthly reporting"
    theme="light"
    reverse={true}
    tiers={[
      {
        name: 'Silver',
        price: '25%',
        priceUnit: 'mgmt fee',
        description: 'Start driving qualified traffic',
        features: [
          '$1,400 min. monthly ad spend',
          '$350 minimum management fee',
          'Google & Bing campaigns',
          'Monthly performance reports'
        ],
        setupFee: '$500 one-time setup fee'
      },
      {
        name: 'Gold',
        price: '20%',
        priceUnit: 'mgmt fee',
        description: 'Optimized campaign management',
        features: [
          '$2,400 min. monthly ad spend',
          '$480 minimum management fee',
          'Advanced audience targeting',
          'A/B testing & optimization'
        ],
        setupFee: '$500 one-time setup fee',
        featured: true
      },
      {
        name: 'Platinum',
        price: '15%',
        priceUnit: 'mgmt fee',
        description: 'Enterprise PPC strategy',
        features: [
          '$4,000 min. monthly ad spend',
          '$600 minimum management fee',
          'Multi-platform campaigns',
          'Dedicated account manager'
        ],
        setupFee: '$500 one-time setup fee'
      }
    ]}
  />

  <!-- Social Advertising -->
  <ServiceColumnSection
    serviceName="Social"
    serviceHighlight="Advertising"
    description="Facebook and Instagram ads that reach your ideal clients where they spend their time"
    subDescription="Audience targeting · Creative design · Campaign management · Conversion tracking · Performance analytics"
    theme="dark"
    blurColors={{ top: 'bg-purple-600', bottom: 'bg-pink-500' }}
    reverse={false}
    tiers={[
      {
        name: 'Silver',
        price: '30%',
        priceUnit: 'mgmt fee',
        description: 'Build your social presence',
        features: [
          '$1,400 min. monthly ad spend',
          '$420 minimum management fee',
          'Facebook & Instagram ads',
          'Audience research & targeting'
        ],
        setupFee: '$1,000 one-time setup fee'
      },
      {
        name: 'Gold',
        price: '25%',
        priceUnit: 'mgmt fee',
        description: 'Strategic social campaigns',
        features: [
          '$2,400 min. monthly ad spend',
          '$600 minimum management fee',
          'Advanced lookalike audiences',
          'Creative testing & optimization'
        ],
        setupFee: '$1,000 one-time setup fee',
        featured: true
      },
      {
        name: 'Platinum',
        price: '20%',
        priceUnit: 'mgmt fee',
        description: 'Full-scale social strategy',
        features: [
          '$4,000 min. monthly ad spend',
          '$800 minimum management fee',
          'Multi-platform campaigns',
          'Conversion rate optimization'
        ],
        setupFee: '$1,000 one-time setup fee'
      }
    ]}
  />

  <!-- eCommerce Management -->
  <ServiceColumnSection
    serviceName="eCommerce"
    serviceHighlight="Management"
    description="Complete online store management that transforms your eCommerce operation into a revenue-generating machine"
    subDescription="Store maintenance · Product management · Conversion optimization · Performance tracking · Strategic support"
    theme="light"
    reverse={true}
    tiers={[
      {
        name: 'Silver',
        price: '$399',
        priceUnit: '/month',
        description: 'Best for new or low-volume stores',
        features: [
          'Basic store maintenance (themes, plugins, updates)',
          'Product uploads (up to ~25/mo)',
          'Basic reporting',
          'Email support'
        ],
        setupFee: '$500 one-time setup fee'
      },
      {
        name: 'Gold',
        price: '$699',
        priceUnit: '/month',
        description: 'Best for stores doing consistent sales',
        features: [
          'Everything in Silver',
          'Product management (up to ~75/mo)',
          'Conversion tweaks (CRO light)',
          'App + integration management',
          'Monthly performance reporting',
          'Basic email/SMS campaign support'
        ],
        setupFee: '$750 one-time setup fee',
        featured: true
      },
      {
        name: 'Platinum',
        price: '$1,200',
        priceUnit: '/month',
        description: 'Best for serious e-comm businesses',
        features: [
          'Everything in Gold',
          'Advanced CRO (landing pages, A/B testing)',
          'Funnel optimization',
          'Product + collection strategy',
          'Weekly reporting / insights',
          'Priority support'
        ],
        setupFee: '$1,000 one-time setup fee'
      },
      {
        name: 'Enterprise',
        price: '$2,500–$5,000',
        priceUnit: '/month',
        description: 'Best for $50k–$250k+/mo stores',
        features: [
          'Full store management',
          'CRO + revenue optimization',
          'Offer strategy',
          'Lifecycle marketing oversight (email/SMS)',
          'Team coordination (ads, creatives, etc.)',
          'Slack-level access / fast response'
        ],
        setupFee: '$1,500+ one-time setup fee',
        additionalNote: 'Optional add-on: 1–3% of revenue once threshold is reached'
      }
    ]}
  />

  <!-- Branding & Design -->
  <ServiceColumnSection
    serviceName="Branding &"
    serviceHighlight="Design"
    description="Professional logo design and brand identity that makes your practice stand out"
    subDescription="Logo design · Brand guidelines · Color palettes · Typography · Marketing materials"
    theme="dark"
    blurColors={{ top: 'bg-teal-600', bottom: 'bg-red-500' }}
    reverse={false}
    tiers={[
      {
        name: 'Logo & Branding',
        price: '$150',
        priceUnit: '/hour',
        description: 'Complete brand identity package',
        features: [
          '10 hour minimum project',
          'Custom logo design',
          'Brand style guide',
          'Multiple revisions included'
        ]
      },
      {
        name: 'Graphic Design',
        price: '$150',
        priceUnit: '/hour',
        description: 'Custom graphics and visuals',
        features: [
          '4 hour minimum project',
          'Social media graphics',
          'Print materials',
          'Marketing collateral'
        ]
      }
    ]}
  />

  <!-- FAQ Section -->
  <section class="py-20 md:py-28 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader
        title="Frequently Asked Questions"
        subtitle="Everything you need to know about our pricing and services"
      />

      <div class="space-y-6">
        <details class="group p-6 bg-white border border-gray-200 rounded-xl hover:border-primary-600 transition-colors">
          <summary class="cursor-pointer font-semibold text-lg text-gray-900 list-none flex items-center justify-between">
            What's included in "Unlimited Updates"?
            <span class="text-primary-600 group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-4 text-gray-700 leading-relaxed">
            Unlimited updates means you can request as many changes to your website as you need—content updates, image changes, new pages, feature additions, and more. There are no hourly rates and no surprise bills.
          </p>
        </details>

        <details class="group p-6 bg-white border border-gray-200 rounded-xl hover:border-primary-600 transition-colors">
          <summary class="cursor-pointer font-semibold text-lg text-gray-900 list-none flex items-center justify-between">
            Can I upgrade or downgrade my plan?
            <span class="text-primary-600 group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-4 text-gray-700 leading-relaxed">
            Yes! You can upgrade or downgrade your plan at any time. The change will take effect on your next billing cycle.
          </p>
        </details>

        <details class="group p-6 bg-white border border-gray-200 rounded-xl hover:border-primary-600 transition-colors">
          <summary class="cursor-pointer font-semibold text-lg text-gray-900 list-none flex items-center justify-between">
            What happens if I cancel?
            <span class="text-primary-600 group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-4 text-gray-700 leading-relaxed">
            You can cancel anytime with no penalties. Your site will remain live until the end of your billing period, and you'll own all the content you created.
          </p>
        </details>

        <details class="group p-6 bg-white border border-gray-200 rounded-xl hover:border-primary-600 transition-colors">
          <summary class="cursor-pointer font-semibold text-lg text-gray-900 list-none flex items-center justify-between">
            Do you offer custom quotes?
            <span class="text-primary-600 group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-4 text-gray-700 leading-relaxed">
            Yes! If you need more than 15 pages or have specific requirements, contact us for a custom quote tailored to your needs.
          </p>
        </details>

        <details class="group p-6 bg-white border border-gray-200 rounded-xl hover:border-primary-600 transition-colors">
          <summary class="cursor-pointer font-semibold text-lg text-gray-900 list-none flex items-center justify-between">
            How long does it take to launch?
            <span class="text-primary-600 group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-4 text-gray-700 leading-relaxed">
            Most sites launch within 2 weeks. We'll work with you to create a timeline that fits your needs and goals.
          </p>
        </details>

        <details class="group p-6 bg-white border border-gray-200 rounded-xl hover:border-primary-600 transition-colors">
          <summary class="cursor-pointer font-semibold text-lg text-gray-900 list-none flex items-center justify-between">
            What do I pay when I sign up?
            <span class="text-primary-600 group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-4 text-gray-700 leading-relaxed">
            When you sign up, you'll pay a one-time $500 setup fee plus a prorated charge for the remainder of your first month based on your chosen plan. After that, you're billed monthly on the 1st of each month.
          </p>
        </details>

        <details class="group p-6 bg-white border border-gray-200 rounded-xl hover:border-primary-600 transition-colors">
          <summary class="cursor-pointer font-semibold text-lg text-gray-900 list-none flex items-center justify-between">
            Are there any hidden fees or extra costs?
            <span class="text-primary-600 group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-4 text-gray-700 leading-relaxed">
            No hidden fees. Your monthly subscription includes professional hosting, SSL security, regular backups, and unlimited updates. The only additional cost is your domain name registration, which you maintain separately (typically $10-20/year).
          </p>
        </details>

        <details class="group p-6 bg-white border border-gray-200 rounded-xl hover:border-primary-600 transition-colors">
          <summary class="cursor-pointer font-semibold text-lg text-gray-900 list-none flex items-center justify-between">
            Do I own my website if I cancel?
            <span class="text-primary-600 group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-4 text-gray-700 leading-relaxed">
            Yes, you own everything. All content, images, HTML files, CSS, and JavaScript are 100% yours. If you ever cancel, we'll provide a complete export of your website files that you can take to any other hosting provider.
          </p>
        </details>

        <details class="group p-6 bg-white border border-gray-200 rounded-xl hover:border-primary-600 transition-colors">
          <summary class="cursor-pointer font-semibold text-lg text-gray-900 list-none flex items-center justify-between">
            Is there a long-term contract?
            <span class="text-primary-600 group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-4 text-gray-700 leading-relaxed">
            No long-term contracts. Our service is month-to-month, and you can cancel anytime with no penalties. We believe in earning your business every month, not locking you in.
          </p>
        </details>

        <details class="group p-6 bg-white border border-gray-200 rounded-xl hover:border-primary-600 transition-colors">
          <summary class="cursor-pointer font-semibold text-lg text-gray-900 list-none flex items-center justify-between">
            How fast are update requests completed?
            <span class="text-primary-600 group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-4 text-gray-700 leading-relaxed">
            Most updates are completed within 1-2 business days, and simple changes often within hours. For larger requests, we'll give you a timeline upfront so you know what to expect.
          </p>
        </details>

        <details class="group p-6 bg-white border border-gray-200 rounded-xl hover:border-primary-600 transition-colors">
          <summary class="cursor-pointer font-semibold text-lg text-gray-900 list-none flex items-center justify-between">
            Can I use my own domain name?
            <span class="text-primary-600 group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-4 text-gray-700 leading-relaxed">
            Yes, you can keep and use your existing domain name. We recommend you maintain ownership of your domain in your own registrar account for maximum control.
          </p>
        </details>

        <details class="group p-6 bg-white border border-gray-200 rounded-xl hover:border-primary-600 transition-colors">
          <summary class="cursor-pointer font-semibold text-lg text-gray-900 list-none flex items-center justify-between">
            Is this a template or custom design?
            <span class="text-primary-600 group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-4 text-gray-700 leading-relaxed">
            Every website we create is 100% custom designed. We don't use templates—your site will be uniquely crafted to reflect your brand identity and business goals.
          </p>
        </details>

        <details class="group p-6 bg-white border border-gray-200 rounded-xl hover:border-primary-600 transition-colors">
          <summary class="cursor-pointer font-semibold text-lg text-gray-900 list-none flex items-center justify-between">
            What if I don't like the design?
            <span class="text-primary-600 group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-4 text-gray-700 leading-relaxed">
            We work closely with you throughout the design process to ensure you love the result. Revisions are included, and we won't launch until you're completely satisfied with your site.
          </p>
        </details>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
