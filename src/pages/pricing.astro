---

<BaseLayout title="Pricing - Team Riley" description="Simple, transparent pricing for professional web design and development services">
  <Navigation />

  <PageHeader
    badge="Simple Pricing"
    title='<span class="animated-gradient-text">Zero</span> <span class="text-gray-900">Friction</span>'
    subtitle="All plans include unlimited updates, ongoing support, and no hidden fees. Cancel anytime."
  />

  <!-- Pricing Section -->
  <PricingSection showHeader={false} />

  <!--
    Anchor homes for retired sections. Ongoing SEO is archived, so an old
    /pricing#search-engine-optimization link lands on the website plans, where the
    SEO Foundations explainer now lives.
  -->
  {retiredAnchors.map((anchor) => (
    <span id={anchor} class="pointer-events-none block h-0 w-0" aria-hidden="true"></span>
  ))}

  <!--
    Every priced service, in order, from src/data/services.ts. Adding, reordering,
    repricing or retiring a service is an edit to that file — never to this markup.
    theme and reverse come from the index among VISIBLE services so archiving one
    service cannot flip the colors of every section after it.
  -->
  {visibleServices.map((service, index) => (
    <ServiceColumnSection
      service={service}
      theme={themeForIndex(index)}
      reverse={reverseForIndex(index)}
    />
  ))}

  <!-- FAQ Section -->
  <section class="py-20 md:py-28 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader
        title="Frequently Asked Questions"
        subtitle="Everything you need to know about our pricing and services"
      />

      <div class="space-y-8">
        {faqSections.map((section) => (
          <div class="rounded-2xl border border-gray-200/80 bg-white/90 p-5 shadow-soft sm:p-6">
            <div class="mb-2 flex items-center gap-3">
              <span class="h-px w-8 bg-gradient-to-r from-primary-600 to-accent-500"></span>
              <h3 class="text-sm font-semibold uppercase tracking-wider text-primary-700">{section.title}</h3>
            </div>

            <div class="divide-y divide-gray-200">
              {section.items.map((item) => (
                <details class="group">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-left text-base font-semibold text-gray-900 transition-colors hover:text-primary-700">
                    <span>{item.question}</span>
                    <span class="shrink-0 text-lg leading-none text-primary-600 transition-transform group-open:rotate-45">+</span>
                  </summary>
                  <div class="p-5 text-sm leading-relaxed text-gray-700 bg-stone-100 sm:text-base">
                    {item.answer.map((block) => (
                      Array.isArray(block) ? (
                        <ul class="my-3 grid gap-2 pl-5 sm:grid-cols-2">
                          {block.map((listItem) => (
                            <li class="list-disc">{listItem}</li>
                          ))}
                        </ul>
                      ) : (
                        <p class="mt-3 first:mt-0">{block}</p>
                      )
                    ))}
                  </div>
                </details>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
