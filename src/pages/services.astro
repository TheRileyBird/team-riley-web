---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Footer from '../components/Footer.astro';
import { Rocket, Smartphone, Zap, Globe, Palette, Code, LineChart, Shield, Bot, ArrowRight, Sparkles, TrendingUp, Users } from '@lucide/astro';
---

<BaseLayout title="Services - Team Riley" description="Professional web design and development services for health and wellness businesses">
  <Navigation />

  <PageHeader
    badge="What We Offer"
    title='<span class="text-gray-900">We Know</span> <span class="animated-gradient-text">Health & Wellness</span>'
    subtitle="From custom design to ongoing support, we provide everything you need to grow your online presence and attract more clients."
  />

  <!-- Services Grid -->
  <section class="pb-20 md:pb-28 bg-white relative overflow-hidden">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Service 1 -->
        <div class="group p-8 bg-gradient-to-br from-white to-gray-50 rounded-2xl border border-gray-200 hover:border-primary-600 hover:shadow-xl transition-all duration-300">
          <div class="w-14 h-14 bg-gradient-to-br from-primary-600 to-primary-700 rounded-xl flex items-center justify-center mb-6">
            <Rocket class="w-7 h-7 text-white" />
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-3">Custom Web Design</h3>
          <p class="text-gray-700 leading-relaxed mb-4">
            Unique, brand-aligned designs that set you apart from competitors and resonate with your target audience.
          </p>
          <ul class="space-y-2 text-sm text-gray-600">
            <li class="flex items-start gap-2">
              <span class="text-primary-600 mt-0.5">✓</span>
              <span>Mobile-first responsive design</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-primary-600 mt-0.5">✓</span>
              <span>Brand identity integration</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-primary-600 mt-0.5">✓</span>
              <span>User experience optimization</span>
            </li>
          </ul>
        </div>

        <!-- Service 2 -->
        <div class="group p-8 bg-gradient-to-br from-white to-gray-50 rounded-2xl border border-gray-200 hover:border-primary-600 hover:shadow-xl transition-all duration-300">
          <div class="w-14 h-14 bg-gradient-to-br from-cyan-600 to-blue-700 rounded-xl flex items-center justify-center mb-6">
            <Code class="w-7 h-7 text-white" />
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-3">Development</h3>
          <p class="text-gray-700 leading-relaxed mb-4">
            Clean, modern code built on the latest web technologies for fast, secure, and scalable websites.
          </p>
          <ul class="space-y-2 text-sm text-gray-600">
            <li class="flex items-start gap-2">
              <span class="text-primary-600 mt-0.5">✓</span>
              <span>Lightning-fast performance</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-primary-600 mt-0.5">✓</span>
              <span>SEO-optimized structure</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-primary-600 mt-0.5">✓</span>
              <span>Secure & reliable hosting</span>
            </li>
          </ul>
        </div>

        <!-- Service 3 -->
        <div class="group p-8 bg-gradient-to-br from-white to-gray-50 rounded-2xl border border-gray-200 hover:border-primary-600 hover:shadow-xl transition-all duration-300">
          <div class="w-14 h-14 bg-gradient-to-br from-blue-600 to-cyan-600 rounded-xl flex items-center justify-center mb-6">
            <Zap class="w-7 h-7 text-white" />
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-3">Performance Optimization</h3>
          <p class="text-gray-700 leading-relaxed mb-4">
            Fast loading speeds that keep visitors engaged and improve your search engine rankings.
          </p>
          <ul class="space-y-2 text-sm text-gray-600">
            <li class="flex items-start gap-2">
              <span class="text-primary-600 mt-0.5">✓</span>
              <span>Image optimization</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-primary-600 mt-0.5">✓</span>
              <span>Code minification</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-primary-600 mt-0.5">✓</span>
              <span>CDN integration</span>
            </li>
          </ul>
        </div>

        <!-- Service 4 -->
        <div class="group p-8 bg-gradient-to-br from-white to-gray-50 rounded-2xl border border-gray-200 hover:border-primary-600 hover:shadow-xl transition-all duration-300">
          <div class="w-14 h-14 bg-gradient-to-br from-violet-600 to-purple-700 rounded-xl flex items-center justify-center mb-6">
            <Globe class="w-7 h-7 text-white" />
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-3">SEO & Marketing</h3>
          <p class="text-gray-700 leading-relaxed mb-4">
            Get found by potential clients with search engine optimization built into every page.
          </p>
          <ul class="space-y-2 text-sm text-gray-600">
            <li class="flex items-start gap-2">
              <span class="text-primary-600 mt-0.5">✓</span>
              <span>Keyword optimization</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-primary-600 mt-0.5">✓</span>
              <span>Meta tags & schema markup</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-primary-600 mt-0.5">✓</span>
              <span>Analytics integration</span>
            </li>
          </ul>
        </div>

        <!-- Service 5 -->
        <div class="group p-8 bg-gradient-to-br from-white to-gray-50 rounded-2xl border border-gray-200 hover:border-primary-600 hover:shadow-xl transition-all duration-300">
          <div class="w-14 h-14 bg-gradient-to-br from-cyan-500 to-blue-600 rounded-xl flex items-center justify-center mb-6">
            <Smartphone class="w-7 h-7 text-white" />
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-3">Mobile Optimization</h3>
          <p class="text-gray-700 leading-relaxed mb-4">
            Perfect experience on every device, from phones to tablets to desktops.
          </p>
          <ul class="space-y-2 text-sm text-gray-600">
            <li class="flex items-start gap-2">
              <span class="text-primary-600 mt-0.5">✓</span>
              <span>Touch-friendly interfaces</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-primary-600 mt-0.5">✓</span>
              <span>Adaptive layouts</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-primary-600 mt-0.5">✓</span>
              <span>Fast mobile loading</span>
            </li>
          </ul>
        </div>

        <!-- Service 6 -->
        <div class="group p-8 bg-gradient-to-br from-white to-gray-50 rounded-2xl border border-gray-200 hover:border-primary-600 hover:shadow-xl transition-all duration-300">
          <div class="w-14 h-14 bg-gradient-to-br from-purple-600 to-violet-700 rounded-xl flex items-center justify-center mb-6">
            <Shield class="w-7 h-7 text-white" />
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-3">Ongoing Support</h3>
          <p class="text-gray-700 leading-relaxed mb-4">
            Unlimited updates and maintenance included with every plan. No hourly rates, ever.
          </p>
          <ul class="space-y-2 text-sm text-gray-600">
            <li class="flex items-start gap-2">
              <span class="text-primary-600 mt-0.5">✓</span>
              <span>Content updates</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-primary-600 mt-0.5">✓</span>
              <span>Security monitoring</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-primary-600 mt-0.5">✓</span>
              <span>Technical support</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-16">
        <a href="/portfolio" class="btn btn-primary btn-lg">
          View Our Work
          <ArrowRight class="w-5 h-5" />
        </a>
        <a href="/pricing" class="btn btn-secondary btn-lg">
          View Pricing
          <ArrowRight class="w-5 h-5" />
        </a>
      </div>
    </div>
  </section>

  <!-- Patient Flow AI Platform Feature -->
  <section class="py-20 md:py-28 bg-gradient-to-b from-gray-900 via-gray-950 to-black relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-purple-600 rounded-full blur-3xl"></div>
      <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-primary-600 rounded-full blur-3xl"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <!-- Left: Content -->
        <div>
          <div class="inline-flex items-center px-4 py-2 bg-purple-900/50 border-l-4 border-purple-500 rounded-r-lg mb-6">
            <Bot class="w-4 h-4 text-purple-300 mr-2" />
            <span class="text-sm font-bold text-purple-300 uppercase tracking-wider">Patient Flow AI</span>
          </div>

          <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
            Grow Your Practice <span class="animated-gradient-text">On Autopilot</span>
          </h2>

          <p class="text-xl text-gray-300 mb-8">
            More than just a website—get Patient Flow AI, a complete business management platform with AI that answers calls, books appointments, and follows up with leads 24/7.
          </p>

          <div class="space-y-4 mb-8">
            <div class="flex items-start gap-3">
              <svg class="flex-shrink-0 w-8 h-8 mt-1" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="12" r="10" fill="url(#platformGradient1)" />
                <path d="M8 12.5L10.5 15L16 9.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <defs>
                  <linearGradient id="platformGradient1" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" style="stop-color:#9333ea;stop-opacity:1" />
                    <stop offset="100%" style="stop-color:#7c3aed;stop-opacity:1" />
                  </linearGradient>
                </defs>
              </svg>
              <div>
                <h4 class="text-lg font-bold text-white mb-1">AI Phone Agent</h4>
                <p class="text-gray-300">Never miss a call—AI answers, qualifies leads, and books appointments automatically</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <svg class="flex-shrink-0 w-8 h-8 mt-1" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="12" r="10" fill="url(#platformGradient2)" />
                <path d="M8 12.5L10.5 15L16 9.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <defs>
                  <linearGradient id="platformGradient2" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" style="stop-color:#9333ea;stop-opacity:1" />
                    <stop offset="100%" style="stop-color:#7c3aed;stop-opacity:1" />
                  </linearGradient>
                </defs>
              </svg>
              <div>
                <h4 class="text-lg font-bold text-white mb-1">Complete CRM & Automations</h4>
                <p class="text-gray-300">Track leads, automate follow-ups, send emails/SMS, and manage your entire pipeline</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <svg class="flex-shrink-0 w-8 h-8 mt-1" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="12" r="10" fill="url(#platformGradient3)" />
                <path d="M8 12.5L10.5 15L16 9.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <defs>
                  <linearGradient id="platformGradient3" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" style="stop-color:#9333ea;stop-opacity:1" />
                    <stop offset="100%" style="stop-color:#7c3aed;stop-opacity:1" />
                  </linearGradient>
                </defs>
              </svg>
              <div>
                <h4 class="text-lg font-bold text-white mb-1">Funnels, Calendars & Client Portal</h4>
                <p class="text-gray-300">Build landing pages, manage bookings, and deliver courses—all in one platform</p>
              </div>
            </div>
          </div>

          <a href="/platform" class="btn btn-primary btn-lg">
            Explore The Platform
            <ArrowRight class="w-5 h-5" />
          </a>
        </div>

        <!-- Right: Features Grid -->
        <div class="grid grid-cols-2 gap-6">
          <div class="p-6 bg-gradient-to-br from-gray-800/50 to-gray-900/50 rounded-xl border border-purple-500/20">
            <Bot class="w-8 h-8 text-purple-400 mb-3" />
            <h4 class="text-lg font-bold text-white mb-1">AI Agents</h4>
            <p class="text-sm text-gray-300">24/7 call handling</p>
          </div>

          <div class="p-6 bg-gradient-to-br from-gray-800/50 to-gray-900/50 rounded-xl border border-purple-500/20">
            <Sparkles class="w-8 h-8 text-cyan-400 mb-3" />
            <h4 class="text-lg font-bold text-white mb-1">Smart CRM</h4>
            <p class="text-sm text-gray-300">Track every lead</p>
          </div>

          <div class="p-6 bg-gradient-to-br from-gray-800/50 to-gray-900/50 rounded-xl border border-purple-500/20">
            <Zap class="w-8 h-8 text-yellow-400 mb-3" />
            <h4 class="text-lg font-bold text-white mb-1">Automations</h4>
            <p class="text-sm text-gray-300">Set it & forget it</p>
          </div>

          <div class="p-6 bg-gradient-to-br from-gray-800/50 to-gray-900/50 rounded-xl border border-purple-500/20">
            <TrendingUp class="w-8 h-8 text-green-400 mb-3" />
            <h4 class="text-lg font-bold text-white mb-1">Marketing</h4>
            <p class="text-sm text-gray-300">Email + SMS + Funnels</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Marketing Services -->
  <section class="py-20 md:py-28 bg-gradient-to-b from-white to-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader
        title='<span class="animated-gradient-text">Marketing</span> That Drives Results'
        subtitle="Comprehensive digital marketing services to attract more clients"
      />

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- SEO -->
        <div class="group p-8 bg-white rounded-2xl border border-gray-200 hover:border-primary-600 hover:shadow-xl transition-all duration-300">
          <div class="w-14 h-14 bg-gradient-to-br from-primary-600 to-primary-700 rounded-xl flex items-center justify-center mb-6">
            <Globe class="w-7 h-7 text-white" />
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-3">SEO</h3>
          <p class="text-gray-700 leading-relaxed">
            Rank higher in Google and get found by clients actively searching for your services.
          </p>
        </div>

        <!-- PPC Management -->
        <div class="group p-8 bg-white rounded-2xl border border-gray-200 hover:border-primary-600 hover:shadow-xl transition-all duration-300">
          <div class="w-14 h-14 bg-gradient-to-br from-cyan-600 to-blue-700 rounded-xl flex items-center justify-center mb-6">
            <Zap class="w-7 h-7 text-white" />
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-3">PPC</h3>
          <p class="text-gray-700 leading-relaxed">
            Google and Bing ads that target the right clients at the right time with expert management.
          </p>
        </div>

        <!-- Social Ads -->
        <div class="group p-8 bg-white rounded-2xl border border-gray-200 hover:border-primary-600 hover:shadow-xl transition-all duration-300">
          <div class="w-14 h-14 bg-gradient-to-br from-violet-600 to-purple-700 rounded-xl flex items-center justify-center mb-6">
            <Users class="w-7 h-7 text-white" />
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-3">Social Ads</h3>
          <p class="text-gray-700 leading-relaxed">
            Facebook and Instagram ads that reach your ideal clients where they spend their time.
          </p>
        </div>

        <!-- Branding & Design -->
        <div class="group p-8 bg-white rounded-2xl border border-gray-200 hover:border-primary-600 hover:shadow-xl transition-all duration-300">
          <div class="w-14 h-14 bg-gradient-to-br from-teal-600 to-cyan-600 rounded-xl flex items-center justify-center mb-6">
            <Palette class="w-7 h-7 text-white" />
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-3">Branding</h3>
          <p class="text-gray-700 leading-relaxed">
            Professional logo design and brand identity that makes your practice stand out.
          </p>
        </div>
      </div>

      <!-- CTA -->
      <div class="text-center mt-16">
        <a href="/pricing" class="btn btn-primary btn-lg">
          View Pricing
          <ArrowRight class="w-5 h-5" />
        </a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
