---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PricingSection from "../components/PricingSection.astro";
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import careptSite from '../assets/sites/carept.png';
import dsmmdSite from '../assets/sites/dsmmd.png';
import lovemoreSite from '../assets/sites/lovemore.png';
import life2healthSite from '../assets/sites/life2health.png';
import domlukeSite from '../assets/sites/domluke.png';
import nazarethSite from '../assets/sites/nazareth.png';
import garrettSite from '../assets/sites/garrett.png';
import graceSite from '../assets/sites/grace.png';
import cfcSite from '../assets/sites/cfc.png';
import { Rocket, Smartphone, Zap, Globe, Palette, Code, LineChart, Shield, Bot, ArrowRight, Sparkles, TrendingUp, Users, CheckCircle2, ShieldCheck, XCircle, Syringe, Bone, Dumbbell, HeartPulse, Brain, WalletCards, Flower2, SmilePlus } from '@lucide/astro';

const wrongProblemNeeds = [
  'a website that builds trust instantly',
  'a brand that feels premium',
  'messaging that explains their value clearly',
  'a patient journey that reduces friction',
  'consistent visibility online',
];

const growthBlocks = [
  'embarrassed by their website',
  'inconsistent on social media',
  'dependent on referrals',
  'invisible on Google',
  'too busy to market consistently',
];

const failedEfforts = [
  ['Posting inconsistently on social media', 'without a real strategy behind it'],
  ['Hiring a generic marketing agency', 'that does not understand healthcare psychology'],
  ['Running ads to a weak website', 'which silently kills conversions'],
  ['DIY website builders', 'that make your practice look smaller than it is'],
  ['Asking staff to “help with marketing”', 'while they already have full-time jobs'],
  ['Depending entirely on referrals', 'which creates unpredictable revenue cycles'],
  ['Paying for SEO with no measurable growth', 'because nobody fixed the foundation first'],
  ['Trying to “look professional” online', 'instead of building actual authority and trust'],
  ['Waiting until things slow down to fix marketing', 'when visibility should have been built months earlier'],
  ['Watching less-qualified competitors dominate', 'simply because they present themselves better'],
];

const patientQuestions = [
  'Does this place feel trustworthy?',
  'Does this feel premium?',
  'Do these people know what they are doing?',
  'Do I feel safe here?',
  'Is this worth the investment?',
];

const solutionSignals = [
  'Patient psychology',
  'Trust-based design',
  'Premium positioning',
  'Local visibility',
  'Authority-building',
  'Conversion strategy',
];

const services = [
  'Website Design & Management',
  'SEO',
  'Branding',
  'Social Media',
  'Paid Advertising',
  'Patient Flow Systems',
  'Unlimited Updates',
];

const businessTypes = [
  {
    label: 'Med Spa',
    detail: 'Premium aesthetics, injectables, skin care, and membership-driven patient journeys.',
    icon: Syringe,
  },
  {
    label: 'Chiropractic Clinic',
    detail: 'Local search visibility and trust-building experiences for care plans and recurring visits.',
    icon: Bone,
  },
  {
    label: 'Wellness Studio',
    detail: 'A polished brand presence for classes, packages, communities, and ongoing engagement.',
    icon: Dumbbell,
  },
  {
    label: 'Functional Medicine Practice',
    detail: 'Clear positioning for complex care models, premium offers, and high-intent patients.',
    icon: HeartPulse,
  },
  {
    label: 'Therapy Practice',
    detail: 'Calm, credible design that helps people feel safe before they schedule.',
    icon: Brain,
  },
  {
    label: 'Private-Pay Medical Business',
    detail: 'Conversion-focused messaging for patients making out-of-pocket decisions.',
    icon: WalletCards,
  },
  {
    label: 'Yoga or Holistic Wellness Brand',
    detail: 'Warm, distinctive digital presence for values-led wellness businesses.',
    icon: Flower2,
  },
  {
    label: 'Dental or Specialty Clinic',
    detail: 'Authority-building websites for practices that need to look as advanced as their care.',
    icon: SmilePlus,
  },
];

const plans = [
  {
    name: 'Silver',
    price: '$199/mo',
    pages: '1-5 pages',
    fit: 'Perfect for smaller wellness businesses',
  },
  {
    name: 'Gold',
    price: '$399/mo',
    pages: '5-11 pages',
    fit: 'Best for established practices ready to grow',
    featured: true,
  },
  {
    name: 'Platinum',
    price: '$599/mo',
    pages: '11+ pages',
    fit: 'For scaling and premium positioning',
  },
];
---

<BaseLayout title="Services - Team Riley" description="Professional web design and development services for health and wellness businesses">
  <Navigation />

  <!-- Hero Section -->
  <section class="relative pb-0 pt-20 md:py-28 lg:py-0 overflow-hidden bg-gradient-to-br from-gray-50 via-white to-blue-50 lg:min-h-[760px] flex flex-col lg:block">
    <div class="absolute inset-0 opacity-5">
      <div class="absolute top-16 right-20 w-96 h-96 bg-primary-600 rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 left-16 w-80 h-80 bg-accent-400 rounded-full blur-3xl"></div>
    </div>

    <div class="portfolio-scroll-gallery order-2 relative w-full max-w-full lg:absolute lg:inset-y-0 lg:right-0 lg:w-[44vw] h-[460px] md:h-[560px] lg:h-full overflow-hidden mt-12 lg:mt-0 lg:order-none">
      <div class="pointer-events-none absolute inset-x-0 top-0 h-20 bg-gradient-to-b from-white lg:from-blue-50 to-transparent z-10"></div>
      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-blue-50 to-transparent z-10"></div>
      <div class="grid grid-cols-2 gap-3 sm:gap-4 md:gap-5 px-4 sm:px-6 md:p-3 -mt-10">
        <div class="portfolio-scroll-column portfolio-scroll-column-up space-y-4 md:space-y-5">
          <Image src={careptSite} alt="CarePT website portfolio preview" class="aspect-video w-full rounded-xl object-cover object-top shadow-xl" />
          <Image src={dsmmdSite} alt="DSM MD website portfolio preview" class="aspect-video w-full rounded-xl object-cover object-top shadow-xl" />
          <Image src={nazarethSite} alt="LoveMore website portfolio preview" class="aspect-video w-full rounded-xl object-cover object-top shadow-xl" />
          <Image src={cfcSite} alt="CFC website portfolio preview" class="aspect-video w-full rounded-xl object-cover object-top shadow-xl" />
          <Image src={garrettSite} alt="" class="aspect-video w-full rounded-xl object-cover object-top shadow-xl" aria-hidden="true" />
        </div>
        <div class="portfolio-scroll-column portfolio-scroll-column-down space-y-4 md:space-y-5 pt-16">
          <Image src={life2healthSite} alt="Life2Health website portfolio preview" class="aspect-video w-full rounded-xl object-cover object-top shadow-xl" />
          <Image src={graceSite} alt="Grace Midwifery Collective website portfolio preview" class="aspect-video w-full rounded-xl object-cover object-top shadow-xl" />
          <Image src={domlukeSite} alt="CFC website portfolio preview" class="aspect-video w-full rounded-xl object-cover object-top shadow-xl" />
          <Image src={lovemoreSite} alt="LoveMore website portfolio preview" class="aspect-video w-full rounded-xl object-cover object-top shadow-xl" />
          <Image src={life2healthSite} alt="" class="aspect-video w-full rounded-xl object-cover object-top shadow-xl" aria-hidden="true" />
        </div>
      </div>
    </div>

    <div class="relative order-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="lg:min-h-[760px] lg:py-28 lg:mr-[50%] flex items-center">
        <div>
          <div class="inline-flex items-center px-4 py-2 bg-primary-100 border-l-4 border-primary-700 rounded-r-lg mb-8">
            <span class="text-sm font-semibold text-primary-800 uppercase tracking-wider">Digital Health For Health & Wellness Brands</span>
          </div>

          <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold leading-tight text-gray-900 mb-6">
            Your clinical expertise is <span class="animated-gradient-text">world-class</span>.
          </h1>

          <h2 class="text-2xl md:text-3xl font-bold text-gray-800 leading-snug mb-6">
            Your digital presence should be, too.
          </h2>

          <p class="text-xl text-gray-700 leading-relaxed max-w-3xl mb-6">
            Most health businesses have a digital presence does not match their level of expertise.
          </p>

          <p class="text-lg text-gray-600 leading-relaxed max-w-3xl mb-8">
            Every day, potential patients search online, compare options, and silently choose competitors with better websites, better branding, better Google presence, and better social proof, even when your actual care is far superior.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 mb-6">
            <button
              data-cal-link="joshua-riley/intro-call"
              data-cal-namespace="intro-call"
              data-cal-config='{"layout":"month_view","useSlotsViewOnSmallScreen":"true"}'
              class="btn btn-primary btn-lg w-full max-w-full !whitespace-normal text-center leading-snug sm:w-auto sm:!whitespace-nowrap">
              <span>Book Your Digital Health Checkup</span>
              <ArrowRight class="w-5 h-5 flex-shrink-0" />
            </button>
          </div>

          <div class="flex flex-wrap gap-3 text-sm font-semibold text-gray-700">
            <span class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 shadow-soft"><CheckCircle2 class="w-4 h-4 text-primary-700" /> Websites Starting at $199/mo</span>
            <span class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 shadow-soft"><CheckCircle2 class="w-4 h-4 text-primary-700" /> Unlimited Updates</span>
            <!--<span class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 shadow-soft"><CheckCircle2 class="w-4 h-4 text-primary-700" /> Health & Wellness Specialists</span>-->
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Wrong Problem Section -->
  <section class="aurora-light-section py-20 md:py-28 bg-white relative overflow-hidden">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center mb-12">
        <div class="inline-flex items-center px-4 py-2 bg-primary-100 border-l-4 border-primary-700 rounded-r-lg mb-6">
          <span class="text-sm font-semibold text-primary-800">You Are Solving The Wrong Problem</span>
        </div>
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">Most health businesses think they need more training.</h2>
        <p class="text-2xl font-bold text-gray-800 mb-6">Usually, that is not true.</p>
        <p class="max-w-3xl mx-auto text-xl text-gray-700 leading-relaxed">What they actually need is the digital infrastructure that makes patients trust them faster and take the next step with less friction.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 max-w-5xl mx-auto">
        <div class="rounded-xl border border-gray-200 bg-gray-50 p-8">
          <h3 class="text-xl font-bold text-gray-900 mb-5">They need:</h3>
          <ul class="space-y-3">
            {wrongProblemNeeds.map((item) => (
              <li class="flex gap-3 text-gray-700"><CheckCircle2 class="w-5 h-5 text-primary-700 flex-shrink-0 mt-0.5" /> {item}</li>
            ))}
          </ul>
        </div>
        <div class="rounded-xl border border-gray-200 bg-gray-50 p-8">
          <h3 class="text-xl font-bold text-gray-900 mb-5">Instead, they are:</h3>
          <ul class="space-y-3">
            {growthBlocks.map((item) => (
              <li class="flex gap-3 text-gray-700"><XCircle class="w-5 h-5 text-secondary-600 flex-shrink-0 mt-0.5" /> {item}</li>
            ))}
          </ul>
        </div>
      </div>

      <p class="text-center text-2xl md:text-3xl font-bold text-gray-900 mt-14">
        Growth feels random because the digital infrastructure is weak.
      </p>
    </div>
  </section>

  <!-- Failed Efforts Section -->
  <section class="py-20 md:py-28 bg-gradient-to-b from-gray-900 via-gray-950 to-black relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-primary-600 rounded-full blur-3xl"></div>
      <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-secondary-500 rounded-full blur-3xl"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <div class="inline-flex items-center px-4 py-2 bg-primary-900/50 border-l-4 border-primary-500 rounded-r-lg mb-6">
          <span class="text-sm font-bold text-primary-300 uppercase tracking-wider">Why Everything You Tried Quietly Failed</span>
        </div>
        <h2 class="text-4xl md:text-5xl font-bold text-white">Why most marketing efforts quietly fail</h2>
      </div>

      <div class="grid md:grid-cols-2 gap-5">
        {failedEfforts.map(([title, detail], index) => (
          <div class="rounded-xl border border-white/10 bg-white/5 p-6">
            <div class="flex gap-4">
              <span class="w-9 h-9 rounded-full bg-gradient-to-br from-primary-600 to-secondary-600 text-white font-bold flex items-center justify-center flex-shrink-0">{index + 1}</span>
              <div>
                <h3 class="text-lg font-bold text-white">{title}</h3>
                <p class="text-gray-300 mt-1">{detail}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Reframe Section -->
  <section class="py-20 md:py-28 bg-gradient-to-br from-white via-blue-50 to-gray-100 relative overflow-hidden">
    <div class="absolute inset-0 opacity-40">
      <div class="absolute -top-24 right-12 w-96 h-96 bg-primary-200 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-12 w-80 h-80 bg-accent-300 rounded-full blur-3xl"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-[1.1fr_.9fr] gap-10 lg:gap-16 items-center">
        <div>
          <!--<div class="inline-flex items-center px-4 py-2 bg-primary-100 border-l-4 border-primary-700 rounded-r-lg mb-6">-->
          <!--  <span class="text-sm font-semibold text-primary-800">The First Impression</span>-->
          <!--</div>-->
          <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 leading-tight mb-6">
            Your website is your
            <span class="animated-gradient-text"> first impression.</span>
          </h2>
          <p class="text-2xl font-bold text-gray-800 leading-snug mb-6">
            It is either building trust, creating authority, converting visitors, and attracting ideal patients, or quietly pushing people away.
          </p>
          <p class="text-xl text-gray-700 leading-relaxed">
            Patients make decisions long before they ever contact you. Your digital presence answers their biggest questions before you ever speak to them.
          </p>
        </div>

        <div class="rounded-2xl bg-gray-950 p-4 md:p-6 border border-gray-800 shadow-2xl">
          <div class="grid gap-3">
            {patientQuestions.map((question) => (
              <div class="flex gap-4 rounded-xl bg-white/5 border border-white/10 p-4 text-white text-lg">
                <ShieldCheck class="w-6 h-6 text-accent-300 flex-shrink-0 mt-0.5" />
                <span>{question}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Solution Section -->
  <section class="py-20 md:py-28 bg-gray-950 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-16 right-10 w-80 h-80 bg-primary-600 rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 left-10 w-72 h-72 bg-accent-500 rounded-full blur-3xl"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center mb-12">
        <div class="inline-flex items-center px-4 py-2 bg-primary-900/50 border-l-4 border-primary-500 rounded-r-lg mb-6">
          <span class="text-sm font-bold text-primary-300 uppercase tracking-wider">The Solution</span>
        </div>
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">Team Riley becomes your digital health partner.</h2>
        <p class="text-xl text-gray-300 leading-relaxed mb-8">We work exclusively with health, wellness, and medical brands, so you can focus on patient care instead of trying to become a marketer.</p>
        <button
          data-cal-link="joshua-riley/intro-call"
          data-cal-namespace="intro-call"
          data-cal-config='{"layout":"month_view","useSlotsViewOnSmallScreen":"true"}'
          class="btn btn-primary btn-lg">
          Schedule Your Digital Health Checkup
          <ArrowRight class="w-5 h-5" />
        </button>
      </div>

      <div class="grid md:grid-cols-2 gap-6 max-w-3xl mx-auto">
        <div class="rounded-xl border border-white/10 bg-white/5 p-8">
          <h3 class="text-xl font-bold text-white mb-5">We understand:</h3>
          <ul class="space-y-3">
            {solutionSignals.map((item) => (
              <li class="flex gap-3 text-gray-300"><CheckCircle2 class="w-5 h-5 text-accent-300 flex-shrink-0 mt-0.5" /> {item}</li>
            ))}
          </ul>
        </div>
        <div class="rounded-xl border border-white/10 bg-white/5 p-8">
          <h3 class="text-xl font-bold text-white mb-5">We handle:</h3>
          <ul class="space-y-3">
            {services.map((item) => (
              <li class="flex gap-3 text-gray-300"><CheckCircle2 class="w-5 h-5 text-primary-300 flex-shrink-0 mt-0.5" /> {item}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Audience Section -->
  <section class="py-20 md:py-28 bg-gradient-to-b from-white to-gray-100 relative overflow-hidden">
    <div class="absolute inset-0 opacity-50">
      <div class="absolute top-12 right-12 w-80 h-80 bg-primary-200 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-16 w-72 h-72 bg-accent-300 rounded-full blur-3xl"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center mb-14">
        <div class="inline-flex items-center px-4 py-2 bg-primary-100 border-l-4 border-primary-700 rounded-r-lg mb-6">
          <span class="text-sm font-semibold text-primary-800">This Is For You If</span>
        </div>
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-5">
          We know <span class="animated-gradient-text">Health & Wellness</span>
        </h2>
        <p class="text-xl text-gray-700 leading-relaxed">
          This is built for practices and wellness brands that know their digital presence no longer reflects the level of care they provide.
        </p>
      </div>

      <div class="max-w-6xl mx-auto overflow-hidden rounded-3xl border border-gray-200 bg-white/90 shadow-xl backdrop-blur-sm">
        <!--<div class="h-1.5 animated-gradient-bg"></div>-->
        <div class="grid md:grid-cols-2 md:divide-x divide-gray-200">
          <div class="divide-y divide-gray-200">
            {businessTypes.slice(0, 4).map((type) => {
              const Icon = type.icon;
              return (
              <div class="group relative p-6 md:p-7 transition-colors duration-300 hover:bg-primary-50/80">
                <div class="flex gap-4">
                  <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-primary-600 via-accent-500 to-secondary-500 flex items-center justify-center shadow-medium flex-shrink-0">
                    <Icon class="w-5 h-5 text-white" />
                  </div>
                  <div>
                    <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-primary-800 transition-colors">{type.label}</h3>
                    <p class="text-sm md:text-base text-gray-600 leading-relaxed">{type.detail}</p>
                  </div>
                </div>
              </div>
            )})}
          </div>
          <div class="divide-y divide-gray-200 border-t border-gray-200 md:border-t-0">
            {businessTypes.slice(4).map((type) => {
              const Icon = type.icon;
              return (
              <div class="group relative p-6 md:p-7 transition-colors duration-300 hover:bg-primary-50/80">
                <div class="flex gap-4">
                  <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-primary-600 via-accent-500 to-secondary-500 flex items-center justify-center shadow-medium flex-shrink-0">
                    <Icon class="w-5 h-5 text-white" />
                  </div>
                  <div>
                    <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-primary-800 transition-colors">{type.label}</h3>
                    <p class="text-sm md:text-base text-gray-600 leading-relaxed">{type.detail}</p>
                  </div>
                </div>
              </div>
            )})}
          </div>
        </div>
      </div>

      <p class="text-center text-2xl md:text-3xl font-bold text-gray-900 mt-14 max-w-5xl mx-auto">
        Your care is world-class, your online presence should be too.
      </p>
    </div>
  </section>

  <!-- Objection Handling Section -->
  <section class="py-20 md:py-28 bg-gray-950">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">This is not about “doing more.”</h2>
      <p class="max-w-3xl mx-auto text-xl text-gray-300 leading-relaxed mb-10">It is about finally building a digital presence that matches your expertise, builds trust automatically, positions you correctly, attracts better-fit patients, and works consistently over time.</p>
      <div class="relative inline-flex max-w-5xl items-center gap-2 rounded-3xl bg-white p-2 text-left shadow-2xl">
        <div class="absolute -inset-1 rounded-[1.75rem] bg-gradient-to-r from-primary-600 via-accent-400 to-secondary-500 opacity-75 blur-lg"></div>
        <div class="relative flex flex-col sm:flex-row items-start sm:items-center gap-5 rounded-[1.35rem] bg-gradient-to-br from-white via-blue-50 to-violet-50 p-6 md:p-8 border border-white">
          <div class="flex items-center justify-center flex-shrink-0">
            <TrendingUp class="w-10 h-10 text-slate-950" />
          </div>
          <div>
            <p class="text-2xl font-bold text-gray-900 text-center leading-tight">
              One new patient per month often covers the entire investment.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final Close Section -->
  <section class="py-20 md:py-28 bg-gradient-to-br from-gray-50 via-white to-blue-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-5xl md:text-6xl font-bold text-gray-900 mb-8">You did the hard part.</h2>
      <div class="text-2xl md:text-3xl font-bold text-gray-800 space-y-2 mb-8">
        <p>You built the skills.</p>
        <p>The patient outcomes.</p>
        <p>The years of experience.</p>
      </div>
      <p class="text-2xl text-gray-700 mb-10">Now your online presence needs to catch up.</p>
      <button
        data-cal-link="joshua-riley/intro-call"
        data-cal-namespace="intro-call"
        data-cal-config='{"layout":"month_view","useSlotsViewOnSmallScreen":"true"}'
        class="btn btn-primary btn-lg mb-5">
        Book Your Digital Health Checkup
        <ArrowRight class="w-5 h-5" />
      </button>
      <!--<p class="text-gray-600 max-w-2xl mx-auto">-->
      <!--  No pressure. No generic sales pitch. Just a strategic conversation about where your digital presence is helping and where it is quietly costing you patients.-->
      <!--</p>-->
    </div>
  </section>

  <PageHeader
    badge="What We Offer"
    title='<span class="text-gray-900">We Got</span> <span class="animated-gradient-text">You Covered</span>'
    subtitle="From custom design to ongoing support, we provide everything you need to grow your online presence and attract more clients."
  />

  <!-- Services Grid -->
  <section class="pb-20 md:pb-28 bg-white relative overflow-hidden">
