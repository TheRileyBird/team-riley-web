---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeader from '../components/SectionHeader.astro';
import PricingSection from "../components/PricingSection.astro";
import AngledShowcase from '../components/AngledShowcase.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import type { ServicesCardIcon } from '../data/services';
import { content, services as pricedServices, site } from '../verticals/active';
import { hasPage } from '../verticals/index';
// /portfolio is health-only for now, so the CTA that points at it becomes the
// booking action on the markets that do not publish one.
const showPortfolio = hasPage(site, '/portfolio');
import { Rocket, Smartphone, Zap, Globe, Palette, Code, LineChart, Shield, Bot, ArrowRight, Sparkles, TrendingUp, Users, CheckCircle2, ShieldCheck, XCircle, Syringe, Bone, Dumbbell, HeartPulse, Brain, WalletCards, Flower2, SmilePlus, Gavel, Scroll, Briefcase, Plane, Building2, Scale, Gem, PiggyBank, Calculator, UserRound } from '@lucide/astro';

// The marketing grid reads src/data/services.ts, so a renamed, repriced or retired
// service can't drift out of step with /pricing. Each card links to its section there.
const pageContent = content.services;
const { showcase } = content.home;
// Two staggered screenshot columns; hidden when a market has too little work to
// fill them without repeating (same rule as the homepage gallery).
const showShowcase = showcase.length >= 6;
const showcaseColumns = showShowcase
  ? [showcase.filter((_, index) => index % 2 === 0), showcase.filter((_, index) => index % 2 === 1)]
  : [];
// Lucide components for the segment icons named in the market's content file.
const segmentIcons: Record<string, typeof Users> = {
  syringe: Syringe, bone: Bone, dumbbell: Dumbbell, 'heart-pulse': HeartPulse, brain: Brain,
  'wallet-cards': WalletCards, flower: Flower2, 'smile-plus': SmilePlus, gavel: Gavel, users: Users,
  scroll: Scroll, shield: Shield, briefcase: Briefcase, plane: Plane, building: Building2, scale: Scale,
  'line-chart': LineChart, gem: Gem, 'piggy-bank': PiggyBank, calculator: Calculator, 'user-round': UserRound
};
const cardIcons: Record<ServicesCardIcon, typeof Users> = { users: Users, zap: Zap, globe: Globe, palette: Palette };
const marketingCards = pricedServices.filter((service) => service.status !== 'archived' && service.servicesCard);

const wrongProblemNeeds = [
  'a website that builds trust instantly',
  'a brand that feels premium',
  'messaging that explains their value clearly',
  'a client journey that reduces friction',
  'consistent visibility online',
];

const growthBlocks = [
  'embarrassed by their website',
  'inconsistent on social media',
  'dependent on referrals',
  'invisible on Google',
  'too busy to market consistently',
];

const failedEfforts = pageContent.failedEfforts;

const clientQuestions = [
  'Does this place feel trustworthy?',
  'Does this feel premium?',
  'Do these people know what they are doing?',
  'Do I feel safe here?',
  'Is this worth the investment?',
];

const solutionSignals = [
  'Client psychology',
  'Trust-based design',
  'Premium positioning',
  'Local visibility',
  'Authority-building',
  'Conversion strategy',
];

const services = [
  'Website Design & Management',
  'SEO',
  'Branding',
  'Social Media',
  'Paid Advertising',
  'Client Growth Systems',
  'Unlimited Updates',
];

/*
 * The tiles used to render `segment.icon` — a Lucide *name* — straight into
 * <Icon />, so the browser got an unknown <syringe> element and every tile showed
 * an empty gradient square. The map above already existed; the tiles just never
 * went through it. Throwing on an unknown name keeps the next typo a build
 * failure rather than eight blank squares.
 */
const businessTypes = pageContent.segments.map((segment) => {
  const Icon = segmentIcons[segment.icon];
  if (!Icon) throw new Error(`Unknown segment icon "${segment.icon}" for "${segment.label}".`);
  return { ...segment, Icon };
});

---

<BaseLayout title={pageContent.title} description={pageContent.description}>
  <Navigation />

  <!-- Hero Section -->
  <section class="relative pb-0 pt-20 md:py-28 lg:py-0 overflow-hidden bg-gradient-to-br from-ink-900 via-ink-950 to-black lg:min-h-[760px] flex flex-col lg:block">
    <div class="absolute inset-0 opacity-20">
      <div class="absolute top-16 right-20 w-96 h-96 bg-primary-600 rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 left-16 w-80 h-80 bg-accent-400 rounded-full blur-3xl"></div>
    </div>

    <!-- The services gallery drifts on its own tilt; the homepage's slides on scroll.
         Two pages, two treatments, same screenshots. -->
    <div class="order-2 relative w-full max-w-full lg:absolute lg:inset-y-0 lg:right-0 lg:w-[44vw] h-[460px] md:h-[560px] lg:h-full overflow-hidden mt-12 lg:mt-0 lg:order-none">
      <div class="pointer-events-none absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-ink-950 to-transparent z-10"></div>
      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-black to-transparent z-10"></div>
      <div class="pointer-events-none absolute inset-y-0 left-0 w-24 bg-gradient-to-r from-ink-950 to-transparent z-10 hidden lg:block"></div>
      {showShowcase && <AngledShowcase images={showcase} />}
    </div>

    <div class="relative order-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="lg:min-h-[760px] lg:py-28 lg:mr-[50%] flex items-center">
        <div>
          <div class="inline-flex items-center px-4 py-2 bg-primary-900/50 border-l-4 border-primary-500 rounded-r-lg mb-8">
            <span class="text-sm font-semibold text-primary-300 uppercase tracking-wider">{pageContent.hero.eyebrow}</span>
          </div>

          <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold leading-tight text-white mb-6">
            {pageContent.hero.heading.lead}<span class="animated-gradient-text-bright">{pageContent.hero.heading.highlight}</span>{pageContent.hero.heading.trail}
          </h1>

          <h2 class="text-2xl md:text-3xl font-bold text-gray-100 leading-snug mb-6">
            {pageContent.hero.subheading}
          </h2>

          <p class="text-xl text-gray-300 leading-relaxed max-w-3xl mb-6">
            {pageContent.hero.problem}
          </p>

          <p class="text-lg text-gray-400 leading-relaxed max-w-3xl mb-8">
            {pageContent.hero.comparison}
          </p>

          <div class="flex flex-col sm:flex-row gap-4 mb-6">
            <a href="/#book-a-call"
              data-booking-modal-open
              class="btn btn-primary btn-lg w-full max-w-full !whitespace-normal text-center leading-snug sm:w-auto sm:!whitespace-nowrap">
              <span>{pageContent.consultCta}</span>
              <ArrowRight class="w-5 h-5 flex-shrink-0" />
            </a>
          </div>

          <div class="flex flex-wrap gap-3 text-sm font-semibold text-gray-100">
            <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-4 py-2 backdrop-blur-sm"><CheckCircle2 class="w-4 h-4 text-primary-300" /> Websites Starting at $249/mo</span>
            <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-4 py-2 backdrop-blur-sm"><CheckCircle2 class="w-4 h-4 text-primary-300" /> Unlimited Updates</span>
              </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Wrong Problem Section -->
  <section class="aurora-light-section py-20 md:py-28 bg-white relative overflow-hidden">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center mb-12">
        <div class="inline-flex items-center px-4 py-2 bg-primary-100 border-l-4 border-primary-700 rounded-r-lg mb-6">
          <span class="text-sm font-semibold text-primary-800">You Are Solving The Wrong Problem</span>
        </div>
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">{pageContent.wrongProblem.heading}</h2>
        <p class="text-2xl font-bold text-gray-800 mb-6">{pageContent.wrongProblem.rebuttal}</p>
        <p class="max-w-3xl mx-auto text-xl text-gray-700 leading-relaxed">{pageContent.wrongProblem.reality}</p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 max-w-5xl mx-auto">
        <div class="rounded-xl border border-gray-200 bg-gray-50 p-8">
          <h3 class="text-xl font-bold text-gray-900 mb-5">They need:</h3>
          <ul class="space-y-3">
            {wrongProblemNeeds.map((item) => (
              <li class="flex gap-3 text-gray-700"><CheckCircle2 class="w-5 h-5 text-primary-700 flex-shrink-0 mt-0.5" /> {item}</li>
            ))}
          </ul>
        </div>
        <div class="rounded-xl border border-gray-200 bg-gray-50 p-8">
          <h3 class="text-xl font-bold text-gray-900 mb-5">Instead, they are:</h3>
          <ul class="space-y-3">
            {growthBlocks.map((item) => (
              <li class="flex gap-3 text-gray-700"><XCircle data-loss class="w-5 h-5 text-secondary-600 flex-shrink-0 mt-0.5" /> {item}</li>
            ))}
          </ul>
        </div>
      </div>

      <p class="text-center text-2xl md:text-3xl font-bold text-gray-900 mt-14">
        Growth feels random because the digital infrastructure is weak.
      </p>
    </div>
  </section>

  <!-- Failed Efforts Section -->
  <section class="py-20 md:py-28 bg-gradient-to-b from-ink-900 via-ink-950 to-black relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-primary-600 rounded-full blur-3xl"></div>
      <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-secondary-500 rounded-full blur-3xl"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <div class="inline-flex items-center px-4 py-2 bg-primary-900/50 border-l-4 border-primary-500 rounded-r-lg mb-6">
          <span class="text-sm font-bold text-primary-300 uppercase tracking-wider">Why Everything You Tried Quietly Failed</span>
        </div>
        <h2 class="text-4xl md:text-5xl font-bold text-white">Why most marketing efforts quietly fail</h2>
      </div>

      <div class="grid md:grid-cols-2 gap-5">
        {failedEfforts.map(([title, detail], index) => (
          <div class="rounded-xl border border-white/10 bg-white/5 p-6">
            <div class="flex gap-4">
              <span class="w-9 h-9 rounded-full bg-gradient-to-br from-primary-600 to-secondary-600 text-white font-bold flex items-center justify-center flex-shrink-0">{index + 1}</span>
              <div>
                <h3 class="text-lg font-bold text-white">{title}</h3>
                <p class="text-gray-300 mt-1">{detail}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Reframe Section -->
  <section class="py-20 md:py-28 bg-gradient-to-br from-white via-primary-50 to-gray-100 relative overflow-hidden">
    <div class="absolute inset-0 opacity-40">
      <div class="absolute -top-24 right-12 w-96 h-96 bg-primary-200 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-12 w-80 h-80 bg-accent-300 rounded-full blur-3xl"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-[1.1fr_.9fr] gap-10 lg:gap-16 items-center">
        <div>
          <!--<div class="inline-flex items-center px-4 py-2 bg-primary-100 border-l-4 border-primary-700 rounded-r-lg mb-6">-->
          <!--  <span class="text-sm font-semibold text-primary-800">The First Impression</span>-->
          <!--</div>-->
          <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 leading-tight mb-6">
            Your website is your
            <span class="animated-gradient-text"> first impression.</span>
          </h2>
          <p class="text-2xl font-bold text-gray-800 leading-snug mb-6">
            It is either building trust, creating authority, converting visitors, and attracting ideal clients, or quietly pushing people away.
          </p>
          <p class="text-xl text-gray-700 leading-relaxed">
            Clients make decisions long before they ever contact you. Your digital presence answers their biggest questions before you ever speak to them.
          </p>
        </div>

        <div class="rounded-2xl bg-ink-950 p-4 md:p-6 border border-gray-800 shadow-2xl">
          <div class="grid gap-3">
            {clientQuestions.map((question) => (
              <div class="flex gap-4 rounded-xl bg-white/5 border border-white/10 p-4 text-white text-lg">
                <ShieldCheck class="w-6 h-6 text-accent-300 flex-shrink-0 mt-0.5" />
                <span>{question}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Solution Section -->
  <section class="py-20 md:py-28 bg-ink-950 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-16 right-10 w-80 h-80 bg-primary-600 rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 left-10 w-72 h-72 bg-accent-500 rounded-full blur-3xl"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center mb-12">
        <div class="inline-flex items-center px-4 py-2 bg-primary-900/50 border-l-4 border-primary-500 rounded-r-lg mb-6">
          <span class="text-sm font-bold text-primary-300 uppercase tracking-wider">The Solution</span>
        </div>
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">{pageContent.partner.heading}</h2>
        <p class="text-xl text-gray-300 leading-relaxed mb-8">{pageContent.partner.body}</p>
        <a href="/#book-a-call"
          data-booking-modal-open
          class="btn btn-primary btn-lg">
          {pageContent.consultCtaLong}
          <ArrowRight class="w-5 h-5" />
        </a>
      </div>

      <div class="grid md:grid-cols-2 gap-6 max-w-3xl mx-auto">
        <div class="rounded-xl border border-white/10 bg-white/5 p-8">
          <h3 class="text-xl font-bold text-white mb-5">We understand:</h3>
          <ul class="space-y-3">
            {solutionSignals.map((item) => (
              <li class="flex gap-3 text-gray-300"><CheckCircle2 class="w-5 h-5 text-accent-300 flex-shrink-0 mt-0.5" /> {item}</li>
            ))}
          </ul>
        </div>
        <div class="rounded-xl border border-white/10 bg-white/5 p-8">
          <h3 class="text-xl font-bold text-white mb-5">We handle:</h3>
          <ul class="space-y-3">
            {services.map((item) => (
              <li class="flex gap-3 text-gray-300"><CheckCircle2 class="w-5 h-5 text-primary-300 flex-shrink-0 mt-0.5" /> {item}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Audience Section -->
  <section class="py-20 md:py-28 bg-gradient-to-b from-white to-gray-100 relative overflow-hidden">
    <div class="absolute inset-0 opacity-50">
      <div class="absolute top-12 right-12 w-80 h-80 bg-primary-200 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 left-16 w-72 h-72 bg-accent-300 rounded-full blur-3xl"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center mb-14">
        <div class="inline-flex items-center px-4 py-2 bg-primary-100 border-l-4 border-primary-700 rounded-r-lg mb-6">
          <span class="text-sm font-semibold text-primary-800">This Is For You If</span>
        </div>
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-5">
          {pageContent.forYou.heading.lead}<span class="animated-gradient-text">{pageContent.forYou.heading.highlight}</span>
        </h2>
        <p class="text-xl text-gray-700 leading-relaxed">
          {pageContent.forYou.body}
        </p>
      </div>

      <div class="max-w-6xl mx-auto overflow-hidden rounded-3xl border border-gray-200 bg-white/90 shadow-xl backdrop-blur-sm">
        <!--<div class="h-1.5 animated-gradient-bg"></div>-->
        <div class="grid md:grid-cols-2 md:divide-x divide-gray-200">
          <div class="divide-y divide-gray-200">
            {businessTypes.slice(0, 4).map((type) => {
              const Icon = type.Icon;
              return (
              <div class="group relative p-6 md:p-7 transition-colors duration-300 hover:bg-primary-50/80">
                <div class="flex gap-4">
                  <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-primary-600 via-accent-500 to-secondary-500 flex items-center justify-center shadow-medium flex-shrink-0">
                    <Icon class="w-5 h-5 text-white" />
                  </div>
                  <div>
                    <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-primary-800 transition-colors">{type.label}</h3>
                    <p class="text-sm md:text-base text-gray-600 leading-relaxed">{type.detail}</p>
                  </div>
                </div>
              </div>
            )})}
          </div>
          <div class="divide-y divide-gray-200 border-t border-gray-200 md:border-t-0">
            {businessTypes.slice(4).map((type) => {
              const Icon = type.Icon;
              return (
              <div class="group relative p-6 md:p-7 transition-colors duration-300 hover:bg-primary-50/80">
                <div class="flex gap-4">
                  <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-primary-600 via-accent-500 to-secondary-500 flex items-center justify-center shadow-medium flex-shrink-0">
                    <Icon class="w-5 h-5 text-white" />
                  </div>
                  <div>
                    <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-primary-800 transition-colors">{type.label}</h3>
                    <p class="text-sm md:text-base text-gray-600 leading-relaxed">{type.detail}</p>
                  </div>
                </div>
              </div>
            )})}
          </div>
        </div>
      </div>

      <p class="text-center text-2xl md:text-3xl font-bold text-gray-900 mt-14 max-w-5xl mx-auto">
        Your care is world-class, your online presence should be too.
      </p>
    </div>
  </section>

  <!-- Objection Handling Section -->
  <section class="py-20 md:py-28 bg-ink-950">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">This is not about “doing more.”</h2>
      <p class="max-w-3xl mx-auto text-xl text-gray-300 leading-relaxed mb-10">It is about finally building a digital presence that matches your expertise, builds trust automatically, positions you correctly, attracts better-fit clients, and works consistently over time.</p>
      <div class="relative inline-flex max-w-5xl items-center gap-2 rounded-3xl bg-white p-2 text-left shadow-2xl">
        <div class="absolute -inset-1 rounded-[1.75rem] bg-gradient-to-r from-primary-600 via-accent-400 to-secondary-500 opacity-75 blur-lg"></div>
        <div class="relative flex flex-col sm:flex-row items-start sm:items-center gap-5 rounded-[1.35rem] bg-gradient-to-br from-white via-primary-50 to-secondary-300 p-6 md:p-8 border border-white">
          <div class="flex items-center justify-center flex-shrink-0">
            <TrendingUp class="w-10 h-10 text-slate-950" />
          </div>
          <div>
            <p class="text-2xl font-bold text-gray-900 text-center leading-tight">
              One new client per month often covers the entire investment.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final Close Section -->
  <section class="py-20 md:py-28 bg-gradient-to-br from-gray-50 via-white to-primary-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-5xl md:text-6xl font-bold text-gray-900 mb-8">You did the hard part.</h2>
      <div class="text-2xl md:text-3xl font-bold text-gray-800 space-y-2 mb-8">
        <p>You built the skills.</p>
        <p>The client outcomes.</p>
        <p>The years of experience.</p>
      </div>
      <p class="text-2xl text-gray-700 mb-10">Now your online presence needs to catch up.</p>
      <a href="/#book-a-call"
        data-booking-modal-open
        class="btn btn-primary btn-lg mb-5">
        {pageContent.consultCta}
        <ArrowRight class="w-5 h-5" />
      </a>
      <!--<p class="text-gray-600 max-w-2xl mx-auto">-->
      <!--  No pressure. No generic sales pitch. Just a strategic conversation about where your digital presence is helping and where it is quietly costing you clients.-->
      <!--</p>-->
    </div>
  </section>

  <PageHeader
    badge="What We Offer"
    title='<span class="text-gray-900">We Got</span> <span class="animated-gradient-text">You Covered</span>'
    subtitle="From custom design to ongoing support, we provide everything you need to grow your online presence and attract more clients."
  />

  <!-- Services Grid -->
  <section class="pb-20 md:pb-28 bg-white relative overflow-hidden">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Service 1 -->
        <div class="group p-8 bg-gradient-to-br from-white to-gray-50 rounded-2xl border border-gray-200 hover:border-primary-400 hover:shadow-large hover:-translate-y-1.5 transition-all duration-300">
          <div class="w-14 h-14 bg-gradient-to-br from-primary-600 to-primary-700 rounded-xl flex items-center justify-center mb-6">
            <Rocket class="w-7 h-7 text-white" />
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-3">Custom Web Design</h3>
          <p class="text-gray-700 leading-relaxed mb-4">
            Unique, brand-aligned designs that set you apart from competitors and resonate with your target audience.
          </p>
          <ul class="space-y-2 text-sm text-gray-600">
            <li class="flex items-start gap-2">
              <span class="text-primary-600 mt-0.5">✓</span>
              <span>Mobile-first responsive design</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-primary-600 mt-0.5">✓</span>
              <span>Brand identity integration</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-primary-600 mt-0.5">✓</span>
              <span>User experience optimization</span>
            </li>
          </ul>
        </div>

        <!-- Service 2 -->
        <div class="group p-8 bg-gradient-to-br from-white to-gray-50 rounded-2xl border border-gray-200 hover:border-primary-400 hover:shadow-large hover:-translate-y-1.5 transition-all duration-300">
          <div class="w-14 h-14 bg-gradient-to-br from-accent-500 to-primary-700 rounded-xl flex items-center justify-center mb-6">
            <Code class="w-7 h-7 text-white" />
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-3">Development</h3>
          <p class="text-gray-700 leading-relaxed mb-4">
            Clean, modern code built on the latest web technologies for fast, secure, and scalable websites.
          </p>
          <ul class="space-y-2 text-sm text-gray-600">
            <li class="flex items-start gap-2">
              <span class="text-primary-600 mt-0.5">✓</span>
              <span>Lightning-fast performance</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-primary-600 mt-0.5">✓</span>
              <span>SEO-optimized structure</span>
            </li>
            <li class="flex items-start gap-2">
