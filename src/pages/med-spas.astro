  <script>
    const gallery = document.querySelector('.portfolio-scroll-gallery');
    const upColumn = document.querySelector('.portfolio-scroll-column-up');
    const downColumn = document.querySelector('.portfolio-scroll-column-down');

    let scrollPosition = 0;
    let animationFrame: number;

    const animateGallery = () => {
      if (!gallery || !upColumn || !downColumn) return;

      scrollPosition += 0.12;

      const upHeight = upColumn.scrollHeight / 2;
      const downHeight = downColumn.scrollHeight / 2;

      if (scrollPosition >= Math.min(upHeight, downHeight)) {
        scrollPosition = 0;
      }

      (upColumn as HTMLElement).style.transform = `translateY(-${scrollPosition}px)`;
      (downColumn as HTMLElement).style.transform = `translateY(-${downHeight - scrollPosition}px)`;

      animationFrame = requestAnimationFrame(animateGallery);
    };

    if (upColumn && downColumn) {
      const upClone = upColumn.cloneNode(true);
      const downClone = downColumn.cloneNode(true);

      upColumn.append(...Array.from(upClone.childNodes));
      downColumn.append(...Array.from(downClone.childNodes));

      requestAnimationFrame(() => {
        if (downColumn) {
          const downHeight = downColumn.scrollHeight / 2;
          (downColumn as HTMLElement).style.transform = `translateY(-${downHeight}px)`;
        }
        animateGallery();
      });
    }

    document.addEventListener('astro:before-swap', () => {
      if (animationFrame) {
        cancelAnimationFrame(animationFrame);
      }
    });
  </script>
