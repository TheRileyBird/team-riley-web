<script>
  const gallery = document.querySelector('.portfolio-scroll-gallery');
  const upColumn = document.querySelector('.portfolio-scroll-column-up');
  const downColumn = document.querySelector('.portfolio-scroll-column-down');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  function updatePortfolioScroll() {
    if (!gallery || !upColumn || !downColumn || reduceMotion.matches) return;

    const rect = gallery.getBoundingClientRect();
    const viewportHeight = window.innerHeight || document.documentElement.clientHeight;
    const progress = Math.min(Math.max((viewportHeight - rect.top) / (viewportHeight + rect.height), 0), 1);
    const travel = 280;
    const offset = (progress - 0.5) * travel;

    upColumn.style.transform = `translateY(${-offset}px)`;
    downColumn.style.transform = `translateY(${offset}px)`;
  }

  updatePortfolioScroll();
  window.addEventListener('scroll', updatePortfolioScroll, { passive: true });
  window.addEventListener('resize', updatePortfolioScroll);
</script>
