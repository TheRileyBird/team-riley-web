---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import PricingSection from '../components/PricingSection.astro';
import { ArrowRight, Zap, Smartphone, Palette, Globe, Shield, Rocket, Clock, DollarSign, Users, TrendingUp } from 'lucide-astro';
---

<BaseLayout title="Team Riley Web - Digital Health For Your Business">
  <Navigation />

  <!-- Hero Section -->
  <section class="relative pt-24 pb-20 md:pt-32 md:pb-28 overflow-hidden bg-gradient-to-br from-gray-50 via-white to-blue-50">
    <!-- Background decoration -->
    <div class="absolute inset-0 opacity-5">
      <div class="absolute top-20 right-20 w-96 h-96 bg-primary-600 rounded-full blur-3xl"></div>
      <div class="absolute bottom-20 right-40 w-64 h-64 bg-accent-400 rounded-full blur-3xl"></div>
      <div class="absolute top-1/2 left-20 w-80 h-80 bg-primary-700 rounded-full blur-3xl"></div>
    </div>

    <!-- EKG Monitor Pattern (hidden on mobile/tablet) -->
    <div class="absolute inset-0 pointer-events-none hidden lg:block">
      <svg class="absolute w-full h-full opacity-20" preserveAspectRatio="none" viewBox="0 0 1200 800">
        <defs>
          <!-- Gradient for EKG line color -->
          <linearGradient id="ekg-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" style="stop-color:#1e40af;stop-opacity:1" />
            <stop offset="50%" style="stop-color:#0891b2;stop-opacity:1" />
            <stop offset="100%" style="stop-color:#8b5cf6;stop-opacity:1" />
          </linearGradient>

          <!-- Mask for fade effect -->
          <mask id="ekg-mask">
            <rect class="ekg-fade-mask" x="0" y="0" width="1200" height="800" fill="white"/>
          </mask>
        </defs>

        <g mask="url(#ekg-mask)">
          <!-- Single centered EKG Line with spikes in middle -->
          <path class="ekg-line" d="M0,400 L450,400 L470,380 L490,420 L510,340 L530,400 L550,400 L1200,400"
                stroke="url(#ekg-gradient)" stroke-width="4" fill="none" stroke-linecap="round" stroke-linejoin="round"/>

          <!-- Center grid line (subtle) -->
          <line x1="0" y1="400" x2="1200" y2="400" stroke="currentColor" class="text-primary-300" stroke-width="0.5" stroke-dasharray="10,10" opacity="0.3"/>
        </g>
      </svg>

    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <!-- Left column - Copy -->
        <div class="space-y-8">
          <div class="inline-flex items-center px-4 py-2 bg-primary-100 border-l-4 border-primary-700 rounded-r-lg">
            <span class="text-sm font-semibold text-primary-800">Digital Growth Partner</span>
          </div>

          <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold leading-tight">
            <span class="animated-gradient-text">Digital Health</span>
            <span class="text-gray-900"> For Your Business</span>
          </h1>

          <p class="text-xl text-gray-700 leading-relaxed max-w-xl">
            We help health and wellness brands grow their online presence with beautiful, mobile-first websites that convert visitors into clients.
          </p>

          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/portfolio" class="btn btn-primary btn-lg">
              View Our Work
              <ArrowRight class="w-5 h-5" />
            </a>
            <a href="#pricing" class="btn btn-secondary btn-lg">
              View Pricing
            </a>
          </div>

          <!-- Trust indicators -->
          <div class="flex items-center gap-6 pt-4">
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="12" r="10" fill="url(#checkGradient1)" />
                <path d="M8 12.5L10.5 15L16 9.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <defs>
                  <linearGradient id="checkGradient1" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" style="stop-color:#1e40af;stop-opacity:1" />
                    <stop offset="100%" style="stop-color:#8b5cf6;stop-opacity:1" />
                  </linearGradient>
                </defs>
              </svg>
              <span class="text-sm font-medium text-gray-700">Unlimited Updates</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="12" r="10" fill="url(#checkGradient2)" />
                <path d="M8 12.5L10.5 15L16 9.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <defs>
                  <linearGradient id="checkGradient2" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" style="stop-color:#1e40af;stop-opacity:1" />
                    <stop offset="100%" style="stop-color:#8b5cf6;stop-opacity:1" />
                  </linearGradient>
                </defs>
              </svg>
              <span class="text-sm font-medium text-gray-700">Launch in 2 Weeks</span>
            </div>
          </div>
        </div>

        <!-- Right column - Image -->
        <div class="relative lg:block">
          <div class="relative">
            <!-- Decorative elements -->
            <div class="absolute -top-4 -left-4 w-24 h-24 bg-gradient-to-br from-primary-600 to-primary-700 rounded-2xl opacity-20 animate-pulse"></div>
            <div class="absolute -bottom-6 -right-6 w-32 h-32 bg-gradient-to-br from-accent-400 to-accent-500 rounded-full opacity-20"></div>

            <!-- Image placeholder with gradient overlay -->
            <div class="relative rounded-2xl overflow-hidden shadow-2xl bg-gradient-to-br from-blue-300 via-violet-400 to-purple-300">
              <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=800&q=80"
                   alt="Professional team collaborating with technology"
                   class="w-full h-auto mix-blend-overlay opacity-90"
                   loading="eager" />
              <div class="absolute inset-0 bg-gradient-to-tr from-blue-700/40 via-violet-600/30 to-purple-600/20"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Unlimited Updates Feature Section -->
  <section class="py-20 md:py-32 bg-gradient-to-b from-gray-900 via-gray-950 to-black relative overflow-hidden">
    <!-- Background decoration -->
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-primary-600 rounded-full blur-3xl"></div>
      <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-secondary-500 rounded-full blur-3xl"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <!-- Left: Big Statement -->
        <div>
          <div class="inline-flex items-center px-4 py-2 bg-primary-900/50 border-l-4 border-primary-500 rounded-r-lg mb-6">
            <span class="text-sm font-bold text-primary-300 uppercase tracking-wider">Never Pay Per Change</span>
          </div>

          <h2 class="text-5xl md:text-6xl lg:text-7xl font-bold mb-6 leading-tight">
            <span class="animated-gradient-text">Unlimited</span>
            <br/>
            <span class="text-white">Updates</span>
            <br/>
            <span class="text-white">Forever</span>
          </h2>

          <p class="text-xl text-gray-300 leading-relaxed mb-8">
            Your website should grow with your business. Make changes anytime, as many times as you want—no hourly rates, no surprise bills, no limits.
          </p>

          <div class="space-y-4">
            <div class="flex items-start gap-4">
              <svg class="flex-shrink-0 w-8 h-8 mt-1" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="12" r="10" fill="url(#unlimitedGradient1)" />
                <path d="M8 12.5L10.5 15L16 9.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <defs>
                  <linearGradient id="unlimitedGradient1" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" style="stop-color:#1d4ed8;stop-opacity:1" />
                    <stop offset="100%" style="stop-color:#8b5cf6;stop-opacity:1" />
                  </linearGradient>
                </defs>
              </svg>
              <div>
                <h4 class="text-lg font-bold text-white mb-1">Content Updates</h4>
                <p class="text-gray-300">Change text, images, and pages whenever you need</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <svg class="flex-shrink-0 w-8 h-8 mt-1" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="12" r="10" fill="url(#unlimitedGradient2)" />
                <path d="M8 12.5L10.5 15L16 9.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <defs>
                  <linearGradient id="unlimitedGradient2" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" style="stop-color:#1d4ed8;stop-opacity:1" />
                    <stop offset="100%" style="stop-color:#8b5cf6;stop-opacity:1" />
                  </linearGradient>
                </defs>
              </svg>
              <div>
                <h4 class="text-lg font-bold text-white mb-1">Design Improvements</h4>
                <p class="text-gray-300">Refresh layouts and styling to stay modern</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <svg class="flex-shrink-0 w-8 h-8 mt-1" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="12" r="10" fill="url(#unlimitedGradient3)" />
                <path d="M8 12.5L10.5 15L16 9.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <defs>
                  <linearGradient id="unlimitedGradient3" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" style="stop-color:#1d4ed8;stop-opacity:1" />
                    <stop offset="100%" style="stop-color:#8b5cf6;stop-opacity:1" />
                  </linearGradient>
                </defs>
              </svg>
              <div>
                <h4 class="text-lg font-bold text-white mb-1">New Features</h4>
                <p class="text-gray-300">Add functionality as your needs evolve</p>
              </div>
            </div>

            <div class="flex items-start gap-4">
              <svg class="flex-shrink-0 w-8 h-8 mt-1" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="12" cy="12" r="10" fill="url(#unlimitedGradient4)" />
                <path d="M8 12.5L10.5 15L16 9.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <defs>
                  <linearGradient id="unlimitedGradient4" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" style="stop-color:#1d4ed8;stop-opacity:1" />
                    <stop offset="100%" style="stop-color:#8b5cf6;stop-opacity:1" />
                  </linearGradient>
                </defs>
              </svg>
              <div>
                <h4 class="text-lg font-bold text-white mb-1">Performance Optimization</h4>
                <p class="text-gray-300">Keep your site fast and secure with regular updates</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Visual Stats -->
        <div class="relative">
          <!-- Floating badge -->
          <div class="absolute -top-4 left-1/2 -translate-x-1/2 px-6 py-2 bg-gradient-to-r from-primary-700 to-primary-800 text-white text-sm font-bold rounded-full shadow-2xl z-20 whitespace-nowrap">
            Included Forever
          </div>

          <!-- Big number display -->
          <div class="bg-white border-2 border-gray-200 rounded-3xl p-12 shadow-2xl">
            <div class="text-center mb-8">
              <div class="inline-flex justify-center items-center">
                <svg class="w-full max-w-2xl h-40 md:h-48" viewBox="20 20 147.3 53.7" preserveAspectRatio="xMidYMid meet">
                  <defs>
                    <linearGradient id="infinityGradient" x1="0%" y1="0%" x2="100%" y2="0%">
                      <stop offset="0%" style="stop-color:#1d4ed8;stop-opacity:1">
                        <animate attributeName="stop-color" values="#1d4ed8; #0891b2; #8b5cf6; #1d4ed8" dur="8s" repeatCount="indefinite" />
                      </stop>
                      <stop offset="50%" style="stop-color:#0891b2;stop-opacity:1">
                        <animate attributeName="stop-color" values="#0891b2; #8b5cf6; #1d4ed8; #0891b2" dur="8s" repeatCount="indefinite" />
                      </stop>
                      <stop offset="100%" style="stop-color:#8b5cf6;stop-opacity:1">
                        <animate attributeName="stop-color" values="#8b5cf6; #1d4ed8; #0891b2; #8b5cf6" dur="8s" repeatCount="indefinite" />
                      </stop>
                    </linearGradient>
                    <filter id="infinityGlow" x="-50%" y="-50%" width="200%" height="200%">
                      <feGaussianBlur stdDeviation="3" result="coloredBlur"/>
                      <feMerge>
                        <feMergeNode in="coloredBlur"/>
                        <feMergeNode in="SourceGraphic"/>
                      </feMerge>
                    </filter>
                  </defs>
                  <path id="infinity-outline-bg" opacity="0.225" fill="none" stroke="url(#infinityGradient)" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" stroke-miterlimit="10"
                        d="M93.9,46.4c9.3,9.5,13.8,17.9,23.5,17.9s17.5-7.8,17.5-17.5s-7.8-17.6-17.5-17.5c-9.7,0.1-13.3,7.2-22.1,17.1c-8.9,8.8-15.7,17.9-25.4,17.9s-17.5-7.8-17.5-17.5s7.8-17.5,17.5-17.5S86.2,38.6,93.9,46.4z" />
                  <path stroke="url(#infinityGradient)" id="infinity-outline" fill="none" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" stroke-miterlimit="10" filter="url(#infinityGlow)"
                        d="M93.9,46.4c9.3,9.5,13.8,17.9,23.5,17.9s17.5-7.8,17.5-17.5s-7.8-17.6-17.5-17.5c-9.7,0.1-13.3,7.2-22.1,17.1c-8.9,8.8-15.7,17.9-25.4,17.9s-17.5-7.8-17.5-17.5s7.8-17.5,17.5-17.5S86.2,38.6,93.9,46.4z" />
                </svg>
              </div>
              <p class="text-2xl font-bold text-gray-900 mt-4">Changes Per Month</p>
              <p class="text-gray-600 mt-2">No limits. No extra charges.</p>
            </div>

            <div class="border-t border-gray-200 pt-8 space-y-6 max-w-xs mx-auto">
              <div class="flex justify-between items-center">
                <span class="text-gray-600">Average Response Time</span>
                <span class="text-2xl font-bold text-gray-900">24hrs</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-gray-600">Pages You Can Update</span>
                <span class="text-2xl font-bold text-gray-900">All</span>
              </div>
              <div class="flex justify-between items-center">
                <span class="text-gray-600">Additional Fees</span>
                <span class="text-2xl font-bold text-primary-700">$0</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Client Logos Section -->
  <section class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-center text-sm font-semibold text-gray-600 uppercase tracking-wider mb-8">
        Trusted by Hundreds of Smart Business Owners
      </p>
    </div>

    <!-- Logo marquee with hover pause - Full width -->
    <div class="logo-marquee-container relative overflow-hidden w-full">
        <!-- Fade edges -->
        <div class="absolute left-0 top-0 bottom-0 w-16 md:w-32 bg-gradient-to-r from-white via-white/80 to-transparent z-10 pointer-events-none"></div>
        <div class="absolute right-0 top-0 bottom-0 w-16 md:w-32 bg-gradient-to-l from-white via-white/80 to-transparent z-10 pointer-events-none"></div>

        <div class="logo-marquee-track flex">
          <!-- First set of logos -->
          <div class="logo-marquee-content flex items-center gap-8 md:gap-16 px-4 md:px-8">
            <a href="https://life2health.com" target="_blank" rel="noopener noreferrer" class="brand-logo flex-shrink-0">
              <img src="/images/logos/life2health.png" alt="Life2Health" loading="lazy" />
            </a>
            <a href="https://domluke.com/" target="_blank" rel="noopener noreferrer" class="brand-logo flex-shrink-0">
              <img src="/images/logos/dom.gif" alt="DOM" loading="lazy" />
            </a>
            <a href="https://dsmmd.com" target="_blank" rel="noopener noreferrer" class="brand-logo flex-shrink-0">
              <img src="/images/logos/dsm-md.webp" alt="DSM MD" loading="lazy" />
            </a>
            <a href="https://galleriamedpharmacy.com/" target="_blank" rel="noopener noreferrer" class="brand-logo flex-shrink-0">
              <img src="/images/logos/galleria-medical-pharmacy.png" alt="Galleria Medical Pharmacy" loading="lazy" />
            </a>
            <a href="https://lovemoremcc.com/" target="_blank" rel="noopener noreferrer" class="brand-logo flex-shrink-0">
              <img src="/images/logos/lovemore.webp" alt="LoveMore" loading="lazy" />
            </a>
            <a href="https://supportivwellness.com/" target="_blank" rel="noopener noreferrer" class="brand-logo flex-shrink-0">
              <img src="/images/logos/support-iv.webp" alt="SupportIV" loading="lazy" />
            </a>
            <a href="https://gracemidwiferycollective.com/" target="_blank" rel="noopener noreferrer" class="brand-logo flex-shrink-0">
              <img src="/images/logos/gmc.png" alt="Grace Midwifery Collective" loading="lazy" />
            </a>
          </div>
          <!-- Duplicate set for seamless loop -->
          <div class="logo-marquee-content flex items-center gap-8 md:gap-16 px-4 md:px-8" aria-hidden="true">
            <a href="https://life2health.com" target="_blank" rel="noopener noreferrer" class="brand-logo flex-shrink-0" tabindex="-1">
              <img src="/images/logos/life2health.png" alt="Life2Health" loading="lazy" />
            </a>
            <a href="https://domluke.com/" target="_blank" rel="noopener noreferrer" class="brand-logo flex-shrink-0" tabindex="-1">
              <img src="/images/logos/dom.gif" alt="DOM" loading="lazy" />
            </a>
            <a href="https://dsmmd.com" target="_blank" rel="noopener noreferrer" class="brand-logo flex-shrink-0" tabindex="-1">
              <img src="/images/logos/dsm-md.webp" alt="DSM MD" loading="lazy" />
            </a>
            <a href="https://galleriamedpharmacy.com/" target="_blank" rel="noopener noreferrer" class="brand-logo flex-shrink-0" tabindex="-1">
              <img src="/images/logos/galleria-medical-pharmacy.png" alt="Galleria Medical Pharmacy" loading="lazy" />
            </a>
            <a href="https://lovemoremcc.com/" target="_blank" rel="noopener noreferrer" class="brand-logo flex-shrink-0" tabindex="-1">
              <img src="/images/logos/lovemore.webp" alt="LoveMore" loading="lazy" />
            </a>
            <a href="https://supportivwellness.com/" target="_blank" rel="noopener noreferrer" class="brand-logo flex-shrink-0" tabindex="-1">
              <img src="/images/logos/support-iv.webp" alt="SupportIV" loading="lazy" />
            </a>
            <a href="https://gracemidwiferycollective.com/" target="_blank" rel="noopener noreferrer" class="brand-logo flex-shrink-0" tabindex="-1">
              <img src="/images/logos/gmc.png" alt="Grace Midwifery Collective" loading="lazy" />
            </a>
          </div>
        </div>
      </div>
  </section>

  <!-- Pricing Section -->
  <PricingSection />

  <!-- Features Grid -->
  <section class="py-20 md:py-28 bg-gradient-to-b from-white to-gray-200 relative overflow-hidden">
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
          Everything You Need
        </h2>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          Professional features that help your business stand out online.
        </p>
      </div>

      <!-- Stripe-style feature table -->
      <div class="features-table relative">
        <!-- Row 1 -->
        <div class="grid grid-cols-1 md:grid-cols-3">
          <div class="feature-cell group">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center mb-4 bg-gradient-to-br from-primary-600 to-primary-700">
              <Rocket class="w-5 h-5 text-white" />
            </div>
            <h3 class="text-base font-semibold text-gray-900 mb-2">Launch in 2 Weeks</h3>
            <p class="text-gray-500 text-sm leading-relaxed">Get your site up and running fast with our streamlined process.</p>
          </div>

          <div class="feature-cell group">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center mb-4 bg-gradient-to-br from-primary-600 to-primary-700">
              <DollarSign class="w-5 h-5 text-white" />
            </div>
            <h3 class="text-base font-semibold text-gray-900 mb-2">No Set-Up Fees</h3>
            <p class="text-gray-500 text-sm leading-relaxed">Pay one simple monthly rate with no hidden costs or surprises.</p>
          </div>

          <div class="feature-cell group">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center mb-4 bg-gradient-to-br from-primary-600 to-primary-700">
              <Smartphone class="w-5 h-5 text-white" />
            </div>
            <h3 class="text-base font-semibold text-gray-900 mb-2">Mobile-First Design</h3>
            <p class="text-gray-500 text-sm leading-relaxed">Optimized for mobile devices where most visitors browse.</p>
          </div>
        </div>

        <!-- Row 2 -->
        <div class="grid grid-cols-1 md:grid-cols-3">
          <div class="feature-cell group">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center mb-4 bg-gradient-to-br from-primary-600 to-primary-700">
              <Zap class="w-5 h-5 text-white" />
            </div>
            <h3 class="text-base font-semibold text-gray-900 mb-2">Lightning Fast</h3>
            <p class="text-gray-500 text-sm leading-relaxed">Optimized performance keeps visitors engaged and improves SEO.</p>
          </div>

          <div class="feature-cell group">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center mb-4 bg-gradient-to-br from-primary-600 to-primary-700">
              <Globe class="w-5 h-5 text-white" />
            </div>
            <h3 class="text-base font-semibold text-gray-900 mb-2">SEO Optimized</h3>
            <p class="text-gray-500 text-sm leading-relaxed">Built for search engines to help customers find you easily.</p>
          </div>

          <div class="feature-cell group">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center mb-4 bg-gradient-to-br from-primary-600 to-primary-700">
              <Palette class="w-5 h-5 text-white" />
            </div>
            <h3 class="text-base font-semibold text-gray-900 mb-2">Custom Design</h3>
            <p class="text-gray-500 text-sm leading-relaxed">Unique, brand-aligned designs that set you apart.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Process Section -->
