    border-radius: 0.75rem;
    padding: 0.875rem 2rem;
    font-size: 1rem;
  }

  .btn-outline:hover {
    background: rgba(30, 64, 175, 0.05);
  }

  /* Button sizes */
  .btn-sm {
    padding: 0.625rem 1.25rem;
    font-size: 0.875rem;
  }

  .btn-lg {
