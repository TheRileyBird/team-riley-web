---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import PricingSection from '../components/PricingSection.astro';
import ShaderBackground from '@/components/ui/ShaderBackground.astro';
import { Image } from 'astro:assets';
import { ArrowRight, CheckCircle2, XCircle, Zap, Smartphone, Palette, Globe, Rocket, DollarSign } from '@lucide/astro';
import careptSite from '../assets/sites/carept.png';
import cfcSite from '../assets/sites/cfc.png';
import dsmmdSite from '../assets/sites/dsmmd.png';
import lovemoreSite from '../assets/sites/lovemore.png';
import garrettSite from '../assets/sites/garrett.png';
import dailywisdomSite from '../assets/sites/dailywisdom.png';
import life2healthSite from '../assets/sites/life2health.png';
import domlukeSite from '../assets/sites/domluke.png';
import nazarethSite from '../assets/sites/nazareth.png';
import graceSite from '../assets/sites/grace.png';
---

<BaseLayout title="Team Riley Web - Digital Health For Your Business">
  <Navigation />

  <!-- Hero Section -->
  <section class="relative min-h-[680px] overflow-hidden bg-white pt-28 pb-20 md:min-h-[760px] md:pt-36 md:pb-32 lg:bg-slate-50">
    <div class="hidden lg:block">
      <ShaderBackground />
    </div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(255,255,255,0.96)_0%,rgba(248,250,252,0.92)_42%,rgba(219,234,254,0.6)_100%)] md:bg-[radial-gradient(ellipse_at_center,rgba(255,255,255,0.98)_0%,rgba(255,255,255,0.92)_34%,rgba(219,234,254,0.74)_70%,rgba(196,181,253,0.5)_100%)] lg:bg-[radial-gradient(ellipse_at_center,rgba(255,255,255,0.98)_0%,rgba(255,255,255,0.86)_30%,rgba(255,255,255,0.18)_64%,rgba(255,255,255,0)_100%)]"></div>
    <div class="absolute -left-36 top-12 hidden h-96 w-96 rounded-full bg-primary-300/45 blur-3xl md:block lg:hidden"></div>
    <div class="absolute -right-36 bottom-0 hidden h-[28rem] w-[28rem] rounded-full bg-secondary-300/35 blur-3xl md:block lg:hidden"></div>
    <div class="absolute inset-x-0 top-0 h-64 bg-[linear-gradient(135deg,rgba(219,234,254,0.88),rgba(255,255,255,0.7)_48%,rgba(207,250,254,0.6))] md:hidden"></div>
    <div class="absolute -left-20 top-28 h-56 w-56 rounded-full bg-primary-200/45 blur-3xl md:hidden"></div>
    <div class="absolute -right-24 bottom-16 h-64 w-64 rounded-full bg-accent-200/55 blur-3xl md:hidden"></div>
    <div class="absolute inset-x-0 bottom-0 h-36 bg-gradient-to-b from-transparent to-gray-100"></div>
    <div class="absolute inset-x-0 top-0 h-36 bg-gradient-to-t from-transparent to-white"></div>

    <div class="relative z-10 mx-auto flex min-h-[520px] max-w-5xl flex-col items-center justify-center px-4 text-center sm:px-6 md:min-h-[560px] lg:px-8">
      <div class="inline-flex items-center gap-2 rounded-full border border-primary-200 bg-white/90 px-4 py-2 shadow-soft backdrop-blur-md">
        <span class="h-1.5 w-1.5 rounded-full bg-accent-400"></span>
        <span class="text-xs font-semibold uppercase tracking-wider leading-snug text-primary-800 sm:text-sm">Digital Health For Your Business</span>
      </div>

      <h1 class="mt-7 text-balance text-5xl uppercase font-bold leading-[0.95] text-gray-950 sm:text-6xl md:mt-8 lg:text-7xl xl:text-8xl">
        <span>Do you want </span>
        <span class="animated-gradient-text block md:inline">more clients?</span>
      </h1>

      <p class="mx-auto mt-6 max-w-2xl text-pretty text-lg leading-relaxed text-slate-600 md:text-xl">
        Scale your revenue with a world-class online presence, patient acquisition, automated marketing, and unlimited updates.
      </p>

      <div class="mt-9 flex w-full flex-col justify-center gap-3 sm:w-auto sm:flex-row md:mt-10 md:gap-4">
        <a href="/portfolio" class="btn btn-primary btn-lg">
          View Our Work
          <ArrowRight class="w-5 h-5" />
        </a>
        <a href="/pricing" class="btn btn-secondary btn-lg">
          View Pricing
        </a>
      </div>

      <!--<div class="mt-10 flex flex-col items-center justify-center gap-4 text-slate-700 sm:flex-row sm:gap-8">-->
      <!--  <div class="flex items-center gap-2">-->
      <!--    <CheckCircle2 class="h-5 w-5 text-primary-700" />-->
      <!--    <span class="text-sm font-medium">Unlimited Updates</span>-->
      <!--  </div>-->
      <!--  <div class="flex items-center gap-2">-->
      <!--    <CheckCircle2 class="h-5 w-5 text-primary-700" />-->
      <!--    <span class="text-sm font-medium">Launch in 2 Weeks</span>-->
      <!--  </div>-->
      <!--</div>-->
    </div>
  </section>

  <!-- Visibility Gap Section -->
  <section class="py-20 lg:py-0 bg-gray-950 relative overflow-hidden lg:min-h-[680px] flex flex-col lg:block">
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-primary-500/40 to-transparent"></div>
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-16 right-10 w-80 h-80 bg-primary-600 rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 left-10 w-72 h-72 bg-accent-500 rounded-full blur-3xl"></div>
    </div>

    <div class="relative order-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 lg:mt-0">
      <div class="lg:ml-[50%] lg:min-h-[680px] lg:py-28 flex items-center">
        <div>
          <div class="inline-flex items-center px-4 py-2 bg-primary-900/50 border-l-4 border-primary-500 rounded-r-lg mb-6">
            <span class="text-sm font-bold text-primary-300 uppercase tracking-wider">Managed For You</span>
          </div>

          <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight mb-6">
            Stand Out<br>
            <span class="animated-gradient-text"> Build Trust</span>
          </h2>

          <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl">
            We craft a world-class digital presence for health and wellness businesses. Your brand should reflect the true quality of care your expertise so you can stop being the best-kept secret in your market and start being the most visible, most trusted, and most booked practice in your area.
          </p>
          <a href="/#book-a-call"
             data-booking-modal-open
             class="btn btn-primary shadow-xl">
            Learn more
            <ArrowRight class="w-5 h-5" />
          </a>
        </div>
      </div>
    </div>

    <div class="portfolio-scroll-gallery order-2 relative mt-12 lg:mt-0 lg:absolute lg:inset-y-0 lg:left-0 lg:w-[44vw] h-[440px] md:h-[520px] lg:h-full overflow-hidden">
      <div class="pointer-events-none absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-gray-950 to-transparent z-10"></div>
      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-gray-950 to-transparent z-10"></div>
      <div class="grid grid-cols-2 gap-4 md:gap-5 p-4 md:p-5 -mt-10">
        <div class="portfolio-scroll-column portfolio-scroll-column-up space-y-4 md:space-y-5">
          <Image src={nazarethSite} alt="CarePT website portfolio preview" class="aspect-video w-full rounded-xl object-cover object-top shadow-lg" />
          <Image src={cfcSite} alt="DSM MD website portfolio preview" class="aspect-video w-full rounded-xl object-cover object-top shadow-lg" />
          <Image src={dailywisdomSite} alt="LoveMore website portfolio preview" class="aspect-video w-full rounded-xl object-cover object-top shadow-lg" />
          <Image src={lovemoreSite} alt="Daily Wisdom website portfolio preview" class="aspect-video w-full rounded-xl object-cover object-top shadow-lg" />
          <Image src={nazarethSite} alt="Nazareth website portfolio preview" class="aspect-video w-full rounded-xl object-cover object-top shadow-lg" />
          <Image src={careptSite} alt="" class="aspect-video w-full rounded-xl object-cover object-top shadow-lg" aria-hidden="true" />
        </div>
        <div class="portfolio-scroll-column portfolio-scroll-column-down space-y-4 md:space-y-5 pt-16">
          <Image src={life2healthSite} alt="Life2Health website portfolio preview" class="aspect-video w-full rounded-xl object-cover object-top shadow-lg" />
          <Image src={domlukeSite} alt="Dom Luke website portfolio preview" class="aspect-video w-full rounded-xl object-cover object-top shadow-lg" />
          <Image src={graceSite} alt="Grace Midwifery Collective website portfolio preview" class="aspect-video w-full rounded-xl object-cover object-top shadow-lg" />
          <Image src={dsmmdSite} alt="CFC website portfolio preview" class="aspect-video w-full rounded-xl object-cover object-top shadow-lg" />
          <Image src={garrettSite} alt="Garrett website portfolio preview" class="aspect-video w-full rounded-xl object-cover object-top shadow-lg" />
          <Image src={life2healthSite} alt="" class="aspect-video w-full rounded-xl object-cover object-top shadow-lg" aria-hidden="true" />
        </div>
      </div>
    </div>
  </section>

  <!-- Problem Section -->
  <section class="aurora-light-section py-20 md:py-28 bg-white relative overflow-hidden">
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center mb-12">
        <div class="inline-flex items-center px-4 py-2 bg-primary-100 border-l-4 border-primary-700 rounded-r-lg mb-6">
          <span class="text-sm font-semibold text-primary-800">The Problem</span>
        </div>
        <h2 class="max-w-3xl mx-auto text-4xl md:text-5xl font-bold text-gray-900 mb-6">
          If Your Digital Presence Doesn’t Match Your <span class="animated-gradient-text">Level of Care...</span>
        </h2>
        <!--<p class="text-xl text-gray-800 mb-6">Most health businesses don’t have a service problem.<br>They have a visibility, trust, and positioning problem.</p>-->
        <!--<p class="text-xl text-gray-700 leading-relaxed">What they actually need is the digital infrastructure that makes patients trust them faster and take the next step with less friction.</p>-->
      </div>

      <div class="grid md:grid-cols-2 gap-6 max-w-5xl mx-auto">
        <div class="rounded-xl border border-gray-200 bg-white/80 backdrop-blur-sm p-8 shadow-soft">
          <h3 class="text-xl font-bold text-gray-900 mb-5">Patients choose competitors with:</h3>
          <ul class="space-y-3">
            <li class="flex gap-3 text-gray-700"><CheckCircle2 class="w-5 h-5 text-primary-700 flex-shrink-0 mt-0.5" /> better websites</li>
            <li class="flex gap-3 text-gray-700"><CheckCircle2 class="w-5 h-5 text-primary-700 flex-shrink-0 mt-0.5" /> better branding</li>
            <li class="flex gap-3 text-gray-700"><CheckCircle2 class="w-5 h-5 text-primary-700 flex-shrink-0 mt-0.5" /> better Google presence</li>
            <li class="flex gap-3 text-gray-700"><CheckCircle2 class="w-5 h-5 text-primary-700 flex-shrink-0 mt-0.5" /> better reviews and social proof</li>
          </ul>
        </div>
        <div class="rounded-xl border border-gray-200 bg-white/80 backdrop-blur-sm p-8 shadow-soft">
          <h3 class="text-xl font-bold text-gray-900 mb-5">Your business loses when it's:</h3>
          <ul class="space-y-3">
            <li class="flex gap-3 text-gray-700"><XCircle class="w-5 h-5 text-secondary-600 flex-shrink-0 mt-0.5" /> represented by a dated website</li>
            <li class="flex gap-3 text-gray-700"><XCircle class="w-5 h-5 text-secondary-600 flex-shrink-0 mt-0.5" /> inconsistent across search, social, and booking</li>
            <li class="flex gap-3 text-gray-700"><XCircle class="w-5 h-5 text-secondary-600 flex-shrink-0 mt-0.5" /> hard to find online</li>
            <li class="flex gap-3 text-gray-700"><XCircle class="w-5 h-5 text-secondary-600 flex-shrink-0 mt-0.5" /> unclear about what makes you different</li>
          </ul>
        </div>
      </div>

      <p class="text-2xl text-gray-700 mb-10 mt-16 max-w-4xl mx-auto text-center text-balance">Most health businesses don’t have a service problem.<br>They have a visibility, trust, and positioning problem.</p>
      <div class="max-w-5xl mx-auto mt-8 relative overflow-hidden bg-gradient-to-br from-gray-900 via-gray-950 to-black rounded-2xl p-10 md:p-12 shadow-large ring-1 ring-white/10">
        <div class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-primary-600/20 blur-3xl"></div>
        <div class="pointer-events-none absolute -left-16 -bottom-16 h-56 w-56 rounded-full bg-accent-500/15 blur-3xl"></div>
        <p class="relative text-center text-2xl md:text-3xl font-bold text-white max-w-4xl mx-auto text-balance leading-snug">
          Team Riley fixes the disconnect between the quality of your work and the way your business appears online.
        </p>
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section id="process" class="py-20 md:py-28 bg-gradient-to-b from-gray-900 via-gray-950 to-black relative overflow-hidden">
    <!-- Gradient blurs -->
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-0 right-1/4 w-[500px] h-[500px] bg-primary-500 rounded-full blur-[120px]"></div>
      <div class="absolute bottom-0 left-1/4 w-[400px] h-[400px] bg-accent-400 rounded-full blur-[100px]"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-violet-400 rounded-full blur-[150px]"></div>
    </div>

    <!-- Dot pattern overlay -->
    <div class="absolute inset-0 opacity-[0.03] text-white" style="background-image: radial-gradient(circle at 1px 1px, currentColor 1px, transparent 1px); background-size: 32px 32px;"></div>

    <!-- Geometric shapes -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
      <!-- Top left decorative circles -->
      <div class="absolute -top-20 -left-20 w-80 h-80 animate-float-very-slow">
        <div class="absolute inset-0 border-2 border-primary-400/20 rounded-full"></div>
        <div class="absolute inset-8 border border-primary-400/15 rounded-full"></div>
        <div class="absolute inset-16 border border-primary-400/10 rounded-full"></div>
      </div>

      <!-- Bottom right decorative circles -->
      <div class="absolute -bottom-24 -right-24 w-96 h-96 animate-float-very-slow" style="animation-delay: -10s;">
        <div class="absolute inset-0 border-2 border-violet-400/20 rounded-full"></div>
        <div class="absolute inset-10 border border-violet-400/15 rounded-full"></div>
        <div class="absolute inset-20 border border-violet-400/10 rounded-full"></div>
      </div>

      <!-- Subtle connecting lines (horizontal accent) -->
      <svg class="absolute top-20 left-0 w-full h-1 opacity-10" preserveAspectRatio="none">
        <defs>
          <linearGradient id="process-line-grad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" style="stop-color:transparent" />
            <stop offset="20%" style="stop-color:#3b82f6" />
            <stop offset="50%" style="stop-color:#8b5cf6" />
            <stop offset="80%" style="stop-color:#3b82f6" />
            <stop offset="100%" style="stop-color:transparent" />
          </linearGradient>
        </defs>
        <line x1="0" y1="0" x2="100%" y2="0" stroke="url(#process-line-grad)" stroke-width="2" stroke-dasharray="8 8"/>
      </svg>
      <svg class="absolute bottom-20 left-0 w-full h-1 opacity-10" preserveAspectRatio="none">
        <line x1="0" y1="0" x2="100%" y2="0" stroke="url(#process-line-grad)" stroke-width="2" stroke-dasharray="8 8"/>
      </svg>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <div class="inline-flex items-center px-4 py-2 bg-primary-900/50 border-l-4 border-primary-500 rounded-r-lg mb-6">
          <span class="text-sm font-bold text-primary-300 uppercase tracking-wider">The Solution</span>
        </div>
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-4">
          We build the system, then keep it moving.
        </h2>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto">
          A simple path from invisible online to easier to find, easier to trust, and easier to book.
        </p>
      </div>

      <!-- Connected Steps Container -->
      <div class="relative max-w-5xl mx-auto">
        <!-- Continuous connecting line (desktop) -->
        <div class="hidden md:block absolute top-10 left-[calc(16.67%-10px)] right-[calc(16.67%-10px)] h-1">
          <div class="absolute inset-0 bg-gray-700 rounded-full"></div>
          <div class="absolute inset-0 bg-gradient-to-r from-primary-500 via-primary-400 to-primary-500 rounded-full process-line-animate"></div>
        </div>

        <div class="grid md:grid-cols-3 gap-8 md:gap-4">
          <!-- Step 1 -->
          <div class="relative flex flex-col items-center text-center group">
            <!-- Mobile connector line (vertical) -->
            <div class="md:hidden absolute top-20 left-1/2 -translate-x-1/2 w-1 h-[calc(100%+2rem)] bg-gradient-to-b from-primary-500 to-primary-400 rounded-full"></div>

            <div class="relative z-10">
              <!-- Outer ring -->
              <div class="absolute -inset-2 bg-gradient-to-br from-primary-400/30 to-primary-600/30 rounded-full blur-sm group-hover:from-primary-400/40 group-hover:to-primary-600/40 transition-all duration-300"></div>
              <!-- Number circle -->
              <div class="relative w-20 h-20 bg-gradient-to-br from-secondary-300 to-primary-500 rounded-full shadow-xl flex items-center justify-center ring-4 ring-gray-900 step-badge">
                <span class="text-3xl font-bold text-white">1</span>
              </div>
            </div>

            <div class="mt-8 bg-gradient-to-br from-gray-800 to-gray-900 rounded-2xl p-6 shadow-lg border border-gray-700 group-hover:shadow-large group-hover:-translate-y-1 transition-all duration-300 relative z-0">
              <h3 class="text-xl font-bold text-white mb-3">Complete the Form</h3>
              <p class="text-gray-300">Tell us about your practice, goals, and the patients you want to reach.</p>
            </div>
          </div>

          <!-- Step 2 -->
          <div class="relative flex flex-col items-center text-center group md:mt-0 mt-8">
            <!-- Mobile connector line (vertical) -->
            <div class="md:hidden absolute top-20 left-1/2 -translate-x-1/2 w-1 h-[calc(100%+2rem)] bg-gradient-to-b from-primary-400 to-primary-500 rounded-full"></div>

            <div class="relative z-10">
              <!-- Rotating dashed circle -->
              <svg class="absolute -inset-8 w-36 h-36 animate-rotate-slow" viewBox="0 0 100 100">
                <circle cx="50" cy="50" r="48" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="6 6" class="text-primary-400/25" />
              </svg>
              <!-- Outer ring -->
              <div class="absolute -inset-2 bg-gradient-to-br from-primary-500/30 to-primary-600/30 rounded-full blur-sm group-hover:from-primary-500/40 group-hover:to-primary-600/40 transition-all duration-300"></div>
              <!-- Number circle -->
              <div class="relative w-20 h-20 bg-gradient-to-br from-primary-500 to-primary-600 rounded-full shadow-xl flex items-center justify-center ring-4 ring-gray-900 step-badge">
                <span class="text-3xl font-bold text-white">2</span>
              </div>
            </div>

            <div class="mt-8 bg-gradient-to-br from-gray-800 to-gray-900 rounded-2xl p-6 shadow-lg border border-gray-700 group-hover:shadow-large group-hover:-translate-y-1 transition-all duration-300 relative z-0">
              <h3 class="text-xl font-bold text-white mb-3">We Build Your Site</h3>
              <p class="text-gray-300">We create the website, messaging, and digital foundation your market should see.</p>
            </div>
          </div>

          <!-- Step 3 -->
          <div class="relative flex flex-col items-center text-center group md:mt-0 mt-8">
            <div class="relative z-10">
              <!-- Outer ring -->
              <div class="absolute -inset-2 bg-gradient-to-br from-primary-600/30 to-primary-800/30 rounded-full blur-sm group-hover:from-primary-600/40 group-hover:to-primary-800/40 transition-all duration-300"></div>
              <!-- Number circle -->
              <div class="relative w-20 h-20 bg-gradient-to-br from-primary-700 to-secondary-700 rounded-full shadow-xl flex items-center justify-center ring-4 ring-gray-900 step-badge">
                <span class="text-3xl font-bold text-white">3</span>
              </div>
            </div>

            <div class="mt-8 bg-gradient-to-br from-gray-800 to-gray-900 rounded-2xl p-6 shadow-lg border border-gray-700 group-hover:shadow-large group-hover:-translate-y-1 transition-all duration-300">
              <h3 class="text-xl font-bold text-white mb-3">Launch & Grow</h3>
              <p class="text-gray-300">Go live with a managed presence that keeps improving as your practice grows.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- CTA -->
      <div class="text-center mt-16">
        <a href="/#book-a-call"
          data-booking-modal-open
          class="btn btn-primary btn-lg shadow-xl">
          Start Your Project Today
          <ArrowRight class="w-5 h-5" />
        </a>
      </div>
    </div>
  </section>


  <!-- Client Logos Section -->
  <section class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-center text-sm font-semibold text-gray-600 uppercase tracking-wider mb-8">
        Trusted by Hundreds of Smart Business Owners
      </p>
    </div>

    <!-- Logo marquee with hover pause - Full width -->
    <div class="logo-marquee-container relative overflow-hidden w-full">
      <!-- Fade edges -->
      <div class="absolute left-0 top-0 bottom-0 w-16 md:w-32 bg-gradient-to-r from-white via-white/80 to-transparent z-10 pointer-events-none"></div>
      <div class="absolute right-0 top-0 bottom-0 w-16 md:w-32 bg-gradient-to-l from-white via-white/80 to-transparent z-10 pointer-events-none"></div>

      <div class="logo-marquee-track flex">
        <!-- First set of logos -->
        <div class="logo-marquee-content flex items-center gap-8 md:gap-16 px-4 md:px-8">
          <a href="https://life2health.com" target="_blank" rel="noopener noreferrer" class="brand-logo flex-shrink-0">
            <img src="/images/logos/life2health.png" alt="Life2Health" loading="lazy" />
          </a>
          <a href="https://domluke.com/" target="_blank" rel="noopener noreferrer" class="brand-logo flex-shrink-0">
            <img src="/images/logos/dom.gif" alt="DOM" loading="lazy" />
          </a>
          <a href="https://dsmmd.com" target="_blank" rel="noopener noreferrer" class="brand-logo flex-shrink-0">
            <img src="/images/logos/dsm-md.webp" alt="DSM MD" loading="lazy" />
          </a>
          <a href="https://galleriamedpharmacy.com/" target="_blank" rel="noopener noreferrer" class="brand-logo flex-shrink-0">
            <img src="/images/logos/galleria-medical-pharmacy.png" alt="Galleria Medical Pharmacy" loading="lazy" />
          </a>
          <a href="https://lovemoremcc.com/" target="_blank" rel="noopener noreferrer" class="brand-logo flex-shrink-0">
            <img src="/images/logos/lovemore.webp" alt="LoveMore" loading="lazy" />
          </a>
          <a href="https://supportivwellness.com/" target="_blank" rel="noopener noreferrer" class="brand-logo flex-shrink-0">
            <img src="/images/logos/support-iv.webp" alt="SupportIV" loading="lazy" />
          </a>
          <a href="https://gracemidwiferycollective.com/" target="_blank" rel="noopener noreferrer" class="brand-logo flex-shrink-0">
            <img src="/images/logos/gmc.png" alt="Grace Midwifery Collective" loading="lazy" />
          </a>
        </div>
        <!-- Duplicate set for seamless loop -->
        <div class="logo-marquee-content flex items-center gap-8 md:gap-16 px-4 md:px-8" aria-hidden="true">
