---
import { content } from '../verticals/active';
const { hero, visibility, problem, process, features, clientLogos, clientLogosLabel, showcase } = content.home;
// The gallery is two staggered columns; fewer than six screenshots would visibly
// repeat, so a market without enough work shows the copy full-width instead.
const showGallery = showcase.length >= 6;
// Footage when the market has it, the shader when it does not. The two treatments
// need opposite text colors, so the hero switches palette rather than washing the
// video out until dark text reads on it.
const heroClips = hero.clips ?? [];
const hasHeroVideo = heroClips.length > 0 && Boolean(hero.poster);
const galleryColumns = showGallery
  ? [showcase.filter((_, index) => index % 2 === 0), showcase.filter((_, index) => index % 2 === 1)]
  : [];
// Icon per feature cell, in render order. The words are per market; the icons are not.
const featureIcons = [Rocket, DollarSign, Smartphone, Zap, Globe, Palette];
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import PricingSection from '../components/PricingSection.astro';
import HeroVideo from '../components/HeroVideo.astro';
import { Image } from 'astro:assets';
import { ArrowRight, CheckCircle2, XCircle, Zap, Smartphone, Palette, Globe, Rocket, DollarSign } from '@lucide/astro';
---

<BaseLayout title={content.home.title} description={content.home.description}>
  <Navigation />

  <!-- Hero Section -->
  <section
    data-no-reveal
    class:list={[
      'relative min-h-[680px] overflow-hidden pt-28 pb-20 md:min-h-[760px] md:pt-36 md:pb-32',
      hasHeroVideo ? 'bg-ink-950' : 'bg-white lg:bg-slate-50'
    ]}
  >
    {hasHeroVideo ? (
      <HeroVideo
        clips={heroClips}
        poster={hero.poster!}
        overlayClass="bg-[linear-gradient(180deg,rgb(var(--c-primary-1000)_/_0.78)_0%,rgb(var(--c-primary-900)_/_0.62)_45%,rgb(var(--c-primary-1000)_/_0.82)_100%)]"
      />
    ) : (
      <Fragment>
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(255,255,255,0.96)_0%,rgba(248,250,252,0.92)_42%,rgb(var(--c-primary-100)_/_0.6)_100%)] md:bg-[radial-gradient(ellipse_at_center,rgba(255,255,255,0.98)_0%,rgba(255,255,255,0.92)_34%,rgb(var(--c-primary-100)_/_0.74)_70%,rgb(var(--c-secondary-300)_/_0.5)_100%)] lg:bg-[radial-gradient(ellipse_at_center,rgba(255,255,255,0.98)_0%,rgba(255,255,255,0.86)_30%,rgba(255,255,255,0.18)_64%,rgba(255,255,255,0)_100%)]"></div>
        <div class="absolute -left-36 top-12 hidden h-96 w-96 rounded-full bg-primary-300/45 blur-3xl md:block lg:hidden"></div>
        <div class="absolute -right-36 bottom-0 hidden h-[28rem] w-[28rem] rounded-full bg-secondary-300/35 blur-3xl md:block lg:hidden"></div>
        <div class="absolute inset-x-0 top-0 h-64 bg-[linear-gradient(135deg,rgb(var(--c-primary-100)_/_0.88),rgba(255,255,255,0.7)_48%,rgb(var(--c-accent-100)_/_0.6))] md:hidden"></div>
        <div class="absolute -left-20 top-28 h-56 w-56 rounded-full bg-primary-200/45 blur-3xl md:hidden"></div>
        <div class="absolute -right-24 bottom-16 h-64 w-64 rounded-full bg-accent-200/55 blur-3xl md:hidden"></div>
      </Fragment>
    )}

    <div class="relative z-10 mx-auto flex min-h-[520px] max-w-5xl flex-col items-center justify-center px-4 text-center sm:px-6 md:min-h-[560px] lg:px-8">
      <div
        class:list={[
          'inline-flex items-center gap-2 rounded-full px-4 py-2 shadow-soft backdrop-blur-md',
          hasHeroVideo ? 'border border-white/25 bg-white/10' : 'border border-primary-200 bg-white/90'
        ]}
      >
        <span
          class:list={[
            'text-xs font-semibold uppercase tracking-wider leading-snug sm:text-sm',
            hasHeroVideo ? 'text-white' : 'text-primary-800'
          ]}
        >{hero.eyebrow}</span>
      </div>

      <h1
        class:list={[
          'mt-7 text-balance text-5xl uppercase font-bold leading-[0.95] sm:text-6xl md:mt-8 lg:text-7xl xl:text-8xl',
          hasHeroVideo ? 'text-white drop-shadow-[0_2px_18px_rgba(0,0,0,0.45)]' : 'text-gray-950'
        ]}
      >
        <span>{hero.heading.lead}</span>
        <span
          class:list={[
            'block md:inline',
            hasHeroVideo ? 'animated-gradient-text-bright' : 'animated-gradient-text'
          ]}
        >{hero.heading.highlight}</span>
      </h1>

      <p
        class:list={[
          'mx-auto mt-6 max-w-2xl text-pretty text-lg leading-relaxed md:text-xl',
          hasHeroVideo ? 'text-gray-100' : 'text-slate-600'
        ]}
      >
        {hero.subtitle}
      </p>

      <div class="mt-9 flex w-full flex-col justify-center gap-3 sm:w-auto sm:flex-row md:mt-10 md:gap-4">
        <a href="/portfolio" class="btn btn-primary btn-lg">
          View Our Work
          <ArrowRight class="w-5 h-5" />
        </a>
        <a href="/pricing" class="btn btn-secondary btn-lg">
          View Pricing
        </a>
      </div>

    </div>
  </section>

  <!-- Visibility Gap Section -->
  <section class="py-20 lg:py-0 bg-ink-950 relative overflow-hidden lg:min-h-[680px] flex flex-col lg:block">
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-primary-500/40 to-transparent"></div>
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-16 right-10 w-80 h-80 bg-primary-600 rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 left-10 w-72 h-72 bg-accent-500 rounded-full blur-3xl"></div>
    </div>

    <div class="relative order-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 lg:mt-0">
      <div class:list={[showGallery ? 'lg:ml-[50%]' : 'mx-auto max-w-4xl text-center', 'lg:min-h-[680px] lg:py-28 flex items-center']}>
        <div>
          <div class="inline-flex items-center px-4 py-2 bg-primary-900/50 border-l-4 border-primary-500 rounded-r-lg mb-6">
            <span class="text-sm font-bold text-primary-300 uppercase tracking-wider">{visibility.eyebrow}</span>
          </div>

          <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight mb-6">
            {visibility.heading.lead}<br>
            <span class="animated-gradient-text">{visibility.heading.highlight}</span>
          </h2>

          <p class="text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl">
            {visibility.body}
          </p>
          <a href="/#book-a-call"
             data-booking-modal-open
             class="btn btn-primary shadow-xl">
            Learn more
            <ArrowRight class="w-5 h-5" />
          </a>
        </div>
      </div>
    </div>

    {showGallery && (
      <div class="portfolio-scroll-gallery order-2 relative mt-12 lg:mt-0 lg:absolute lg:inset-y-0 lg:left-0 lg:w-[44vw] h-[440px] md:h-[520px] lg:h-full overflow-hidden">
        <div class="pointer-events-none absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-gray-950 to-transparent z-10"></div>
        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-gray-950 to-transparent z-10"></div>
        <div class="grid grid-cols-2 gap-4 md:gap-5 p-4 md:p-5 -mt-10">
          {galleryColumns.map((column, columnIndex) => (
            <div
              class:list={[
                'portfolio-scroll-column space-y-4 md:space-y-5',
                columnIndex === 0 ? 'portfolio-scroll-column-up' : 'portfolio-scroll-column-down pt-16'
              ]}
            >
              {column.map((shot) => (
                <Image
                  src={shot.src}
                  alt={shot.alt}
                  class="aspect-video w-full rounded-xl object-cover object-top shadow-lg"
                />
              ))}
            </div>
          ))}
        </div>
      </div>
    )}
  </section>

  <!-- Problem Section -->
  <section class="aurora-light-section py-20 md:py-28 bg-white relative overflow-hidden">
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center mb-12">
        <div class="inline-flex items-center px-4 py-2 bg-primary-100 border-l-4 border-primary-700 rounded-r-lg mb-6">
          <span class="text-sm font-semibold text-primary-800">The Problem</span>
        </div>
        <h2 class="max-w-3xl mx-auto text-4xl md:text-5xl font-bold text-gray-900 mb-6">
          {problem.heading.lead}<span class="animated-gradient-text">{problem.heading.highlight}</span>
        </h2>
      </div>

      <div class="grid md:grid-cols-2 gap-6 max-w-5xl mx-auto">
        <div class="rounded-xl border border-gray-200 bg-white/80 backdrop-blur-sm p-8 shadow-soft">
          <h3 class="text-xl font-bold text-gray-900 mb-5">{problem.competitorsTitle}</h3>
          <ul class="space-y-3">
            {problem.competitorAdvantages.map((advantage) => (
              <li class="flex gap-3 text-gray-700"><CheckCircle2 class="w-5 h-5 text-primary-700 flex-shrink-0 mt-0.5" /> {advantage}</li>
            ))}
          </ul>
        </div>
        <div class="rounded-xl border border-gray-200 bg-white/80 backdrop-blur-sm p-8 shadow-soft">
          <h3 class="text-xl font-bold text-gray-900 mb-5">{problem.lossesTitle}</h3>
          <ul class="space-y-3">
            {problem.losses.map((loss) => (
              <li class="flex gap-3 text-gray-700"><XCircle class="w-5 h-5 text-secondary-600 flex-shrink-0 mt-0.5" /> {loss}</li>
            ))}
          </ul>
        </div>
      </div>

      <p class="text-2xl text-gray-700 mb-10 mt-16 max-w-4xl mx-auto text-center text-balance" set:html={problem.summary}></p>
      <div class="max-w-5xl mx-auto mt-8 relative overflow-hidden bg-gradient-to-br from-ink-900 via-ink-950 to-black rounded-2xl p-10 md:p-12 shadow-large ring-1 ring-white/10">
        <div class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-primary-600/20 blur-3xl"></div>
        <div class="pointer-events-none absolute -left-16 -bottom-16 h-56 w-56 rounded-full bg-accent-500/15 blur-3xl"></div>
        <p class="relative text-center text-2xl md:text-3xl font-bold text-white max-w-4xl mx-auto text-balance leading-snug">
          {problem.closer}
        </p>
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section id="process" class="py-20 md:py-28 bg-gradient-to-b from-ink-900 via-ink-950 to-black relative overflow-hidden">
    <!-- Gradient blurs -->
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-0 right-1/4 w-[500px] h-[500px] bg-primary-500 rounded-full blur-[120px]"></div>
      <div class="absolute bottom-0 left-1/4 w-[400px] h-[400px] bg-accent-400 rounded-full blur-[100px]"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-secondary-400 rounded-full blur-[150px]"></div>
    </div>

    <!-- Dot pattern overlay -->
    <div class="absolute inset-0 opacity-[0.03] text-white" style="background-image: radial-gradient(circle at 1px 1px, currentColor 1px, transparent 1px); background-size: 32px 32px;"></div>

    <!-- Geometric shapes -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
      <!-- Top left decorative circles -->
      <div class="absolute -top-20 -left-20 w-80 h-80 animate-float-very-slow">
        <div class="absolute inset-0 border-2 border-primary-400/20 rounded-full"></div>
        <div class="absolute inset-8 border border-primary-400/15 rounded-full"></div>
        <div class="absolute inset-16 border border-primary-400/10 rounded-full"></div>
      </div>

      <!-- Bottom right decorative circles -->
      <div class="absolute -bottom-24 -right-24 w-96 h-96 animate-float-very-slow" style="animation-delay: -10s;">
        <div class="absolute inset-0 border-2 border-secondary-400/20 rounded-full"></div>
        <div class="absolute inset-10 border border-secondary-400/15 rounded-full"></div>
        <div class="absolute inset-20 border border-secondary-400/10 rounded-full"></div>
      </div>

      <!-- Subtle connecting lines (horizontal accent) -->
      <svg class="absolute top-20 left-0 w-full h-1 opacity-10" preserveAspectRatio="none">
        <defs>
          <linearGradient id="process-line-grad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" style="stop-color:transparent" />
            <stop offset="20%" style="stop-color:rgb(var(--c-primary-500))" />
            <stop offset="50%" style="stop-color:rgb(var(--c-secondary-500))" />
            <stop offset="80%" style="stop-color:rgb(var(--c-primary-500))" />
            <stop offset="100%" style="stop-color:transparent" />
          </linearGradient>
        </defs>
        <line x1="0" y1="0" x2="100%" y2="0" stroke="url(#process-line-grad)" stroke-width="2" stroke-dasharray="8 8"/>
      </svg>
      <svg class="absolute bottom-20 left-0 w-full h-1 opacity-10" preserveAspectRatio="none">
        <line x1="0" y1="0" x2="100%" y2="0" stroke="url(#process-line-grad)" stroke-width="2" stroke-dasharray="8 8"/>
      </svg>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <div class="inline-flex items-center px-4 py-2 bg-primary-900/50 border-l-4 border-primary-500 rounded-r-lg mb-6">
          <span class="text-sm font-bold text-primary-300 uppercase tracking-wider">The Solution</span>
        </div>
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-4">
          {process.heading}
        </h2>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto">
          {process.subtitle}
        </p>
      </div>

      <!-- Connected Steps Container -->
      <div class="relative max-w-5xl mx-auto">
        <!-- Continuous connecting line (desktop) -->
        <div class="hidden md:block absolute top-10 left-[calc(16.67%-10px)] right-[calc(16.67%-10px)] h-1">
          <div class="absolute inset-0 bg-gray-700 rounded-full"></div>
          <div class="absolute inset-0 bg-gradient-to-r from-primary-500 via-primary-400 to-primary-500 rounded-full process-line-animate"></div>
        </div>

        <div class="grid md:grid-cols-3 gap-8 md:gap-4">
          <!-- Step 1 -->
          <div class="relative flex flex-col items-center text-center group">
            <!-- Mobile connector line (vertical) -->
            <div class="md:hidden absolute top-20 left-1/2 -translate-x-1/2 w-1 h-[calc(100%+2rem)] bg-gradient-to-b from-primary-500 to-primary-400 rounded-full"></div>

            <div class="relative z-10">
              <!-- Outer ring -->
              <div class="absolute -inset-2 bg-gradient-to-br from-primary-400/30 to-primary-600/30 rounded-full blur-sm group-hover:from-primary-400/40 group-hover:to-primary-600/40 transition-all duration-300"></div>
              <!-- Number circle -->
              <div class="relative w-20 h-20 bg-gradient-to-br from-secondary-300 to-primary-500 rounded-full shadow-xl flex items-center justify-center ring-4 ring-gray-900 step-badge">
                <span class="text-3xl font-bold text-white">1</span>
              </div>
            </div>

            <div class="mt-8 bg-gradient-to-br from-gray-800 to-gray-900 rounded-2xl p-6 shadow-lg border border-gray-700 group-hover:shadow-large group-hover:-translate-y-1 transition-all duration-300 relative z-0">
              <h3 class="text-xl font-bold text-white mb-3">{process.steps[0].title}</h3>
              <p class="text-gray-300">{process.steps[0].body}</p>
            </div>
          </div>

          <!-- Step 2 -->
          <div class="relative flex flex-col items-center text-center group md:mt-0 mt-8">
            <!-- Mobile connector line (vertical) -->
            <div class="md:hidden absolute top-20 left-1/2 -translate-x-1/2 w-1 h-[calc(100%+2rem)] bg-gradient-to-b from-primary-400 to-primary-500 rounded-full"></div>

            <div class="relative z-10">
              <!-- Rotating dashed circle -->
              <svg class="absolute -inset-8 w-36 h-36 animate-rotate-slow" viewBox="0 0 100 100">
                <circle cx="50" cy="50" r="48" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="6 6" class="text-primary-400/25" />
              </svg>
              <!-- Outer ring -->
              <div class="absolute -inset-2 bg-gradient-to-br from-primary-500/30 to-primary-600/30 rounded-full blur-sm group-hover:from-primary-500/40 group-hover:to-primary-600/40 transition-all duration-300"></div>
              <!-- Number circle -->
              <div class="relative w-20 h-20 bg-gradient-to-br from-primary-500 to-primary-600 rounded-full shadow-xl flex items-center justify-center ring-4 ring-gray-900 step-badge">
                <span class="text-3xl font-bold text-white">2</span>
              </div>
            </div>

            <div class="mt-8 bg-gradient-to-br from-gray-800 to-gray-900 rounded-2xl p-6 shadow-lg border border-gray-700 group-hover:shadow-large group-hover:-translate-y-1 transition-all duration-300 relative z-0">
              <h3 class="text-xl font-bold text-white mb-3">{process.steps[1].title}</h3>
              <p class="text-gray-300">{process.steps[1].body}</p>
            </div>
          </div>

          <!-- Step 3 -->
          <div class="relative flex flex-col items-center text-center group md:mt-0 mt-8">
            <div class="relative z-10">
              <!-- Outer ring -->
              <div class="absolute -inset-2 bg-gradient-to-br from-primary-600/30 to-primary-800/30 rounded-full blur-sm group-hover:from-primary-600/40 group-hover:to-primary-800/40 transition-all duration-300"></div>
              <!-- Number circle -->
              <div class="relative w-20 h-20 bg-gradient-to-br from-primary-700 to-secondary-700 rounded-full shadow-xl flex items-center justify-center ring-4 ring-gray-900 step-badge">
                <span class="text-3xl font-bold text-white">3</span>
              </div>
            </div>

            <div class="mt-8 bg-gradient-to-br from-gray-800 to-gray-900 rounded-2xl p-6 shadow-lg border border-gray-700 group-hover:shadow-large group-hover:-translate-y-1 transition-all duration-300">
              <h3 class="text-xl font-bold text-white mb-3">{process.steps[2].title}</h3>
              <p class="text-gray-300">{process.steps[2].body}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- CTA -->
      <div class="text-center mt-16">
        <a href="/#book-a-call"
          data-booking-modal-open
          class="btn btn-primary btn-lg shadow-xl">
          Start Your Project Today
          <ArrowRight class="w-5 h-5" />
        </a>
      </div>
    </div>
  </section>


  <!-- Client Logos Section. A market with no clients yet (finance) renders nothing
       rather than an empty strip or another market's logos. -->
  {clientLogos.length > 0 && (
    <section class="py-12 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <p class="text-center text-sm font-semibold text-gray-600 uppercase tracking-wider mb-8">
          {clientLogosLabel}
        </p>
      </div>

      <div class="logo-marquee-container relative overflow-hidden w-full">
        <div class="absolute left-0 top-0 bottom-0 w-16 md:w-32 bg-gradient-to-r from-white via-white/80 to-transparent z-10 pointer-events-none"></div>
        <div class="absolute right-0 top-0 bottom-0 w-16 md:w-32 bg-gradient-to-l from-white via-white/80 to-transparent z-10 pointer-events-none"></div>

        <div class="logo-marquee-track flex">
          {[false, true].map((isDuplicate) => (
            <div
              class="logo-marquee-content flex items-center gap-8 md:gap-16 px-4 md:px-8"
              aria-hidden={isDuplicate ? 'true' : undefined}
            >
              {clientLogos.map((logo) => (
                <a
                  href={logo.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="brand-logo flex-shrink-0"
                  tabindex={isDuplicate ? -1 : undefined}
                >
                  <img src={logo.src} alt={logo.name} loading="lazy" />
                </a>
              ))}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Six-Part Promise Section -->
  <section class="py-20 md:py-28 bg-gradient-to-b from-white to-gray-200 relative overflow-hidden">
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
          <span class="animated-gradient-text">{features.heading.highlight}</span>{features.heading.trail}
        </h2>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          {features.subtitle}
        </p>
      </div>

      <!-- Stripe-style feature table. Six cells in two rows of three; the icons are
           fixed, the words come from the market. -->
      <div class="features-table relative">
        {[features.items.slice(0, 3), features.items.slice(3, 6)].map((row, rowIndex) => (
          <div class="grid grid-cols-1 md:grid-cols-3">
            {row.map((feature, columnIndex) => {
              const Icon = featureIcons[rowIndex * 3 + columnIndex];
              return (
                <div class="feature-cell group">
                  <div class="w-11 h-11 rounded-xl flex items-center justify-center mb-5 bg-gradient-to-br from-primary-600 to-primary-700 shadow-md ring-1 ring-white/10 transition-transform duration-300 group-hover:-translate-y-0.5">
                    <Icon class="w-5 h-5 text-white" />
                  </div>
                  <h3 class="text-base font-semibold text-gray-900 mb-2">{feature.title}</h3>
                  <p class="text-gray-500 text-sm leading-relaxed">{feature.body}</p>
                </div>
              );
            })}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Unlimited Updates Feature Section -->
  <section class="py-20 md:py-32 bg-gradient-to-b from-ink-900 via-ink-950 to-black relative overflow-hidden">
    <!-- Background decoration -->
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-primary-600 rounded-full blur-3xl"></div>
      <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-secondary-500 rounded-full blur-3xl"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <!-- Left: Big Statement -->
        <div>
          <div class="inline-flex items-center px-4 py-2 bg-primary-900/50 border-l-4 border-primary-500 rounded-r-lg mb-6">
            <span class="text-sm font-bold text-primary-300 uppercase tracking-wider">Never Pay Per Change</span>
          </div>

          <h2 class="text-5xl md:text-6xl lg:text-7xl font-bold mb-6 leading-tight">
            <span class="animated-gradient-text">Unlimited</span>
            <br/>
            <span class="text-white">Updates</span>
            <br/>
            <span class="text-white">Forever</span>
          </h2>

          <p class="text-xl text-gray-300 leading-relaxed mb-8">
            We take the pain out of managing your online presence. Make changes anytime, as many times as you want—no hourly rates, no surprise bills, no limits.
          </p>

          <div class="space-y-4">
            <div class="flex items-start gap-4">
              <svg class="flex-shrink-0 w-8 h-8 mt-1" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
