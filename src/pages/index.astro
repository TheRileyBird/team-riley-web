<style>
  /* Logo Marquee Styles */
  .logo-marquee-container {
    position: relative;
  }

  .logo-marquee-track {
    display: flex;
    width: fit-content;
    animation: marquee 40s linear infinite;
  }

  .logo-marquee-container:hover .logo-marquee-track {
    animation-play-state: paused;
  }

  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  /* Brand logo grayscale and hover effects */
  .brand-logo {
    filter: grayscale(100%) brightness(0.7);
    opacity: 0.6;
    transition: all 0.3s ease;
    display: inline-block;
    max-width: 200px;
  }

  .brand-logo:hover {
    filter: grayscale(0%) brightness(1);
    opacity: 1;
    transform: scale(1.05);
  }

  .brand-logo img {
    display: block;
    height: 48px;
    width: auto;
    max-width: 200px;
    object-fit: contain;
  }

  .brand-logo svg {
    transition: all 0.3s ease;
  }

  .animated-gradient-text {
    background: linear-gradient(90deg, #1e40af, #0891b2, #8b5cf6, #1e40af);
    background-size: 300% 100%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: gradient-shift 8s ease infinite;
  }

  .animated-gradient-bg {
    background: linear-gradient(90deg, #1e40af, #0891b2, #8b5cf6, #1e40af);
    background-size: 300% 100%;
    animation: gradient-shift 8s ease infinite;
  }

  @keyframes gradient-shift {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }

  /* EKG Monitor Animation */
  .ekg-line {
    stroke-dasharray: 1200;
    stroke-dashoffset: 1200;
    animation: ekg-pulse 10s linear infinite;
  }

  @keyframes ekg-pulse {
    0% {
      stroke-dashoffset: 1200;
    }
    50% {
      stroke-dashoffset: 0;
    }
    100% {
      stroke-dashoffset: -1200;
    }
  }

  /* Fade mask animation for trailing effect */
  .ekg-fade-mask {
    animation: ekg-fade 10s linear infinite;
  }

  @keyframes ekg-fade {
    0% {
      opacity: 0;
    }
    50% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  /* Floating animations */
  @keyframes float {
    0%, 100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-20px) rotate(5deg);
    }
  }

  .animate-float-slow {
    animation: float 12s ease-in-out infinite;
  }

  .animate-float-slower {
    animation: float 15s ease-in-out infinite;
  }

  .animate-float-very-slow {
    animation: float 40s ease-in-out infinite;
  }

  /* Rotating animation for dashed circle */
  @keyframes rotate-slow {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  .animate-rotate-slow {
    animation: rotate-slow 30s linear infinite;
  }

  /* Shimmer effect for pricing cards */
  .shimmer-overlay {
    background: linear-gradient(
      -45deg,
      transparent 0%,
      transparent 45%,
      rgba(255, 255, 255, 0.06) 50%,
      transparent 55%,
      transparent 100%
    );
    background-size: 400% 400%;
    animation: shimmer-diagonal 12s linear infinite;
  }

  .shimmer-overlay-gold {
    background: linear-gradient(
      -45deg,
      transparent 0%,
      transparent 45%,
      rgba(255, 255, 255, 0.12) 50%,
      transparent 55%,
      transparent 100%
    );
    background-size: 400% 400%;
    animation: shimmer-diagonal 12s linear infinite;
  }

  @keyframes shimmer-diagonal {
    0% {
      background-position: 100% 100%;
    }
    100% {
      background-position: 0% 0%;
    }
  }

  .shimmer-overlay-footer {
    background: linear-gradient(
      -45deg,
      transparent 0%,
      transparent 45%,
      rgba(255, 255, 255, 0.12) 50%,
      transparent 55%,
      transparent 100%
    );
    background-size: 400% 400%;
    animation: shimmer-diagonal 12s linear infinite;
  }

  #infinity-outline {
    stroke-dasharray: 90px, 152.78px;
    stroke-dashoffset: 0;
    animation: infinity-draw 7s linear infinite;
  }

  @keyframes infinity-draw {
    0% {
      stroke-dashoffset: 0;
    }
    100% {
      stroke-dashoffset: -242.78px;
    }
  }

  /* Stripe-style feature table */
  .features-table {
    position: relative;
    overflow: hidden;
  }

  .features-table > .grid {
    position: relative;
  }

  .feature-cell {
    position: relative;
    padding: 3rem 2.5rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .feature-cell:hover {
    background-color: rgba(248, 250, 252, 0.6);
  }

  /* Horizontal dashed line between rows - fading to white at edges */
  .features-table > .grid:first-child::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: repeating-linear-gradient(
      90deg,
      rgba(203, 213, 225, 0.5) 0px,
      rgba(203, 213, 225, 0.5) 8px,
      transparent 8px,
      transparent 16px
    );
    mask-image: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 1) 12%,
      rgba(255, 255, 255, 1) 88%,
      rgba(255, 255, 255, 0) 100%
    );
    -webkit-mask-image: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 1) 12%,
      rgba(255, 255, 255, 1) 88%,
      rgba(255, 255, 255, 0) 100%
    );
  }

  /* Vertical dashed lines between columns - fading at top/bottom */
  @media (min-width: 768px) {
    .feature-cell:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      right: 0;
      width: 1px;
      background: repeating-linear-gradient(
        180deg,
        rgba(203, 213, 225, 0.5) 0px,
        rgba(203, 213, 225, 0.5) 8px,
        transparent 8px,
        transparent 16px
      );
      mask-image: linear-gradient(
        180deg,
        rgba(255, 255, 255, 0) 0%,
        rgba(255, 255, 255, 1) 12%,
        rgba(255, 255, 255, 1) 88%,
        rgba(255, 255, 255, 0) 100%
      );
      -webkit-mask-image: linear-gradient(
        180deg,
        rgba(255, 255, 255, 0) 0%,
        rgba(255, 255, 255, 1) 12%,
        rgba(255, 255, 255, 1) 88%,
        rgba(255, 255, 255, 0) 100%
      );
    }

    /* Remove right border on last column items */
    .feature-cell:nth-child(3n)::after {
      display: none;
    }
  }

  /* Process line animation */
  .process-line-animate {
    background-size: 200% 100%;
    animation: process-flow 3s ease-in-out infinite;
  }

  @keyframes process-flow {
    0%, 100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  /* Step badge hover scale animation */
  .step-badge {
    transition: transform 500ms ease, box-shadow 0.3s ease;
  }

  .group:hover .step-badge {
    transform: scale(1.1);
  }

  /* Button Components */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-weight: 600;
    transition: all 0.2s ease;
    cursor: pointer;
    white-space: nowrap;
  }

  /* Primary Button - Dark blue gradient */
  .btn-primary {
    background: linear-gradient(to right, #1e40af, #1e3a8a);
    color: white;
    border-radius: 0.75rem;
    padding: 0.875rem 2rem;
    font-size: 1rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }

  .btn-primary:hover {
    opacity: 0.9;
  }

  /* Secondary Button - White with border */
  .btn-secondary {
    background: white;
    color: #1e40af;
    border: 2px solid #cbd5e1;
    border-radius: 0.75rem;
    padding: 0.875rem 2rem;
