---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Footer from '../components/Footer.astro';
import { ExternalLink, Smartphone, Zap, Globe, Stethoscope, Dumbbell, Heart, Sparkles } from 'lucide-astro';
---

<BaseLayout title="Portfolio - Team Riley" description="View our portfolio of health and wellness websites designed to convert visitors into clients">
  <Navigation />

  <PageHeader
    badge="Our Work"
    title='<span class="animated-gradient-text">Beautiful Websites</span> <span class="text-gray-900">That Drive Results</span>'
    subtitle="Explore our portfolio of custom-designed websites built for health and wellness businesses like yours."
    primaryCTA={{ text: 'Get Started', href: '#get-started' }}
    secondaryCTA={{ text: 'View Pricing', href: '/pricing' }}
  />

  <!-- Category Navigation -->
  <section class="py-8 bg-white border-b border-gray-200 sticky top-16 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap justify-center gap-4">
        <a href="#medical" class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary-50 text-primary-700 rounded-full font-medium hover:bg-primary-100 transition-colors">
          <Stethoscope class="w-4 h-4" />
          Medical & Clinical
        </a>
        <a href="#physical" class="inline-flex items-center gap-2 px-5 py-2.5 bg-secondary-300/20 text-secondary-700 rounded-full font-medium hover:bg-secondary-300/30 transition-colors">
          <Dumbbell class="w-4 h-4" />
          Physical Wellness
        </a>
        <a href="#holistic" class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary-50 text-primary-700 rounded-full font-medium hover:bg-primary-100 transition-colors">
          <Sparkles class="w-4 h-4" />
          Holistic & Emotional
        </a>
      </div>
    </div>
  </section>

  <!-- Medical & Clinical Health Section -->
  <section id="medical" class="py-20 md:py-28 bg-white scroll-mt-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-4 mb-4">
        <div class="w-14 h-14 bg-gradient-to-br from-primary-500 to-primary-600 rounded-2xl flex items-center justify-center">
          <Stethoscope class="w-7 h-7 text-white" />
        </div>
        <div>
          <span class="inline-block px-3 py-1 bg-primary-100 text-primary-700 text-sm font-semibold rounded-full mb-1">Medical & Clinical</span>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900">Healthcare Providers</h2>
        </div>
      </div>
      <p class="text-lg text-gray-600 mb-12 max-w-3xl">Websites designed for medical clinics, practices, and pharmacies with HIPAA compliance, patient portals, and secure booking systems.</p>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Life2Health -->
        <div class="group relative overflow-hidden rounded-2xl border border-gray-200 hover:border-primary-400 transition-all duration-300 hover:shadow-2xl">
          <div class="relative overflow-hidden aspect-video">
            <img
              src="https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?w=800&q=80"
              alt="Health clinic website"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900/80 via-gray-900/40 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <span class="inline-block px-3 py-1 bg-primary-600 text-white text-sm font-semibold rounded-full mb-3">Medical Clinic</span>
              <h3 class="text-2xl font-bold text-white mb-2">Life2Health</h3>
            </div>
          </div>
          <div class="p-6 bg-white">
            <p class="text-gray-700 leading-relaxed mb-4">
              A modern, patient-focused website featuring online appointment scheduling, insurance information, and provider profiles.
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="px-3 py-1 bg-primary-50 text-primary-700 text-sm rounded-full">Custom Design</span>
              <span class="px-3 py-1 bg-primary-50 text-primary-700 text-sm rounded-full">SEO Optimized</span>
              <span class="px-3 py-1 bg-primary-50 text-primary-700 text-sm rounded-full">Mobile First</span>
            </div>
            <a href="https://life2health.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-primary-600 font-semibold hover:text-primary-700 transition-colors">
              View Live Site
              <ExternalLink class="w-4 h-4" />
            </a>
          </div>
        </div>

        <!-- DSM MD -->
        <div class="group relative overflow-hidden rounded-2xl border border-gray-200 hover:border-primary-400 transition-all duration-300 hover:shadow-2xl">
          <div class="relative overflow-hidden aspect-video">
            <img
              src="https://images.unsplash.com/photo-1631815589968-fdb09a223b1e?w=800&q=80"
              alt="Medical practice website"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900/80 via-gray-900/40 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <span class="inline-block px-3 py-1 bg-primary-600 text-white text-sm font-semibold rounded-full mb-3">Medical Practice</span>
              <h3 class="text-2xl font-bold text-white mb-2">DSM MD</h3>
            </div>
          </div>
          <div class="p-6 bg-white">
            <p class="text-gray-700 leading-relaxed mb-4">
              A professional medical practice website with patient portal integration, educational resources, and secure messaging.
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="px-3 py-1 bg-primary-50 text-primary-700 text-sm rounded-full">Patient Portal</span>
              <span class="px-3 py-1 bg-primary-50 text-primary-700 text-sm rounded-full">HIPAA Compliant</span>
              <span class="px-3 py-1 bg-primary-50 text-primary-700 text-sm rounded-full">Secure Forms</span>
            </div>
            <a href="https://dsmmd.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-primary-600 font-semibold hover:text-primary-700 transition-colors">
              View Live Site
              <ExternalLink class="w-4 h-4" />
            </a>
          </div>
        </div>

        <!-- Galleria Medical Pharmacy -->
        <div class="group relative overflow-hidden rounded-2xl border border-gray-200 hover:border-primary-400 transition-all duration-300 hover:shadow-2xl">
          <div class="relative overflow-hidden aspect-video">
            <img
              src="https://images.unsplash.com/photo-1587825140708-dfaf72ae4b04?w=800&q=80"
              alt="Pharmacy website"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900/80 via-gray-900/40 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <span class="inline-block px-3 py-1 bg-primary-600 text-white text-sm font-semibold rounded-full mb-3">Pharmacy</span>
              <h3 class="text-2xl font-bold text-white mb-2">Galleria Medical Pharmacy</h3>
            </div>
          </div>
          <div class="p-6 bg-white">
            <p class="text-gray-700 leading-relaxed mb-4">
              A comprehensive pharmacy website with prescription transfer capabilities, medication information, and delivery services.
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="px-3 py-1 bg-primary-50 text-primary-700 text-sm rounded-full">Rx Transfer</span>
              <span class="px-3 py-1 bg-primary-50 text-primary-700 text-sm rounded-full">Drug Database</span>
              <span class="px-3 py-1 bg-primary-50 text-primary-700 text-sm rounded-full">Delivery</span>
            </div>
            <a href="#" class="inline-flex items-center gap-2 text-primary-600 font-semibold hover:text-primary-700 transition-colors">
              View Live Site
              <ExternalLink class="w-4 h-4" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Physical Wellness Section -->
  <section id="physical" class="py-20 md:py-28 bg-gradient-to-b from-secondary-300/10 to-white scroll-mt-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-4 mb-4">
        <div class="w-14 h-14 bg-gradient-to-br from-secondary-500 to-secondary-600 rounded-2xl flex items-center justify-center">
          <Dumbbell class="w-7 h-7 text-white" />
        </div>
        <div>
          <span class="inline-block px-3 py-1 bg-secondary-300/20 text-secondary-700 text-sm font-semibold rounded-full mb-1">Physical Wellness</span>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900">Fitness & Body Health</h2>
        </div>
      </div>
      <p class="text-lg text-gray-600 mb-12 max-w-3xl">Websites for fitness centers, IV therapy clinics, and physical wellness providers that energize and convert.</p>

      <div class="grid md:grid-cols-2 gap-8">
        <!-- LoveMore Wellness -->
        <div class="group relative overflow-hidden rounded-2xl border border-gray-200 hover:border-secondary-400 transition-all duration-300 hover:shadow-2xl">
          <div class="relative overflow-hidden aspect-video">
            <img
              src="https://images.unsplash.com/photo-1540555700478-4be289fbecef?w=800&q=80"
              alt="Fitness center website"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900/80 via-gray-900/40 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <span class="inline-block px-3 py-1 bg-secondary-500 text-white text-sm font-semibold rounded-full mb-3">Fitness</span>
              <h3 class="text-2xl font-bold text-white mb-2">LoveMore Wellness</h3>
            </div>
          </div>
          <div class="p-6 bg-white">
            <p class="text-gray-700 leading-relaxed mb-4">
              An energetic fitness center website with class schedules, membership options, trainer profiles, and online sign-ups.
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="px-3 py-1 bg-secondary-300/20 text-secondary-700 text-sm rounded-full">Class Schedules</span>
              <span class="px-3 py-1 bg-secondary-300/20 text-secondary-700 text-sm rounded-full">Memberships</span>
              <span class="px-3 py-1 bg-secondary-300/20 text-secondary-700 text-sm rounded-full">Video Content</span>
            </div>
            <a href="#" class="inline-flex items-center gap-2 text-secondary-600 font-semibold hover:text-secondary-700 transition-colors">
              View Live Site
              <ExternalLink class="w-4 h-4" />
            </a>
          </div>
        </div>

        <!-- SupportIV -->
        <div class="group relative overflow-hidden rounded-2xl border border-gray-200 hover:border-secondary-400 transition-all duration-300 hover:shadow-2xl">
          <div class="relative overflow-hidden aspect-video">
            <img
              src="https://images.unsplash.com/photo-1576091160550-2173dba999ef?w=800&q=80"
              alt="IV therapy clinic website"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900/80 via-gray-900/40 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <span class="inline-block px-3 py-1 bg-secondary-500 text-white text-sm font-semibold rounded-full mb-3">IV Therapy</span>
              <h3 class="text-2xl font-bold text-white mb-2">SupportIV</h3>
            </div>
          </div>
          <div class="p-6 bg-white">
            <p class="text-gray-700 leading-relaxed mb-4">
              A vibrant, energetic website highlighting IV therapy treatments with detailed service pages and before/after testimonials.
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="px-3 py-1 bg-secondary-300/20 text-secondary-700 text-sm rounded-full">Service Catalog</span>
              <span class="px-3 py-1 bg-secondary-300/20 text-secondary-700 text-sm rounded-full">Testimonials</span>
              <span class="px-3 py-1 bg-secondary-300/20 text-secondary-700 text-sm rounded-full">Lead Generation</span>
            </div>
            <a href="#" class="inline-flex items-center gap-2 text-secondary-600 font-semibold hover:text-secondary-700 transition-colors">
              View Live Site
              <ExternalLink class="w-4 h-4" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Holistic & Emotional Wellness Section -->
  <section id="holistic" class="py-20 md:py-28 bg-gradient-to-b from-primary-50/50 to-white scroll-mt-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-4 mb-4">
        <div class="w-14 h-14 bg-gradient-to-br from-primary-500 to-primary-600 rounded-2xl flex items-center justify-center">
          <Sparkles class="w-7 h-7 text-white" />
        </div>
        <div>
          <span class="inline-block px-3 py-1 bg-primary-100 text-primary-700 text-sm font-semibold rounded-full mb-1">Holistic & Emotional</span>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900">Mind, Body & Spirit</h2>
        </div>
      </div>
      <p class="text-lg text-gray-600 mb-12 max-w-3xl">Calming, thoughtfully designed websites for wellness centers, spas, and holistic health practitioners.</p>

      <div class="grid md:grid-cols-2 lg:grid-cols-1 max-w-2xl mx-auto gap-8">
        <!-- Riley Retreat -->
        <div class="group relative overflow-hidden rounded-2xl border border-gray-200 hover:border-primary-400 transition-all duration-300 hover:shadow-2xl">
          <div class="relative overflow-hidden aspect-video">
            <img
              src="https://images.unsplash.com/photo-1559136555-9303baea8ebd?w=800&q=80"
              alt="Wellness center website"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900/80 via-gray-900/40 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <span class="inline-block px-3 py-1 bg-primary-500 text-white text-sm font-semibold rounded-full mb-3">Wellness Center</span>
              <h3 class="text-2xl font-bold text-white mb-2">Riley Retreat</h3>
            </div>
          </div>
          <div class="p-6 bg-white">
            <p class="text-gray-700 leading-relaxed mb-4">
              A calming, spa-like website showcasing wellness services, treatment packages, and an easy-to-use booking system.
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="px-3 py-1 bg-primary-50 text-primary-700 text-sm rounded-full">Booking System</span>
              <span class="px-3 py-1 bg-primary-50 text-primary-700 text-sm rounded-full">E-commerce</span>
              <span class="px-3 py-1 bg-primary-50 text-primary-700 text-sm rounded-full">Brand Identity</span>
            </div>
            <a href="#" class="inline-flex items-center gap-2 text-primary-600 font-semibold hover:text-primary-700 transition-colors">
              View Live Site
              <ExternalLink class="w-4 h-4" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Process Highlight -->
  <section class="py-20 md:py-28 bg-gradient-to-b from-gray-100 to-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader
        badge="Our Process"
        title="Every Project Gets The Same Care"
        subtitle="Here's what you can expect when you work with us"
      />

      <div class="grid md:grid-cols-3 gap-8 mb-12">
        <div class="text-center p-8 bg-white rounded-2xl border border-gray-200 hover:shadow-xl transition-all duration-300">
          <div class="w-16 h-16 bg-gradient-to-br from-primary-600 to-primary-700 rounded-full flex items-center justify-center mx-auto mb-6">
            <Smartphone class="w-8 h-8 text-white" />
          </div>
          <h4 class="text-xl font-bold text-gray-900 mb-3">Mobile-First Design</h4>
          <p class="text-gray-700">Every site is designed for mobile devices first, ensuring the best experience for all visitors.</p>
        </div>

        <div class="text-center p-8 bg-white rounded-2xl border border-gray-200 hover:shadow-xl transition-all duration-300">
          <div class="w-16 h-16 bg-gradient-to-br from-accent-400 to-accent-500 rounded-full flex items-center justify-center mx-auto mb-6">
            <Zap class="w-8 h-8 text-white" />
          </div>
          <h4 class="text-xl font-bold text-gray-900 mb-3">Lightning Fast</h4>
          <p class="text-gray-700">Optimized performance means faster loading times, better SEO, and happier visitors.</p>
        </div>

        <div class="text-center p-8 bg-white rounded-2xl border border-gray-200 hover:shadow-xl transition-all duration-300">
          <div class="w-16 h-16 bg-gradient-to-br from-secondary-500 to-secondary-600 rounded-full flex items-center justify-center mx-auto mb-6">
            <Globe class="w-8 h-8 text-white" />
          </div>
          <h4 class="text-xl font-bold text-gray-900 mb-3">SEO Built-In</h4>
          <p class="text-gray-700">Search engine optimization is baked into every page, helping you rank higher in search results.</p>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
