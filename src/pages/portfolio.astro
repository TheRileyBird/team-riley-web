<script>
  // Make sticky navigation stop at holistic section
  document.addEventListener('DOMContentLoaded', () => {
    const nav = document.getElementById('category-nav');
    const holisticSection = document.getElementById('holistic');

    if (!nav || !holisticSection) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          // When holistic section enters viewport from top, remove sticky
          if (entry.isIntersecting && entry.boundingClientRect.top < window.innerHeight) {
            nav.classList.remove('md:sticky');
          } else if (!entry.isIntersecting && entry.boundingClientRect.top > 0) {
            // When scrolling back up, restore sticky
            nav.classList.add('md:sticky');
          }
        });
      },
      {
        // Trigger when the top of holistic section reaches the bottom of the sticky nav
        rootMargin: '-80px 0px 0px 0px',
        threshold: 0
      }
    );

    observer.observe(holisticSection);
  });
</script>
