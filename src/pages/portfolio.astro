---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import PageHeader from '../components/PageHeader.astro';
import ClientReviewMessages from '../components/ClientReviewMessages.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Footer from '../components/Footer.astro';
import { ExternalLink, Smartphone, Zap, Globe, Stethoscope, Dumbbell, Sparkles } from '@lucide/astro';
import { Image } from 'astro:assets';
import dsmMdOffice from '../assets/images/dsm-md-office.jpg';
import sleepLab from '../assets/images/sleep-lab.jpg';
import pharmacyPills from '../assets/images/pharmacy-pills.jpg';
import virtualExercise from '../assets/images/virtual-exercise.jpg';
import supportivTreatment from '../assets/images/supportiv-treatment.jpg';
import lovemoreYoga from '../assets/images/lovemore-yoga.jpg';
import midwifeBirth from '../assets/images/midwife-birth.jpg';
import manHiking from '../assets/images/man-hiking.jpg';
import domLukeCoaching from '../assets/images/dom-luke-coaching.jpg';

const clientReviews = [
  {
    client: 'Client Review',
    text: 'You are life-changing.',
    side: 'right',
    top: '23rem',
  },
  {
    client: 'Client Review',
    text: 'Thank you for making this process so easy.',
    side: 'left',
    top: '47rem',
  },
  {
    client: 'DSM-MD',
    text: 'The new site finally explains what we do in a way patients can understand right away.',
    side: 'right',
    top: '76rem',
  },
  {
    client: 'Sleep Labs',
    text: 'Our booking flow feels cleaner, faster, and much easier for patients to use.',
    side: 'left',
    top: '107rem',
  },
  {
    client: 'Galleria Medical Pharmacy',
    text: 'We look more professional online, and the whole process felt organized from day one.',
    side: 'right',
    top: '134rem',
  },
  {
    client: 'Lovitt Life',
    text: 'You took a complicated membership offer and made it feel simple for our clients.',
    side: 'left',
    top: '166rem',
  },
  {
    client: 'SupportIV',
    text: 'The website finally matches the quality of care our team provides in person.',
    side: 'right',
    top: '194rem',
  },
  {
    client: 'Love More Yoga',
    text: 'It feels calm, polished, and completely aligned with the experience we want people to have.',
    side: 'left',
    top: '226rem',
  },
  {
    client: 'Grace Midwifery Collective',
    text: 'You listened deeply and turned our work into something families can trust immediately.',
    side: 'right',
    top: '258rem',
  },
  {
    client: 'Masculine Confidence Framework',
    text: 'The message is sharper, the design is stronger, and the whole brand feels elevated.',
    side: 'left',
    top: '290rem',
  },
  {
    client: 'Dom Luke',
    text: 'This is the first time my website has felt like it actually represents my work.',
    side: 'right',
    top: '324rem',
  },
  {
    client: 'Wellness Practice Client',
    text: 'I thought this would be overwhelming, but you made every step clear and manageable.',
    side: 'left',
    top: '356rem',
  },
];
---

<BaseLayout title="Portfolio - Team Riley" description="View our portfolio of health and wellness websites designed to convert visitors into clients">
  <Navigation />

  <main class="relative overflow-hidden">
    <ClientReviewMessages reviews={clientReviews} />

    <PageHeader
      badge="Our Work"
      title='<span class="animated-gradient-text">Healthy Websites</span> <span class="text-gray-900"><br class="hidden lg:block">That Drive Results</span>'
      subtitle="Explore our portfolio of custom-designed websites built for health and wellness businesses like yours."
    />

  <!-- Category Navigation -->
  <section id="category-nav" class="py-8 bg-white md:sticky md:top-16 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap justify-center gap-4">
        <a href="#medical" class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary-50 text-primary-700 rounded-full font-medium hover:bg-primary-100 transition-colors">
          <Stethoscope class="w-4 h-4" />
          Medical & Clinical
        </a>
        <a href="#physical" class="inline-flex items-center gap-2 px-5 py-2.5 bg-secondary-300/20 text-secondary-700 rounded-full font-medium hover:bg-secondary-300/30 transition-colors">
          <Dumbbell class="w-4 h-4" />
          Physical Wellness
        </a>
        <a href="#holistic" class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary-50 text-primary-700 rounded-full font-medium hover:bg-primary-100 transition-colors">
          <Sparkles class="w-4 h-4" />
          Holistic & Emotional
        </a>
      </div>
    </div>
  </section>

  <!-- Medical & Clinical Health Section -->
  <section id="medical" class="pb-20 md:pb-28 bg-white scroll-mt-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-4 mb-4">
        <div class="w-14 h-14 bg-gradient-to-br from-primary-500 to-primary-600 rounded-2xl flex items-center justify-center">
          <Stethoscope class="w-7 h-7 text-white" />
        </div>
        <div>
          <span class="inline-block px-3 py-1 bg-primary-100 text-primary-700 text-sm font-semibold rounded-full mb-1">Medical & Clinical</span>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900">Healthcare Providers</h2>
        </div>
      </div>
      <p class="text-lg text-gray-600 mb-12 max-w-3xl">Websites designed for medical clinics, practices, and pharmacies with HIPAA compliance, patient portals, and secure booking systems.</p>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- DSM MD -->
        <div class="group relative overflow-hidden rounded-2xl border border-gray-200 hover:border-primary-400 transition-all duration-300 hover:shadow-2xl">
          <div class="relative overflow-hidden aspect-video">
            <Image
              src={dsmMdOffice}
              alt="Dental sleep medicine practice"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900/80 via-gray-900/40 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <span class="inline-block px-3 py-1 bg-primary-600 text-white text-sm font-semibold rounded-full mb-3">Dental Sleep Medicine</span>
              <h3 class="text-2xl font-bold text-white mb-2">DSM-MD</h3>
            </div>
          </div>
          <div class="p-6 bg-white">
            <p class="text-gray-700 leading-relaxed mb-4">
              Specialized dental sleep medicine website focused on diagnosing and treating sleep-related breathing disorders with custom oral appliances.
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="px-3 py-1 bg-primary-50 text-primary-700 text-sm rounded-full">Patient Education</span>
              <span class="px-3 py-1 bg-primary-50 text-primary-700 text-sm rounded-full">Online Booking</span>
              <span class="px-3 py-1 bg-primary-50 text-primary-700 text-sm rounded-full">Sleep Assessments</span>
            </div>
            <a href="https://dsm-md.com/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-primary-600 font-semibold hover:text-primary-700 transition-colors">
              View Live Site
              <ExternalLink class="w-4 h-4" />
            </a>
          </div>
        </div>

        <!-- Sleep Labs -->
        <div class="group relative overflow-hidden rounded-2xl border border-gray-200 hover:border-primary-400 transition-all duration-300 hover:shadow-2xl">
          <div class="relative overflow-hidden aspect-video">
            <Image
              src={sleepLab}
              alt="Sleep disorders clinic"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900/80 via-gray-900/40 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <span class="inline-block px-3 py-1 bg-primary-600 text-white text-sm font-semibold rounded-full mb-3">Sleep Clinic</span>
              <h3 class="text-2xl font-bold text-white mb-2">Sleep Labs</h3>
            </div>
          </div>
          <div class="p-6 bg-white">
            <p class="text-gray-700 leading-relaxed mb-4">
              Comprehensive sleep disorders clinic website featuring diagnostic services, treatment options, and evidence-based medical solutions.
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="px-3 py-1 bg-primary-50 text-primary-700 text-sm rounded-full">Sleep Studies</span>
              <span class="px-3 py-1 bg-primary-50 text-primary-700 text-sm rounded-full">Medical Solutions</span>
              <span class="px-3 py-1 bg-primary-50 text-primary-700 text-sm rounded-full">Patient Portal</span>
            </div>
            <a href="https://sleeplabs.net/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-primary-600 font-semibold hover:text-primary-700 transition-colors">
              View Live Site
              <ExternalLink class="w-4 h-4" />
            </a>
          </div>
        </div>

        <!-- Galleria Medical Pharmacy -->
        <div class="group relative overflow-hidden rounded-2xl border border-gray-200 hover:border-primary-400 transition-all duration-300 hover:shadow-2xl">
          <div class="relative overflow-hidden aspect-video">
            <Image
              src={pharmacyPills}
              alt="Medical pharmacy"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900/80 via-gray-900/40 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <span class="inline-block px-3 py-1 bg-primary-600 text-white text-sm font-semibold rounded-full mb-3">Pharmacy</span>
              <h3 class="text-2xl font-bold text-white mb-2">Galleria Medical Pharmacy</h3>
            </div>
          </div>
          <div class="p-6 bg-white">
            <p class="text-gray-700 leading-relaxed mb-4">
              A comprehensive pharmacy website with prescription transfer capabilities, medication information, and delivery services.
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="px-3 py-1 bg-primary-50 text-primary-700 text-sm rounded-full">Rx Transfer</span>
              <span class="px-3 py-1 bg-primary-50 text-primary-700 text-sm rounded-full">Drug Database</span>
              <span class="px-3 py-1 bg-primary-50 text-primary-700 text-sm rounded-full">Delivery</span>
            </div>
            <a href="https://galleriamedpharmacy.com/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-primary-600 font-semibold hover:text-primary-700 transition-colors">
              View Live Site
              <ExternalLink class="w-4 h-4" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Physical Wellness Section -->
  <section id="physical" class="py-20 md:py-28 bg-gradient-to-b from-secondary-300/10 to-white scroll-mt-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-4 mb-4">
        <div class="w-14 h-14 bg-gradient-to-br from-secondary-500 to-secondary-600 rounded-2xl flex items-center justify-center">
          <Dumbbell class="w-7 h-7 text-white" />
        </div>
        <div>
          <span class="inline-block px-3 py-1 bg-secondary-300/20 text-secondary-700 text-sm font-semibold rounded-full mb-1">Physical Wellness</span>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900">Fitness & Body Health</h2>
        </div>
      </div>
      <p class="text-lg text-gray-600 mb-12 max-w-3xl">Websites for fitness centers, IV therapy clinics, and physical wellness providers that energize and convert.</p>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Lovitt Life -->
        <div class="group relative overflow-hidden rounded-2xl border border-gray-200 hover:border-secondary-400 transition-all duration-300 hover:shadow-2xl">
          <div class="relative overflow-hidden aspect-video">
            <Image
              src={virtualExercise}
              alt="Virtual exercise program"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900/80 via-gray-900/40 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <span class="inline-block px-3 py-1 bg-secondary-500 text-white text-sm font-semibold rounded-full mb-3">Virtual Fitness</span>
              <h3 class="text-2xl font-bold text-white mb-2">Lovitt Life</h3>
            </div>
          </div>
          <div class="p-6 bg-white">
            <p class="text-gray-700 leading-relaxed mb-4">
              A dynamic virtual exercise platform designed specifically for men, featuring personalized workout programs and online coaching.
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="px-3 py-1 bg-secondary-300/20 text-secondary-700 text-sm rounded-full">Video Training</span>
              <span class="px-3 py-1 bg-secondary-300/20 text-secondary-700 text-sm rounded-full">Membership</span>
              <span class="px-3 py-1 bg-secondary-300/20 text-secondary-700 text-sm rounded-full">Progress Tracking</span>
            </div>
            <a href="https://lovittlife.com/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-secondary-600 font-semibold hover:text-secondary-700 transition-colors">
              View Live Site
              <ExternalLink class="w-4 h-4" />
            </a>
          </div>
        </div>

        <!-- SupportIV -->
        <div class="group relative overflow-hidden rounded-2xl border border-gray-200 hover:border-secondary-400 transition-all duration-300 hover:shadow-2xl">
          <div class="relative overflow-hidden aspect-video">
            <Image
              src={supportivTreatment}
              alt="IV therapy and wellness services"
              class="w-full h-full object-cover object-[50%_15%] group-hover:scale-105 transition-transform duration-300"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900/80 via-gray-900/40 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <span class="inline-block px-3 py-1 bg-secondary-500 text-white text-sm font-semibold rounded-full mb-3">IV Therapy</span>
              <h3 class="text-2xl font-bold text-white mb-2">SupportIV</h3>
            </div>
          </div>
          <div class="p-6 bg-white">
            <p class="text-gray-700 leading-relaxed mb-4">
              IV vitamin therapy and beauty services clinic featuring treatment catalogs, online booking, and wellness packages.
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="px-3 py-1 bg-secondary-300/20 text-secondary-700 text-sm rounded-full">IV Treatments</span>
              <span class="px-3 py-1 bg-secondary-300/20 text-secondary-700 text-sm rounded-full">Beauty Services</span>
              <span class="px-3 py-1 bg-secondary-300/20 text-secondary-700 text-sm rounded-full">Online Booking</span>
            </div>
            <a href="https://supportivwellness.com/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-secondary-600 font-semibold hover:text-secondary-700 transition-colors">
              View Live Site
              <ExternalLink class="w-4 h-4" />
            </a>
          </div>
        </div>

        <!-- Love More Yoga -->
        <div class="group relative overflow-hidden rounded-2xl border border-gray-200 hover:border-secondary-400 transition-all duration-300 hover:shadow-2xl">
          <div class="relative overflow-hidden aspect-video">
            <Image
              src={lovemoreYoga}
              alt="Yoga class and wellness center"
              class="w-full h-full object-cover object-[50%_55%] group-hover:scale-105 transition-transform duration-300"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900/80 via-gray-900/40 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <span class="inline-block px-3 py-1 bg-secondary-500 text-white text-sm font-semibold rounded-full mb-3">Yoga & Wellness</span>
              <h3 class="text-2xl font-bold text-white mb-2">Love More Yoga</h3>
            </div>
          </div>
          <div class="p-6 bg-white">
            <p class="text-gray-700 leading-relaxed mb-4">
              A serene yoga and wellness center website featuring class schedules, instructor profiles, and mindful living resources.
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="px-3 py-1 bg-secondary-300/20 text-secondary-700 text-sm rounded-full">Class Schedules</span>
              <span class="px-3 py-1 bg-secondary-300/20 text-secondary-700 text-sm rounded-full">Memberships</span>
              <span class="px-3 py-1 bg-secondary-300/20 text-secondary-700 text-sm rounded-full">Wellness Blog</span>
            </div>
            <a href="https://lovemoremcc.com/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-secondary-600 font-semibold hover:text-secondary-700 transition-colors">
              View Live Site
              <ExternalLink class="w-4 h-4" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Holistic & Emotional Wellness Section -->
  <section id="holistic" class="py-20 md:py-28 bg-gradient-to-b from-primary-50/50 to-white scroll-mt-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-4 mb-4">
        <div class="w-14 h-14 bg-gradient-to-br from-primary-500 to-primary-600 rounded-2xl flex items-center justify-center">
          <Sparkles class="w-7 h-7 text-white" />
        </div>
        <div>
          <span class="inline-block px-3 py-1 bg-primary-100 text-primary-700 text-sm font-semibold rounded-full mb-1">Holistic & Emotional</span>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900">Mind, Body & Spirit</h2>
        </div>
      </div>
      <p class="text-lg text-gray-600 mb-12 max-w-3xl">Calming, thoughtfully designed websites for wellness coaches, doulas, and holistic health practitioners.</p>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Grace Midwifery Collective -->
        <div class="group relative overflow-hidden rounded-2xl border border-gray-200 hover:border-primary-400 transition-all duration-300 hover:shadow-2xl">
          <div class="relative overflow-hidden aspect-video">
            <Image
              src={midwifeBirth}
              alt="Midwifery and doula services"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900/80 via-gray-900/40 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <span class="inline-block px-3 py-1 bg-primary-500 text-white text-sm font-semibold rounded-full mb-3">Doula Services</span>
              <h3 class="text-2xl font-bold text-white mb-2">Grace Midwifery Collective</h3>
            </div>
          </div>
          <div class="p-6 bg-white">
            <p class="text-gray-700 leading-relaxed mb-4">
              Compassionate doula and midwifery website providing birth support information, service packages, and client testimonials.
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="px-3 py-1 bg-primary-50 text-primary-700 text-sm rounded-full">Birth Support</span>
              <span class="px-3 py-1 bg-primary-50 text-primary-700 text-sm rounded-full">Service Packages</span>
              <span class="px-3 py-1 bg-primary-50 text-primary-700 text-sm rounded-full">Client Stories</span>
            </div>
            <a href="https://gracemidwiferycollective.com/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-primary-600 font-semibold hover:text-primary-700 transition-colors">
              View Live Site
              <ExternalLink class="w-4 h-4" />
            </a>
          </div>
        </div>

        <!-- Masculine Confidence Framework -->
        <div class="group relative overflow-hidden rounded-2xl border border-gray-200 hover:border-primary-400 transition-all duration-300 hover:shadow-2xl">
          <div class="relative overflow-hidden aspect-video">
            <Image
              src={manHiking}
              alt="Men's coaching and development"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900/80 via-gray-900/40 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <span class="inline-block px-3 py-1 bg-primary-500 text-white text-sm font-semibold rounded-full mb-3">Men's Coaching</span>
              <h3 class="text-2xl font-bold text-white mb-2">Masculine Confidence Framework</h3>
            </div>
          </div>
          <div class="p-6 bg-white">
            <p class="text-gray-700 leading-relaxed mb-4">
              Empowering men's coaching website focused on confidence building, personal development, and transformational programs.
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="px-3 py-1 bg-primary-50 text-primary-700 text-sm rounded-full">Coaching Programs</span>
              <span class="px-3 py-1 bg-primary-50 text-primary-700 text-sm rounded-full">Personal Growth</span>
              <span class="px-3 py-1 bg-primary-50 text-primary-700 text-sm rounded-full">Community</span>
            </div>
            <a href="https://masculineconfidenceframework.com/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-primary-600 font-semibold hover:text-primary-700 transition-colors">
              View Live Site
              <ExternalLink class="w-4 h-4" />
            </a>
          </div>
        </div>

        <!-- Dom Luke -->
        <div class="group relative overflow-hidden rounded-2xl border border-gray-200 hover:border-primary-400 transition-all duration-300 hover:shadow-2xl">
          <div class="relative overflow-hidden aspect-video">
            <Image
              src={domLukeCoaching}
              alt="Holistic business coaching"
              class="w-full h-full object-cover object-[50%_45%] group-hover:scale-105 transition-transform duration-300"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900/80 via-gray-900/40 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6">
              <span class="inline-block px-3 py-1 bg-primary-500 text-white text-sm font-semibold rounded-full mb-3">Holistic Business Coach</span>
              <h3 class="text-2xl font-bold text-white mb-2">Dom Luke</h3>
            </div>
          </div>
          <div class="p-6 bg-white">
            <p class="text-gray-700 leading-relaxed mb-4">
              Holistic business coaching website integrating mindfulness and wellness principles with entrepreneurial success strategies.
            </p>
            <div class="flex flex-wrap gap-2 mb-4">
              <span class="px-3 py-1 bg-primary-50 text-primary-700 text-sm rounded-full">Business Strategy</span>
              <span class="px-3 py-1 bg-primary-50 text-primary-700 text-sm rounded-full">Mindful Leadership</span>
              <span class="px-3 py-1 bg-primary-50 text-primary-700 text-sm rounded-full">1-on-1 Coaching</span>
            </div>
            <a href="https://domluke.com/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-primary-600 font-semibold hover:text-primary-700 transition-colors">
              View Live Site
              <ExternalLink class="w-4 h-4" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Testimonial - Lovitt Life -->
  <section class="py-20 md:py-28 bg-gradient-to-b from-gray-900 via-gray-950 to-black relative overflow-hidden">
    <!-- Background decoration -->
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-primary-600 rounded-full blur-3xl"></div>
      <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-secondary-500 rounded-full blur-3xl"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header - Above Grid -->
      <div class="text-center mb-12">
        <div class="inline-flex items-center px-4 py-2 bg-primary-900/50 border-l-4 border-primary-500 rounded-r-lg mb-6">
          <span class="text-sm font-bold text-primary-300 uppercase tracking-wider">Client Success Story</span>
        </div>

        <h2 class="text-4xl md:text-5xl font-bold text-white mb-4">
          <span class="animated-gradient-text">Transforming</span> Virtual Fitness
        </h2>
      </div>

      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
