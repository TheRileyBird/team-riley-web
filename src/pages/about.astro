---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Footer from '../components/Footer.astro';
import { Heart, Target, Award, Users, Zap, Shield } from 'lucide-astro';
---

<BaseLayout title="About Us - Team Riley" description="Learn about Team Riley and our mission to help health and wellness businesses thrive online">
  <Navigation />

  <PageHeader
    badge="Our Story"
    title='<span class="animated-gradient-text">Empowering</span> Health & Wellness Brands'
    subtitle="We're a team of designers and developers passionate about helping health and wellness brands grow their online presence and connect with more clients."
    primaryCTA={{ text: 'Get Started', href: '#get-started' }}
    secondaryCTA={{ text: 'View Our Work', href: '/portfolio' }}
  />

  <!-- Why Choose Us Section -->
  <section class="py-20 md:py-28 bg-gradient-to-b from-gray-900 via-gray-950 to-black relative overflow-hidden">
    <!-- Background decoration -->
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-primary-600 rounded-full blur-3xl"></div>
      <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-secondary-500 rounded-full blur-3xl"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <!--<div class="inline-flex items-center px-4 py-2 bg-primary-900/50 border-l-4 border-primary-500 rounded-r-lg mb-6">-->
        <!--  <span class="text-xs font-bold text-primary-300 tracking-wider uppercase">Why Team Riley</span>-->
        <!--</div>-->
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-4">
          What Makes Us <span class="animated-gradient-text">Different</span>
        </h2>
        <p class="text-xl text-gray-300 max-w-2xl mx-auto">
          We're not just building websites—we're building long-term partnerships.
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <!-- Left: Benefits List -->
        <div class="space-y-6">
          <div class="flex flex-col items-center text-center md:flex-row md:items-start md:text-left gap-4 p-6 bg-white/5 backdrop-blur-sm rounded-xl border border-white/10 hover:border-primary-500/50 transition-all duration-300">
            <div class="w-12 h-12 bg-gradient-to-br from-primary-600 to-primary-700 rounded-lg flex items-center justify-center flex-shrink-0">
              <Users class="w-6 h-6 text-white" />
            </div>
            <div>
              <h4 class="text-lg font-bold text-white mb-2">Health & Wellness Expertise</h4>
              <p class="text-gray-300">We specialize in health and wellness, understanding your industry's unique needs and challenges.</p>
            </div>
          </div>

          <div class="flex flex-col items-center text-center md:flex-row md:items-start md:text-left gap-4 p-6 bg-white/5 backdrop-blur-sm rounded-xl border border-white/10 hover:border-primary-500/50 transition-all duration-300">
            <div class="w-12 h-12 bg-gradient-to-br from-cyan-600 to-blue-700 rounded-lg flex items-center justify-center flex-shrink-0">
              <Zap class="w-6 h-6 text-white" />
            </div>
            <div>
              <h4 class="text-lg font-bold text-white mb-2">Fast Turnaround</h4>
              <p class="text-gray-300">Launch your new website in just 2 weeks with our streamlined process and efficient workflow.</p>
            </div>
          </div>

          <div class="flex flex-col items-center text-center md:flex-row md:items-start md:text-left gap-4 p-6 bg-white/5 backdrop-blur-sm rounded-xl border border-white/10 hover:border-primary-500/50 transition-all duration-300">
            <div class="w-12 h-12 bg-gradient-to-br from-purple-600 to-violet-700 rounded-lg flex items-center justify-center flex-shrink-0">
              <Shield class="w-6 h-6 text-white" />
            </div>
            <div>
              <h4 class="text-lg font-bold text-white mb-2">Ongoing Support</h4>
              <p class="text-gray-300">Unlimited updates and maintenance included—no hourly rates, no surprise bills.</p>
            </div>
          </div>
        </div>

        <!-- Right: Stats -->
        <div class="relative">
          <div class="bg-gradient-to-br from-primary-700 to-primary-900 rounded-3xl p-12 shadow-2xl">
            <div class="space-y-10">
              <div class="text-center border-b border-white/20 pb-8">
                <div class="text-4xl md:text-6xl font-bold text-white mb-2">100+</div>
                <p class="text-lg md:text-xl text-gray-200">Businesses Helped</p>
              </div>

              <div class="text-center border-b border-white/20 pb-8">
                <div class="text-4xl md:text-6xl font-bold text-white mb-2">2wks</div>
                <p class="text-lg md:text-xl text-gray-200">Average Launch Time</p>
              </div>

              <div class="text-center">
                <div class="text-4xl md:text-6xl font-bold text-white mb-2">24hr</div>
                <p class="text-lg md:text-xl text-gray-200">Response Time</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission Section -->
  <section class="py-20 md:py-28 bg-gradient-to-b from-gray-100 to-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader
        badge="Our Mission"
        title='<span class="animated-gradient-text">Better Health</span> <span class="text-gray-900">For Your Business</span>'
        subtitle="We believe every health and wellness business deserves a website that works as hard as they do"
      />

      <div class="grid md:grid-cols-3 gap-8">
        <div class="p-8 bg-gradient-to-br from-white to-gray-50 rounded-2xl border border-gray-200 hover:shadow-xl transition-all duration-300">
          <div class="w-14 h-14 bg-gradient-to-br from-primary-600 to-primary-700 rounded-xl flex items-center justify-center mb-6">
            <Heart class="w-7 h-7 text-white" />
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-3">Client-First Approach</h3>
          <p class="text-gray-700 leading-relaxed">
            Your success is our success. We partner with you to understand your unique goals and create solutions that drive real results.
          </p>
        </div>

        <div class="p-8 bg-gradient-to-br from-white to-gray-50 rounded-2xl border border-gray-200 hover:shadow-xl transition-all duration-300">
          <div class="w-14 h-14 bg-gradient-to-br from-cyan-600 to-blue-700 rounded-xl flex items-center justify-center mb-6">
            <Target class="w-7 h-7 text-white" />
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-3">Results-Driven</h3>
          <p class="text-gray-700 leading-relaxed">
            We focus on what matters most—converting visitors into clients and helping your business grow online.
          </p>
        </div>

        <div class="p-8 bg-gradient-to-br from-white to-gray-50 rounded-2xl border border-gray-200 hover:shadow-xl transition-all duration-300">
          <div class="w-14 h-14 bg-gradient-to-br from-violet-600 to-purple-700 rounded-xl flex items-center justify-center mb-6">
            <Award class="w-7 h-7 text-white" />
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-3">Quality Craftsmanship</h3>
          <p class="text-gray-700 leading-relaxed">
            Every website we build is crafted with attention to detail, modern design principles, and clean code.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Team Section -->
  <section class="py-20 md:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader
        badge="Our Team"
        title="Meet The People Behind Team Riley"
        subtitle="A dedicated team of designers, developers, and strategists committed to your success"
      />

      <div class="grid md:grid-cols-3 gap-8">
        <!-- Team Member 1 -->
        <div class="group">
          <div class="relative overflow-hidden rounded-2xl mb-6">
            <img
              src="/images/joshua-riley.png"
              alt="Joshua Riley"
              class="w-full aspect-square object-cover object-top group-hover:scale-105 transition-transform duration-300"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900/60 to-transparent"></div>
          </div>
          <h4 class="text-xl font-bold text-gray-900 mb-1">Joshua Riley</h4>
          <p class="text-primary-700 font-semibold mb-3">Founder & Lead Developer</p>
          <p class="text-gray-700">Passionate about creating beautiful, high-performing websites for health and wellness brands.</p>
        </div>

        <!-- Team Member 2 -->
        <div class="group">
          <div class="relative overflow-hidden rounded-2xl mb-6">
            <img
              src="/images/rachael-riley.jpg"
              alt="Rachael Riley"
              class="w-full aspect-square object-cover group-hover:scale-105 transition-transform duration-300"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900/60 to-transparent"></div>
          </div>
          <h4 class="text-xl font-bold text-gray-900 mb-1">Rachael Riley</h4>
          <p class="text-primary-700 font-semibold mb-3">Marketing Director</p>
          <p class="text-gray-700">Specializes in creating intuitive user experiences that convert visitors into loyal clients.</p>
        </div>

        <!-- Team Member 3 - The Client -->
        <div class="group">
          <div class="relative overflow-hidden rounded-2xl mb-6 bg-gradient-to-br from-primary-300 to-primary-400 flex items-center justify-center aspect-square">
            <svg class="w-2/5 h-2/5 mb-8 group-hover:scale-105 transition-transform duration-300" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <!-- User silhouette icon -->
              <circle cx="12" cy="8" r="4.5" fill="rgba(255,255,255,0.9)"/>
              <path d="M4 20c0-4.5 3.5-7.5 8-7.5s8 3 8 7.5" stroke="rgba(255,255,255,0.9)" stroke-width="2.5" stroke-linecap="round" fill="none"/>
            </svg>
            <div class="absolute bottom-0 left-0 right-0 bg-white/10 backdrop-blur-sm py-4">
              <p class="text-3xl font-bold text-white text-center tracking-wider">YOU</p>
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-gray-900/10 to-transparent"></div>
          </div>
          <h4 class="text-xl font-bold text-gray-900 mb-1">You</h4>
          <p class="text-primary-700 font-semibold mb-3">The Visionary</p>
          <p class="text-gray-700">Your business, your vision, your success—we're here to bring it all to life online.</p>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
