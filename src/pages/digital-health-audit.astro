---
import { Download } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import auditPdf from '../assets/pdfs/The Digital Health Audit Team Riley.pdf?url';
---

<BaseLayout
  title="Your Digital Health Audit - Team Riley"
  description="Download the Team Riley Digital Health Audit and identify opportunities to strengthen your online presence."
  robots="noindex, nofollow"
>
  <Navigation />

  <main class="min-h-screen bg-gradient-to-b from-primary-50 via-white to-gray-50 pt-28 pb-16 md:pt-36 md:pb-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-10">
        <p class="text-sm font-bold uppercase tracking-widest text-primary-700 mb-4">Free Digital Health Audit</p>
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-5">
          Your Guide Is Ready
        </h1>
        <p class="text-lg md:text-xl text-gray-600 leading-relaxed">
          Use this audit to find practical opportunities to improve your website, marketing, and client experience.
        </p>
      </div>

      <div class="flex justify-center mb-10">
        <a href={auditPdf} download class="btn btn-primary btn-lg rounded-xl">
          <Download class="w-5 h-5" />
          Download The Digital Health Audit
        </a>
      </div>

      <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-large">
        <iframe
          src={auditPdf}
          title="The Digital Health Audit by Team Riley"
          class="h-[75vh] min-h-[640px] w-full"
        >
        </iframe>
      </div>
    </div>
  </main>
</BaseLayout>
