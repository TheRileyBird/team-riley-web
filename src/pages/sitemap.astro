---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

// Define all site pages
const pages = [
  { title: 'Home', url: '/', description: 'Professional web design for health & wellness businesses' },
  { title: 'About Us', url: '/about', description: 'Learn about our team and mission' },
  { title: 'Services', url: '/services', description: 'Complete digital solutions for your business' },
  { title: 'Pricing', url: '/pricing', description: 'Simple, transparent pricing plans' },
  { title: 'Portfolio', url: '/portfolio', description: 'View our health & wellness client work' },
  { title: 'Contact', url: '/contact', description: 'Get in touch with our team' },
  { title: 'Privacy Policy', url: '/privacy-policy', description: 'Our data protection practices' },
  { title: 'Terms of Service', url: '/terms-of-service', description: 'Terms and conditions for our services' },
];

// Portfolio categories
const portfolioCategories = [
  { title: 'Medical & Clinical Health', url: '/portfolio#medical', description: 'Healthcare provider websites' },
  { title: 'Physical Wellness', url: '/portfolio#physical', description: 'Fitness and wellness websites' },
  { title: 'Holistic & Emotional Wellness', url: '/portfolio#holistic', description: 'Holistic health websites' },
];
---

<BaseLayout title="Sitemap - Team Riley" description="Complete sitemap of Team Riley's website">
  <Navigation />

  <section class="pt-32 pb-20 md:pb-28 bg-gradient-to-b from-blue-50 to-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">Sitemap</h1>
      <p class="text-xl text-gray-600 mb-12">
        Navigate through all pages on our website
      </p>

      <!-- Main Pages -->
      <div class="mb-12">
        <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-3">
          <span class="w-2 h-2 bg-primary-600 rounded-full"></span>
          Main Pages
        </h2>
        <div class="space-y-4">
          {pages.map(page => (
            <a
              href={page.url}
              class="block p-6 bg-white rounded-xl border border-gray-200 hover:border-primary-600 hover:shadow-lg transition-all duration-300 group"
            >
              <h3 class="text-xl font-bold text-gray-900 group-hover:text-primary-700 transition-colors mb-2">
                {page.title}
              </h3>
              <p class="text-gray-600">{page.description}</p>
              <p class="text-sm text-primary-600 mt-2 font-medium">{page.url}</p>
            </a>
          ))}
        </div>
      </div>

      <!-- Portfolio Categories -->
      <div class="mb-12">
        <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-3">
          <span class="w-2 h-2 bg-secondary-600 rounded-full"></span>
          Industries We Serve
        </h2>
        <div class="space-y-4">
          {portfolioCategories.map(category => (
            <a
              href={category.url}
              class="block p-6 bg-white rounded-xl border border-gray-200 hover:border-secondary-600 hover:shadow-lg transition-all duration-300 group"
            >
              <h3 class="text-xl font-bold text-gray-900 group-hover:text-secondary-700 transition-colors mb-2">
                {category.title}
              </h3>
              <p class="text-gray-600">{category.description}</p>
              <p class="text-sm text-secondary-600 mt-2 font-medium">{category.url}</p>
            </a>
          ))}
        </div>
      </div>

      <!-- Contact Info -->
      <div class="bg-gradient-to-br from-primary-50 to-blue-50 rounded-2xl p-8 border border-primary-200">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Need Help?</h2>
        <p class="text-gray-700 mb-6">
          Can't find what you're looking for? Contact us and we'll be happy to help.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/contact" class="btn btn-primary">
            Contact Us
          </a>
          <a href="mailto:hello@teamriley.com" class="btn btn-secondary">
            Email Us
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
