---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Footer from '../components/Footer.astro';
import { Mail, Phone, MapPin, Clock, MessageSquare, Send } from 'lucide-astro';
---

<BaseLayout title="Contact - Team Riley" description="Get in touch with Team Riley to start your health and wellness website project">
  <Navigation />

  <PageHeader
    badge="Get In Touch"
    title='<span class="text-gray-900">Let&#39;s Build Something</span> <span class="animated-gradient-text">Amazing Together</span>'
    subtitle="Have questions about our services? Ready to start your project? We'd love to hear from you."
    primaryCTA={{ text: 'Start Project', href: '#contact-form' }}
  />

  <!-- Contact Section -->
  <section class="py-20 md:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-16">
        <!-- Left: Contact Info -->
        <div>
          <SectionHeader
            badge="Contact Information"
            title="Multiple Ways To Reach Us"
            subtitle="Choose the method that works best for you"
            centered={false}
          />

          <div class="space-y-8">
            <!-- Email -->
            <div class="flex items-start gap-6 p-6 bg-gradient-to-br from-white to-gray-50 rounded-2xl border border-gray-200 hover:border-primary-600 transition-all duration-300 hover:shadow-lg">
              <div class="w-14 h-14 bg-gradient-to-br from-primary-600 to-primary-700 rounded-xl flex items-center justify-center flex-shrink-0">
                <Mail class="w-7 h-7 text-white" />
              </div>
              <div>
                <h4 class="text-xl font-bold text-gray-900 mb-2">Email Us</h4>
                <p class="text-gray-700 mb-3">We typically respond within 24 hours</p>
                <a href="mailto:hello@teamriley.com" class="text-primary-700 font-semibold hover:text-primary-800 transition-colors">
                  hello@teamriley.com
                </a>
              </div>
            </div>

            <!-- Phone -->
            <div class="flex items-start gap-6 p-6 bg-gradient-to-br from-white to-gray-50 rounded-2xl border border-gray-200 hover:border-primary-600 transition-all duration-300 hover:shadow-lg">
              <div class="w-14 h-14 bg-gradient-to-br from-cyan-600 to-blue-700 rounded-xl flex items-center justify-center flex-shrink-0">
                <Phone class="w-7 h-7 text-white" />
              </div>
              <div>
                <h4 class="text-xl font-bold text-gray-900 mb-2">Call Us</h4>
                <p class="text-gray-700 mb-3">Monday - Friday, 9am - 5pm CST</p>
                <a href="tel:2256144765" class="text-primary-700 font-semibold hover:text-primary-800 transition-colors">
                  (225) 614-4765
                </a>
              </div>
            </div>

            <!-- Location -->
            <div class="flex items-start gap-6 p-6 bg-gradient-to-br from-white to-gray-50 rounded-2xl border border-gray-200 hover:border-primary-600 transition-all duration-300 hover:shadow-lg">
              <div class="w-14 h-14 bg-gradient-to-br from-violet-600 to-purple-700 rounded-xl flex items-center justify-center flex-shrink-0">
                <MapPin class="w-7 h-7 text-white" />
              </div>
              <div>
                <h4 class="text-xl font-bold text-gray-900 mb-2">Visit Us</h4>
                <p class="text-gray-700 mb-3">Based in Baton Rouge, Louisiana</p>
                <p class="text-primary-700 font-semibold">
                  Serving health & wellness<br />businesses nationwide
                </p>
              </div>
            </div>

            <!-- Office Hours -->
            <div class="flex items-start gap-6 p-6 bg-gradient-to-br from-white to-gray-50 rounded-2xl border border-gray-200 hover:border-primary-600 transition-all duration-300 hover:shadow-lg">
              <div class="w-14 h-14 bg-gradient-to-br from-blue-600 to-cyan-600 rounded-xl flex items-center justify-center flex-shrink-0">
                <Clock class="w-7 h-7 text-white" />
              </div>
              <div>
                <h4 class="text-xl font-bold text-gray-900 mb-2">Office Hours</h4>
                <div class="space-y-1 text-gray-700">
                  <p>Monday - Friday: 9:00 AM - 5:00 PM</p>
                  <p>Saturday - Sunday: Closed</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: Contact Form -->
        <div>
          <div id="contact-form" class="bg-gradient-to-br from-gray-50 to-white rounded-3xl p-8 md:p-12 border border-gray-200 shadow-xl">
            <div class="flex items-center gap-4 mb-6">
              <div class="w-12 h-12 bg-gradient-to-br from-primary-600 to-primary-700 rounded-xl flex items-center justify-center">
                <MessageSquare class="w-6 h-6 text-white" />
              </div>
              <div>
                <h3 class="text-2xl font-bold text-gray-900">Send Us a Message</h3>
                <p class="text-gray-600">We'll get back to you ASAP</p>
              </div>
            </div>

            <form class="space-y-6">
              <!-- Name -->
              <div>
                <label for="name" class="block text-sm font-semibold text-gray-900 mb-2">
                  Your Name *
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  class="w-full px-4 py-3 bg-white border border-gray-300 rounded-xl text-gray-900 placeholder-gray-500 focus:border-primary-600 focus:ring-2 focus:ring-primary-600/20 transition-all duration-200 outline-none"
                  placeholder="John Doe"
                />
              </div>

              <!-- Email -->
              <div>
                <label for="email" class="block text-sm font-semibold text-gray-900 mb-2">
                  Email Address *
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="w-full px-4 py-3 bg-white border border-gray-300 rounded-xl text-gray-900 placeholder-gray-500 focus:border-primary-600 focus:ring-2 focus:ring-primary-600/20 transition-all duration-200 outline-none"
                  placeholder="john@example.com"
                />
              </div>

              <!-- Phone -->
              <div>
                <label for="phone" class="block text-sm font-semibold text-gray-900 mb-2">
                  Phone Number
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  class="w-full px-4 py-3 bg-white border border-gray-300 rounded-xl text-gray-900 placeholder-gray-500 focus:border-primary-600 focus:ring-2 focus:ring-primary-600/20 transition-all duration-200 outline-none"
                  placeholder="(555) 123-4567"
                />
              </div>

              <!-- Business Type -->
              <div>
                <label for="business" class="block text-sm font-semibold text-gray-900 mb-2">
                  Type of Business
                </label>
                <select
                  id="business"
                  name="business"
                  class="w-full px-4 py-3 bg-white border border-gray-300 rounded-xl text-gray-900 focus:border-primary-600 focus:ring-2 focus:ring-primary-600/20 transition-all duration-200 outline-none"
                >
                  <option value="">Select your business type</option>
                  <option value="medical">Medical Clinic</option>
                  <option value="wellness">Wellness Center</option>
                  <option value="fitness">Fitness Studio</option>
                  <option value="therapy">Therapy Practice</option>
                  <option value="spa">Spa/Salon</option>
                  <option value="pharmacy">Pharmacy</option>
                  <option value="other">Other</option>
                </select>
              </div>

              <!-- Message -->
              <div>
                <label for="message" class="block text-sm font-semibold text-gray-900 mb-2">
                  Your Message *
                </label>
                <textarea
                  id="message"
                  name="message"
                  rows="5"
                  required
                  class="w-full px-4 py-3 bg-white border border-gray-300 rounded-xl text-gray-900 placeholder-gray-500 focus:border-primary-600 focus:ring-2 focus:ring-primary-600/20 transition-all duration-200 outline-none resize-none"
                  placeholder="Tell us about your project..."
                ></textarea>
              </div>

              <!-- Budget -->
              <div>
                <label for="budget" class="block text-sm font-semibold text-gray-900 mb-2">
                  Estimated Budget
                </label>
                <select
                  id="budget"
                  name="budget"
                  class="w-full px-4 py-3 bg-white border border-gray-300 rounded-xl text-gray-900 focus:border-primary-600 focus:ring-2 focus:ring-primary-600/20 transition-all duration-200 outline-none"
                >
                  <option value="">Select a budget range</option>
                  <option value="silver">$199/month (Silver Plan)</option>
                  <option value="gold">$399/month (Gold Plan)</option>
                  <option value="platinum">$599/month (Platinum Plan)</option>
                  <option value="custom">Custom Quote</option>
                </select>
              </div>

              <!-- Submit Button -->
              <button
                type="submit"
                class="w-full btn btn-primary btn-lg"
              >
                Send Message
                <Send class="w-5 h-5" />
              </button>

              <p class="text-sm text-gray-600 text-center">
                By submitting this form, you agree to our privacy policy
              </p>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-20 md:py-28 bg-gradient-to-b from-gray-100 to-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader
        title="Common Questions"
        subtitle="Quick answers to questions you might have before reaching out"
      />

      <div class="space-y-6">
        <details class="group p-6 bg-white border border-gray-200 rounded-xl hover:border-primary-600 transition-colors">
          <summary class="cursor-pointer font-semibold text-lg text-gray-900 list-none flex items-center justify-between">
            What information should I include in my message?
            <span class="text-primary-600 group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-4 text-gray-700 leading-relaxed">
            Tell us about your business, what services you offer, who your target audience is, and what goals you have for your website. If you have any design preferences or examples of sites you like, include those too!
          </p>
        </details>

        <details class="group p-6 bg-white border border-gray-200 rounded-xl hover:border-primary-600 transition-colors">
          <summary class="cursor-pointer font-semibold text-lg text-gray-900 list-none flex items-center justify-between">
            How quickly will I hear back from you?
            <span class="text-primary-600 group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-4 text-gray-700 leading-relaxed">
            We typically respond to all inquiries within 24 hours during business days. If you reach out on a weekend, we'll get back to you first thing Monday morning.
          </p>
        </details>

        <details class="group p-6 bg-white border border-gray-200 rounded-xl hover:border-primary-600 transition-colors">
          <summary class="cursor-pointer font-semibold text-lg text-gray-900 list-none flex items-center justify-between">
            Do you offer free consultations?
            <span class="text-primary-600 group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-4 text-gray-700 leading-relaxed">
            Yes! We offer a free 30-minute consultation to discuss your project, answer your questions, and determine if we're a good fit for each other.
          </p>
        </details>

        <details class="group p-6 bg-white border border-gray-200 rounded-xl hover:border-primary-600 transition-colors">
          <summary class="cursor-pointer font-semibold text-lg text-gray-900 list-none flex items-center justify-between">
            Can we schedule a call instead of emailing?
            <span class="text-primary-600 group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-4 text-gray-700 leading-relaxed">
            Absolutely! Just mention in your message that you'd prefer a phone call, and we'll coordinate a time that works for both of us.
          </p>
        </details>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
