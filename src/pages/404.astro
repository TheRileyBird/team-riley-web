---
/**
 * Netlify serves this automatically for any path that doesn't match a built page,
 * with a real HTTP 404.
 *
 * Until now netlify.toml carried an SPA catch-all (`from = "/*"` -> `/index.html`
 * at status 200), so every dead URL answered with the homepage and an HTTP 200.
 * Google treats that as a soft 404 and reports it in Search Console — an awkward
 * thing to have on a site that sells SEO foundations.
 *
 * `robots` is set to noindex so the page itself never competes in search.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
import { ArrowRight } from '@lucide/astro';

const destinations = [
  { title: 'Services', href: '/services', description: 'What we build and manage' },
  { title: 'Pricing', href: '/pricing', description: 'Plans and what each includes' },
  { title: 'Portfolio', href: '/portfolio', description: 'Client work' },
  { title: 'About', href: '/about', description: 'Who we are' },
  { title: 'Contact', href: '/contact', description: 'Start a conversation' },
  { title: 'Sitemap', href: '/sitemap', description: 'Every page on the site' },
];
---

<BaseLayout
  title="Page Not Found - Team Riley"
  description="That page doesn't exist. Here's where to go instead."
  robots="noindex, follow"
>
  <Navigation />

  <PageHeader
    badge="404"
    title='<span class="animated-gradient-text">Page</span> <span class="text-gray-900">Not Found</span>'
    subtitle="That link is broken, out of date, or was mistyped. Nothing is wrong with your browser. Here's where you were probably headed."
  />

  <section class="py-16 md:py-20 bg-white">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {destinations.map((destination) => (
          <a
            href={destination.href}
            class="group flex flex-col rounded-2xl border border-gray-200 bg-white p-6 transition-all duration-300 hover:-translate-y-1.5 hover:border-primary-400 hover:shadow-large"
          >
            <h2 class="mb-2 flex items-center gap-2 text-xl font-bold text-gray-900 group-hover:text-primary-700">
              {destination.title}
              <ArrowRight class="h-4 w-4 flex-shrink-0" />
            </h2>
            <p class="text-sm text-gray-600">{destination.description}</p>
          </a>
        ))}
      </div>

      <div class="mt-12 rounded-2xl border border-gray-200 bg-gray-50 px-8 py-8 text-center">
        <h2 class="text-2xl font-bold text-gray-900">Looking for something specific?</h2>
        <p class="mx-auto mt-3 max-w-xl text-gray-700">
          If you followed a link from an email or a proposal and it brought you here, send it
          over and we'll point you to the right place.
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-4">
          <a href="/#book-a-call" data-booking-modal-open class="btn btn-primary">
            Book a Call
          </a>
          <a href="mailto:hello@teamrileyweb.com" class="btn btn-secondary">
            Email Us
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
