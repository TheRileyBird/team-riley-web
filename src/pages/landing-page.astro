---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import { ArrowRight, CheckCircle2, ShieldCheck, TrendingUp, XCircle } from '@lucide/astro';
import careptSite from '../assets/sites/carept.png';
import dsmmdSite from '../assets/sites/dsmmd.png';
import lovemoreSite from '../assets/sites/lovemore.png';
import life2healthSite from '../assets/sites/life2health.png';
import graceSite from '../assets/sites/grace.png';
import cfcSite from '../assets/sites/cfc.png';

const wrongProblemNeeds = [
  'a website that builds trust instantly',
  'a brand that feels premium',
  'messaging that explains their value clearly',
  'a patient journey that reduces friction',
  'consistent visibility online',
];

const growthBlocks = [
  'embarrassed by their website',
  'inconsistent on social media',
  'dependent on referrals',
  'invisible on Google',
  'too busy to market consistently',
];

const failedEfforts = [
  ['Posting inconsistently on social media', 'without a real strategy behind it'],
  ['Hiring a generic marketing agency', 'that does not understand healthcare psychology'],
  ['Running ads to a weak website', 'which silently kills conversions'],
  ['DIY website builders', 'that make your practice look smaller than it is'],
  ['Asking staff to “help with marketing”', 'while they already have full-time jobs'],
  ['Depending entirely on referrals', 'which creates unpredictable revenue cycles'],
  ['Paying for SEO with no measurable growth', 'because nobody fixed the foundation first'],
  ['Trying to “look professional” online', 'instead of building actual authority and trust'],
  ['Waiting until things slow down to fix marketing', 'when visibility should have been built months earlier'],
  ['Watching less-qualified competitors dominate online', 'simply because they present themselves better'],
];

const patientQuestions = [
  'Does this place feel trustworthy?',
  'Does this feel premium?',
  'Do these people know what they are doing?',
  'Do I feel safe here?',
  'Is this worth the investment?',
];

const solutionSignals = [
  'patient psychology',
  'trust-based design',
  'premium positioning',
  'local visibility',
  'authority-building',
  'conversion strategy',
];

const services = [
  'Website Design & Management',
  'SEO',
  'Branding',
  'Social Media',
  'Paid Advertising',
  'Patient Flow Systems',
  'Unlimited Updates',
];

const businessTypes = [
  'med spa',
  'chiropractic clinic',
  'wellness studio',
  'functional medicine practice',
  'therapy practice',
  'private-pay medical business',
  'yoga or holistic wellness brand',
];

const plans = [
  {
    name: 'Silver',
    price: '$199/mo',
    pages: '1-5 pages',
    fit: 'Perfect for smaller wellness businesses',
  },
  {
    name: 'Gold',
    price: '$399/mo',
    pages: '5-11 pages',
    fit: 'Best for established practices ready to grow',
    featured: true,
  },
  {
    name: 'Platinum',
    price: '$599/mo',
    pages: '11+ pages',
    fit: 'For scaling and premium positioning',
  },
];

const planIncludes = [
  'Hosting',
  'Ongoing support',
  'Unlimited updates',
  'SEO foundations',
  'Mobile optimization',
  'Strategy guidance',
];
---

<BaseLayout title="Landing Page - Digital Health For Health & Wellness Brands">
  <Navigation />

  <!-- Hero Section -->
  <section class="relative pt-24 pb-20 md:pt-32 md:pb-28 overflow-hidden bg-gradient-to-br from-gray-50 via-white to-blue-50">
    <div class="absolute inset-0 opacity-5">
      <div class="absolute top-16 right-20 w-96 h-96 bg-primary-600 rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 left-16 w-80 h-80 bg-accent-400 rounded-full blur-3xl"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-[1.1fr_0.9fr] gap-12 items-center">
        <div>
          <div class="inline-flex items-center px-4 py-2 bg-primary-100 border-l-4 border-primary-700 rounded-r-lg mb-8">
            <span class="text-sm font-semibold text-primary-800 uppercase tracking-wider">Digital Health For Health & Wellness Brands</span>
          </div>

          <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold leading-tight text-gray-900 mb-6">
            Your Practice Is Not Losing Patients Because You Are Bad.
          </h1>

          <h2 class="text-2xl md:text-3xl font-bold text-gray-800 leading-snug mb-6">
            You are losing them because your digital presence does not match your level of care.
          </h2>

          <p class="text-xl text-gray-700 leading-relaxed max-w-3xl mb-6">
            Most health businesses do not have a patient problem. They have a visibility, trust, and positioning problem.
          </p>

          <p class="text-lg text-gray-600 leading-relaxed max-w-3xl mb-8">
            Every day, potential patients search online, compare options, and silently choose competitors with better websites, better branding, better Google presence, and better social proof, even when your actual care is far superior.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 mb-6">
            <a href="/#book-a-call"
              data-booking-modal-open
              class="btn btn-primary btn-lg">
              Book Your Digital Health Checkup
              <ArrowRight class="w-5 h-5" />
            </a>
          </div>

          <div class="flex flex-wrap gap-3 text-sm font-semibold text-gray-700">
            <span class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 shadow-soft"><CheckCircle2 class="w-4 h-4 text-primary-700" /> Unlimited Updates</span>
            <span class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 shadow-soft"><CheckCircle2 class="w-4 h-4 text-primary-700" /> Health & Wellness Specialists</span>
            <span class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 shadow-soft"><CheckCircle2 class="w-4 h-4 text-primary-700" /> Websites Starting at $199/mo</span>
          </div>
        </div>

        <div class="relative">
          <div class="grid grid-cols-2 gap-4">
            <Image src={careptSite} alt="CarePT website preview" class="aspect-video w-full rounded-xl object-cover object-top shadow-xl" />
            <Image src={dsmmdSite} alt="DSM MD website preview" class="aspect-video w-full rounded-xl object-cover object-top shadow-xl mt-10" />
            <Image src={lovemoreSite} alt="LoveMore website preview" class="aspect-video w-full rounded-xl object-cover object-top shadow-xl" />
            <Image src={life2healthSite} alt="Life2Health website preview" class="aspect-video w-full rounded-xl object-cover object-top shadow-xl mt-10" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Wrong Problem Section -->
  <section class="py-20 md:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center mb-12">
        <div class="inline-flex items-center px-4 py-2 bg-primary-100 border-l-4 border-primary-700 rounded-r-lg mb-6">
          <span class="text-sm font-semibold text-primary-800">You Are Solving The Wrong Problem</span>
        </div>
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">Most health businesses think they need more marketing.</h2>
        <p class="text-2xl font-bold text-gray-800 mb-6">Usually, that is not true.</p>
        <p class="text-xl text-gray-700 leading-relaxed">What they actually need is the digital infrastructure that makes patients trust them faster and take the next step with less friction.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 max-w-6xl mx-auto">
        <div class="rounded-xl border border-gray-200 bg-gray-50 p-8">
          <h3 class="text-xl font-bold text-gray-900 mb-5">They need:</h3>
          <ul class="space-y-3">
            {wrongProblemNeeds.map((item) => (
              <li class="flex gap-3 text-gray-700"><CheckCircle2 class="w-5 h-5 text-primary-700 flex-shrink-0 mt-0.5" /> {item}</li>
            ))}
          </ul>
        </div>
        <div class="rounded-xl border border-gray-200 bg-gray-50 p-8">
          <h3 class="text-xl font-bold text-gray-900 mb-5">Instead, they are:</h3>
          <ul class="space-y-3">
            {growthBlocks.map((item) => (
              <li class="flex gap-3 text-gray-700"><XCircle class="w-5 h-5 text-secondary-600 flex-shrink-0 mt-0.5" /> {item}</li>
            ))}
          </ul>
        </div>
      </div>

      <p class="text-center text-2xl md:text-3xl font-bold text-gray-900 mt-14">
        Growth feels random because the digital infrastructure is weak.
      </p>
    </div>
  </section>

  <!-- Failed Efforts Section -->
  <section class="py-20 md:py-28 bg-gradient-to-b from-gray-900 via-gray-950 to-black relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-primary-600 rounded-full blur-3xl"></div>
      <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-secondary-500 rounded-full blur-3xl"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <div class="inline-flex items-center px-4 py-2 bg-primary-900/50 border-l-4 border-primary-500 rounded-r-lg mb-6">
          <span class="text-sm font-bold text-primary-300 uppercase tracking-wider">Why Everything You Tried Quietly Failed</span>
        </div>
        <h2 class="text-4xl md:text-5xl font-bold text-white">Why most marketing efforts quietly fail</h2>
      </div>

      <div class="grid md:grid-cols-2 gap-5">
        {failedEfforts.map(([title, detail], index) => (
          <div class="rounded-xl border border-white/10 bg-white/5 p-6">
            <div class="flex gap-4">
              <span class="w-9 h-9 rounded-full bg-gradient-to-br from-primary-600 to-secondary-600 text-white font-bold flex items-center justify-center flex-shrink-0">{index + 1}</span>
              <div>
                <h3 class="text-lg font-bold text-white">{title}</h3>
                <p class="text-gray-300 mt-1">{detail}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Reframe Section -->
  <section class="py-20 md:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-[0.9fr_1.1fr] gap-12 items-center">
        <div>
          <div class="inline-flex items-center px-4 py-2 bg-primary-100 border-l-4 border-primary-700 rounded-r-lg mb-6">
            <span class="text-sm font-semibold text-primary-800">The Reframe</span>
          </div>
          <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">Your website is not a brochure.</h2>
          <p class="text-2xl font-bold text-gray-800 mb-6">It is either building trust, creating authority, converting visitors, and attracting ideal patients, or quietly pushing people away.</p>
          <p class="text-xl text-gray-700 leading-relaxed">Patients make emotional decisions long before they ever contact you. Your digital presence answers their biggest questions before you ever speak to them.</p>
        </div>

        <div class="rounded-2xl bg-gray-950 p-8 border border-gray-800 shadow-2xl">
          <ul class="space-y-5">
            {patientQuestions.map((question) => (
              <li class="flex gap-4 text-white text-lg"><ShieldCheck class="w-6 h-6 text-accent-300 flex-shrink-0 mt-0.5" /> {question}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Solution Section -->
  <section class="py-20 md:py-28 bg-gray-950 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10">
      <div class="absolute top-16 right-10 w-80 h-80 bg-primary-600 rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 left-10 w-72 h-72 bg-accent-500 rounded-full blur-3xl"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center mb-12">
        <div class="inline-flex items-center px-4 py-2 bg-primary-900/50 border-l-4 border-primary-500 rounded-r-lg mb-6">
          <span class="text-sm font-bold text-primary-300 uppercase tracking-wider">The Solution</span>
        </div>
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">Team Riley becomes your digital health partner.</h2>
        <p class="text-xl text-gray-300 leading-relaxed mb-8">We work exclusively with health, wellness, and medical brands, so you can focus on patient care instead of trying to become a marketer.</p>
        <a href="/#book-a-call"
          data-booking-modal-open
          class="btn btn-primary btn-lg">
          Schedule Your Digital Health Checkup
          <ArrowRight class="w-5 h-5" />
        </a>
      </div>

      <div class="grid md:grid-cols-2 gap-6 max-w-6xl mx-auto">
        <div class="rounded-xl border border-white/10 bg-white/5 p-8">
          <h3 class="text-xl font-bold text-white mb-5">We understand:</h3>
          <ul class="space-y-3">
            {solutionSignals.map((item) => (
              <li class="flex gap-3 text-gray-300"><CheckCircle2 class="w-5 h-5 text-accent-300 flex-shrink-0 mt-0.5" /> {item}</li>
            ))}
          </ul>
        </div>
        <div class="rounded-xl border border-white/10 bg-white/5 p-8">
          <h3 class="text-xl font-bold text-white mb-5">We handle:</h3>
          <ul class="space-y-3">
            {services.map((item) => (
              <li class="flex gap-3 text-gray-300"><CheckCircle2 class="w-5 h-5 text-primary-300 flex-shrink-0 mt-0.5" /> {item}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Fit Section -->
  <section class="py-20 md:py-28 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center px-4 py-2 bg-primary-100 border-l-4 border-primary-700 rounded-r-lg mb-6">
        <span class="text-sm font-semibold text-primary-800">This Is For You If</span>
      </div>
      <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-10">You run a health or wellness business that has outgrown its online presence.</h2>
      <div class="flex flex-wrap justify-center gap-3 mb-10">
        {businessTypes.map((type) => (
          <span class="rounded-full bg-gray-100 border border-gray-200 px-5 py-3 text-gray-800 font-semibold">{type}</span>
        ))}
      </div>
      <p class="text-xl text-gray-700 max-w-3xl mx-auto">And you know your digital presence no longer reflects the level of care you provide.</p>
    </div>
  </section>

  <!-- Social Proof Section -->
  <section class="py-20 md:py-28 bg-gradient-to-b from-gray-50 to-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">The best practices usually are not the most visible.</h2>
        <p class="text-xl text-gray-700">Until they fix their digital presence.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <blockquote class="rounded-2xl bg-white border border-gray-200 p-8 shadow-soft">
          <p class="text-xl text-gray-800 leading-relaxed mb-6">“We finally have a website and brand presence that actually reflects the quality of care we provide. Patients regularly mention the website before they even walk in.”</p>
          <footer class="font-bold text-gray-900">Practice Owner</footer>
        </blockquote>
        <blockquote class="rounded-2xl bg-white border border-gray-200 p-8 shadow-soft">
          <p class="text-xl text-gray-800 leading-relaxed mb-6">“Before Team Riley, our marketing felt random. Now everything feels cohesive and professional.”</p>
          <footer class="font-bold text-gray-900">Wellness Brand Founder</footer>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- Pricing Section -->
  <section id="pricing" class="py-20 md:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <div class="inline-flex items-center px-4 py-2 bg-primary-100 border-l-4 border-primary-700 rounded-r-lg mb-6">
          <span class="text-sm font-semibold text-primary-800">Simple, Predictable Pricing</span>
        </div>
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">Choose the level of support your practice needs.</h2>
        <p class="text-xl text-gray-700">$500 setup fee. All plans include the essentials.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 mb-12">
        {plans.map((plan) => (
          <div class={`rounded-2xl border p-8 shadow-soft transition-all duration-300 hover:-translate-y-1.5 hover:shadow-large ${plan.featured ? 'border-accent-400 bg-blue-50 md:scale-105 hover:md:scale-[1.08] ring-2 ring-accent-400/60' : 'border-gray-200 bg-gray-50 hover:border-primary-400'}`}>
            {plan.featured && <p class="text-sm font-bold text-primary-700 uppercase tracking-wider mb-3">Most Popular</p>}
            <h3 class="text-2xl font-bold text-gray-900 mb-2">{plan.name}</h3>
            <p class="text-5xl font-bold text-gray-900 mb-4">{plan.price}</p>
            <p class="text-lg font-semibold text-gray-800">{plan.pages}</p>
            <p class="text-gray-600 mt-2">{plan.fit}</p>
          </div>
        ))}
      </div>

      <div class="rounded-2xl border border-gray-200 bg-gray-50 p-8">
        <h3 class="text-xl font-bold text-gray-900 mb-5">All plans include:</h3>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {planIncludes.map((item) => (
            <div class="flex gap-3 text-gray-700"><CheckCircle2 class="w-5 h-5 text-primary-700 flex-shrink-0 mt-0.5" /> {item}</div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Objection Handling Section -->
  <section class="py-20 md:py-28 bg-gray-950">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">This is not about “doing more marketing.”</h2>
      <p class="text-xl text-gray-300 leading-relaxed mb-10">It is about finally building a digital presence that matches your expertise, builds trust automatically, positions you correctly, attracts better-fit patients, and works consistently over time.</p>
      <div class="inline-flex items-center gap-3 rounded-2xl bg-white p-6 text-left shadow-2xl">
        <TrendingUp class="w-10 h-10 text-primary-700 flex-shrink-0" />
        <p class="text-xl font-bold text-gray-900">One new patient per month often covers the entire investment.</p>
      </div>
    </div>
  </section>

  <!-- Final Close Section -->
  <section class="py-20 md:py-28 bg-gradient-to-br from-gray-50 via-white to-blue-50">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center px-4 py-2 bg-primary-100 border-l-4 border-primary-700 rounded-r-lg mb-6">
        <span class="text-sm font-semibold text-primary-800">Final Close</span>
      </div>
      <h2 class="text-5xl md:text-6xl font-bold text-gray-900 mb-8">You already built the hard part.</h2>
      <div class="text-2xl md:text-3xl font-bold text-gray-800 space-y-2 mb-8">
        <p>You built the skills.</p>
        <p>The reputation.</p>
        <p>The patient outcomes.</p>
        <p>The years of experience.</p>
      </div>
      <p class="text-2xl text-gray-700 mb-10">Now your online presence needs to catch up.</p>
      <a href="/#book-a-call"
        data-booking-modal-open
        class="btn btn-primary btn-lg mb-5">
        Book Your Digital Health Checkup
        <ArrowRight class="w-5 h-5" />
      </a>
      <p class="text-gray-600 max-w-2xl mx-auto">
        No pressure. No generic sales pitch. Just a strategic conversation about where your digital presence is helping and where it is quietly costing you patients.
      </p>
    </div>
  </section>

  <Footer />
</BaseLayout>
