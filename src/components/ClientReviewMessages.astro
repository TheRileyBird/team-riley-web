---
interface ReviewMessage {
  client: string;
  text: string;
  side?: 'left' | 'right';
  top?: string;
}

interface Props {
  reviews: ReviewMessage[];
}

const { reviews } = Astro.props;

const positionedReviews = reviews.map((review, index) => ({
  ...review,
  side: review.side ?? (index % 2 === 0 ? 'right' : 'left'),
  top: review.top ?? `${24 + index * 34}rem`,
}));
---

<div class="client-review-overlay" aria-label="Client review messages">
  {positionedReviews.map((review, index) => (
    <article
      class:list={[
        'floating-review-message',
        review.side === 'right' ? 'floating-review-message-right' : 'floating-review-message-left',
      ]}
      style={`--message-index: ${index}; --message-top: ${review.top};`}
    >
      <span class="floating-review-client">{review.client}</span>
      <p>{review.text}</p>
    </article>
  ))}
</div>

<script>
  const revealFloatingReviewMessages = () => {
    const messages = document.querySelectorAll('.floating-review-message');

    if (!messages.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      {
        rootMargin: '0px 0px -18% 0px',
        threshold: 0.15,
      }
    );

    messages.forEach((message) => {
      message.classList.add('floating-review-message-animated');
      observer.observe(message);
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', revealFloatingReviewMessages);
  } else {
    revealFloatingReviewMessages();
  }
</script>

<style>
  .client-review-overlay {
    display: none;
  }

  @media (min-width: 1024px) {
    .client-review-overlay {
      --review-sent-color: #0b93f6;
      --review-received-color: #e5e5ea;
      --review-page-bg: #ffffff;
      display: block;
      position: absolute;
      inset: 0;
      z-index: 50;
      pointer-events: none;
    }

    .floating-review-message {
      position: absolute;
      top: var(--message-top);
      width: min(31vw, 360px);
      border-radius: 1.5625rem;
      padding: 0.75rem 1.25rem;
      box-shadow:
        0 18px 42px rgba(15, 23, 42, 0.16),
        0 1px 0 rgba(255, 255, 255, 0.42) inset;
      transition:
        opacity 700ms ease,
        transform 850ms cubic-bezier(0.18, 0.95, 0.25, 1.18);
      transition-delay: calc(var(--message-index) * 55ms);
      will-change: transform, opacity;
    }

    .floating-review-message::after {
      content: '';
      position: absolute;
      bottom: 0;
      width: 0;
      height: 0;
    }

    .floating-review-message-animated {
      opacity: 0;
      transform: translate3d(var(--message-start-x), 48px, 0) scale(0.92);
    }

    .floating-review-message.is-visible {
      opacity: 1;
      transform: translate3d(0, 0, 0) scale(1);
    }

    .floating-review-message p {
      margin: 0;
      font-size: 0.98rem;
      line-height: 1.5;
      font-weight: 500;
    }

    .floating-review-client {
      display: block;
      margin-bottom: 0.18rem;
      font-size: 0.67rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      opacity: 0.72;
    }

    .floating-review-message-left {
      --message-start-x: -54px;
      --review-tail-color: var(--review-received-color);
      left: 25px;
      background: var(--review-received-color);
      color: #111827;
    }

    .floating-review-message-right {
      --message-start-x: 54px;
      --review-tail-color: var(--review-sent-color);
      right: 25px;
      background: var(--review-sent-color);
      color: #ffffff;
    }

    .floating-review-message-left::after {
      left: -0.55rem;
      border-right: 0.9rem solid var(--review-tail-color);
      border-top: 0.9rem solid transparent;
    }

    .floating-review-message-right::after {
      right: -0.55rem;
      border-left: 0.9rem solid var(--review-tail-color);
      border-top: 0.9rem solid transparent;
    }
  }

  @media (min-width: 1280px) {
    .floating-review-message {
      width: 380px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-review-message {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
