---
interface Props {
  /** true = no background of its own, so whatever sits behind it shows through. */
  transparent?: boolean;
  /**
   * What comes next. 'section' is a light section that brings its own top padding,
   * so the header stays tight. 'dark-band' is a dark section starting hard against
   * the header: its padding is inside the dark area and buys the light side nothing,
   * so the header has to pay for its own bottom air.
   */
  follows?: 'section' | 'dark-band';
  badge?: string;
  title: string;
  subtitle: string;
  primaryCTA?: { text: string; href: string };
  secondaryCTA?: { text: string; href: string };
}

const {
  transparent = false,
  follows = 'section',
  badge,
  title,
  subtitle,
  primaryCTA,
  secondaryCTA
} = Astro.props;

import { ArrowRight } from '@lucide/astro';
---

<section
  class:list={[
    // The nav is fixed and 4rem tall, so the top padding pays for that before any
    // air shows: pt-28 leaves 48px above the badge, md:pt-36 leaves 80px. The bottom
    // is deliberately tight because what follows (pricing cards, portfolio sections)
    // brings its own top padding — except before a dark band, where the bottom has to
    // match the visible top on its own or the block sits high in its own space.
    'relative pt-28 md:pt-36 overflow-hidden',
    follows === 'dark-band' ? 'pb-12 md:pb-20' : 'pb-6 md:pb-8',
    transparent ? 'bg-transparent' : 'bg-gradient-to-b from-primary-50 to-white'
  ]}
>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto text-center space-y-6">
      {badge && (
        <div class="flex justify-center">
          <div class="inline-flex items-center px-4 py-2 bg-primary-100 border-l-4 border-primary-700 rounded-r-lg">
            <span class="text-sm font-semibold text-primary-800">{badge}</span>
          </div>
        </div>
      )}

      <h1 class="text-4xl md:text-5xl font-bold leading-tight">
        <Fragment set:html={title} />
      </h1>

      <p class="text-lg text-gray-700 leading-relaxed max-w-2xl mx-auto">
        {subtitle}
      </p>

      {(primaryCTA || secondaryCTA) && (
        <div class="flex flex-col sm:flex-row gap-4 justify-center pt-2">
          {primaryCTA && primaryCTA.href && primaryCTA.text && (
            <a
              href={primaryCTA.href}
              data-booking-modal-open={primaryCTA.href.endsWith('#book-a-call') ? true : undefined}
              class="btn btn-primary btn-lg">
              {primaryCTA.text}
              <ArrowRight class="w-5 h-5" />
            </a>
          )}
          {secondaryCTA && secondaryCTA.href && secondaryCTA.text && (
            <a href={secondaryCTA.href} class="btn btn-secondary btn-lg">
              {secondaryCTA.text}
            </a>
          )}
        </div>
      )}
    </div>
  </div>
</section>
