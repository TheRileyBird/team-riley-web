---
import BookingWidget from './BookingWidget.astro';
---

<dialog
  id="book-a-call"
  aria-label="Schedule a call with Team Riley"
  class="m-auto h-[calc(100dvh-1rem)] w-[calc(100%-1rem)] max-w-4xl overflow-hidden rounded-2xl bg-[#171717] p-0 shadow-2xl backdrop:bg-black/70 md:h-[min(90dvh,900px)]"
>
    <button
      type="button"
      data-booking-modal-close
      aria-label="Close booking calendar"
      class="absolute right-4 top-8 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-primary-700 text-white shadow-lg transition-colors hover:bg-primary-800 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-[#171717]"
    >
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  <div class="relative h-full overflow-y-auto">
    <BookingWidget />
  </div>
</dialog>
<script>
  import { lockPageScroll, releasePageScroll } from '../scripts/scroll-lock';

  const bookingModal = document.querySelector<HTMLDialogElement>('#book-a-call');
  const bookingLinks = document.querySelectorAll<HTMLAnchorElement>('[data-booking-modal-open]');
  const closeButton = document.querySelector<HTMLButtonElement>('[data-booking-modal-close]');

  const trackBookConsultation = () => {
    const trackingWindow = window as Window & {
      dataLayer?: unknown[];
      gtag?: (...args: unknown[]) => void;
    };

    const eventParams = {
      modal_id: 'book-a-call',
      booking_widget_id: 'f6Bs4WiCkim3CoAkeFiN'
    };

    if (typeof trackingWindow.gtag === 'function') {
      trackingWindow.gtag('event', 'book_consultation', eventParams);
      return;
    }

    trackingWindow.dataLayer = trackingWindow.dataLayer || [];
    trackingWindow.dataLayer.push({
      event: 'book_consultation',
      ...eventParams
    });
  };

  // showModal() makes the rest of the page inert but does NOT stop it scrolling,
  // so the page used to scroll away behind the open calendar — everywhere this
  // modal opens from, on every page. Whichever overlay is on top owns the lock:
  // this one takes it on open and releases it on close.
  const openBookingModal = () => {
    if (!bookingModal || typeof bookingModal.showModal !== 'function') {
      return false;
    }

    if (!bookingModal.open) {
      lockPageScroll();
      bookingModal.showModal();
      trackBookConsultation();
    }

    return true;
  };

  const closeBookingModal = () => {
    if (bookingModal?.open) {
      bookingModal.close();
    }
  };

  // Covers every close path at once: the close button, a backdrop click, and the
  // browser's own Escape handling, which fires `close` without going through
  // closeBookingModal.
  bookingModal?.addEventListener('close', releasePageScroll);

  bookingLinks.forEach((link) => {
    link.addEventListener('click', (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
        return;
      }

      if (openBookingModal()) {
        event.preventDefault();
      }
    });
  });

  closeButton?.addEventListener('click', closeBookingModal);
  bookingModal?.addEventListener('click', (event) => {
    if (event.target === bookingModal) {
      closeBookingModal();
    }
  });

  if (window.location.hash === '#book-a-call') {
    openBookingModal();
  }
</script>
