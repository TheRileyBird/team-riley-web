---
interface Props {
  badge?: string;
  title: string;
  subtitle?: string;
  centered?: boolean;
}

const { badge, title, subtitle, centered = true } = Astro.props;
---

<div class={centered ? 'text-center mb-16' : 'mb-16'}>
  {badge && (
    <div class={`inline-flex items-center px-4 py-2 bg-primary-600/10 border-l-4 border-primary-600 rounded-r-lg mb-6 ${centered ? '' : ''}`}>
      <span class="text-xs font-bold text-primary-700 tracking-wider uppercase">{badge}</span>
    </div>
  )}

  <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4" set:html={title}>
  </h2>

  {subtitle && (
    <p class={`text-xl text-gray-700 ${centered ? 'max-w-2xl mx-auto' : 'max-w-2xl'}`}>
      {subtitle}
    </p>
  )}
</div>
