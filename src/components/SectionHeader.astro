---
interface Props {
  badge?: string;
  title: string;
  subtitle?: string;
  centered?: boolean;
  theme?: 'light' | 'dark';
}

const { badge, title, subtitle, centered = true, theme = 'light' } = Astro.props;

const isDark = theme === 'dark';
const badgeBg = isDark ? 'bg-primary-900/50' : 'bg-primary-600/10';
const badgeBorder = isDark ? 'border-primary-500' : 'border-primary-600';
const badgeText = isDark ? 'text-primary-300' : 'text-primary-700';
const titleText = isDark ? 'text-white' : 'text-gray-900';
const subtitleText = isDark ? 'text-gray-300' : 'text-gray-700';
---

<div class={centered ? 'text-center mb-16' : 'mb-16'}>
  {badge && (
    <div class={`inline-flex items-center px-4 py-2 ${badgeBg} border-l-4 ${badgeBorder} rounded-r-lg mb-6`}>
      <span class={`text-xs font-bold ${badgeText} tracking-wider uppercase`}>{badge}</span>
    </div>
  )}

  <h2 class={`text-4xl md:text-5xl font-bold ${titleText} mb-4`} set:html={title}>
  </h2>

  {subtitle && (
    <p class={`text-xl ${subtitleText} ${centered ? 'max-w-2xl mx-auto' : 'max-w-2xl'}`}>
      {subtitle}
    </p>
  )}
</div>
