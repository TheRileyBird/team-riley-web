<dialog
  id="free-guide"
  aria-label="Get your free website and marketing guide"
  class="m-auto h-[calc(100dvh-1rem)] w-[calc(100%-1rem)] max-w-3xl overflow-hidden rounded-2xl bg-white p-0 shadow-2xl backdrop:bg-black/70 md:h-[min(90dvh,900px)]"
>
  <button
    type="button"
    data-guide-modal-close
    aria-label="Close free guide form"
    class="absolute right-4 top-4 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-primary-700 text-white shadow-lg transition-colors hover:bg-primary-800 focus:outline-none focus:ring-2 focus:ring-primary-700 focus:ring-offset-2"
  >
    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>
  <div class="h-full overflow-y-auto bg-white">
    <iframe
      src="https://app.teamrileyweb.com/widget/form/rkNGGX4oB8hDX5V5wSUW"
      style="width:100%;height:1073px;border:none;border-radius:4px"
      id="inline-rkNGGX4oB8hDX5V5wSUW"
      data-layout="{'id':'INLINE'}"
      data-trigger-type="alwaysShow"
      data-trigger-value=""
      data-activation-type="alwaysActivated"
      data-activation-value=""
      data-deactivation-type="neverDeactivate"
      data-deactivation-value=""
      data-form-name="Lead Generation"
      data-height="1073"
      data-layout-iframe-id="inline-rkNGGX4oB8hDX5V5wSUW"
      data-form-id="rkNGGX4oB8hDX5V5wSUW"
      title="Free Website and Marketing Guide"
    >
    </iframe>
  </div>
</dialog>
<script>
  const guideModal = document.querySelector<HTMLDialogElement>('#free-guide');
  const guideButtons = document.querySelectorAll<HTMLButtonElement>('[data-guide-modal-open]');
  const closeGuideButton = document.querySelector<HTMLButtonElement>('[data-guide-modal-close]');

  const openGuideModal = () => {
    if (!guideModal || typeof guideModal.showModal !== 'function') {
      return;
    }

    if (!guideModal.open) {
      guideModal.showModal();
    }
  };

  const closeGuideModal = () => {
    if (guideModal?.open) {
      guideModal.close();
    }
  };

  guideButtons.forEach((button) => {
    button.addEventListener('click', openGuideModal);
  });

  closeGuideButton?.addEventListener('click', closeGuideModal);
  guideModal?.addEventListener('click', (event) => {
    if (event.target === guideModal) {
      closeGuideModal();
    }
  });
</script>
