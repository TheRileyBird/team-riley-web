      </div>

      <!-- Company -->
      <div>
        <h4 class="text-white font-bold text-xl mb-8">Company</h4>
        <ul class="space-y-5">
          <li><a href="/about" class="text-gray-400 hover:text-accent-400 transition-colors flex items-center gap-3 group text-lg">
            <span class="w-2 h-2 bg-gray-600 group-hover:bg-accent-400 rounded-full transition-colors"></span>
