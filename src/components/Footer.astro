<footer class="relative bg-gradient-to-b from-gray-900 via-gray-950 to-black text-gray-300 pt-32 md:pt-40 pb-16 overflow-hidden">
  <!-- Background decoration -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-20 left-1/4 w-[500px] h-[500px] bg-primary-700/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-20 right-1/4 w-[400px] h-[400px] bg-accent-500/10 rounded-full blur-3xl"></div>
    <div class="absolute top-1/2 right-1/3 w-72 h-72 bg-secondary-500/5 rounded-full blur-3xl"></div>
  </div>

  <!-- Top CTA Section -->
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-28 md:mb-32">
    <div class="relative bg-gradient-to-r from-primary-800/50 via-primary-700/30 to-primary-800/50 backdrop-blur-sm rounded-3xl p-10 md:p-16 lg:p-20 border border-primary-700/30 overflow-hidden">
      <div class="absolute inset-0 shimmer-overlay-footer"></div>
      <div class="relative z-10 text-center">
        <h3 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
          Get Your Free Website & Marketing Guide
        </h3>
        <p class="text-xl md:text-2xl text-gray-300 mb-10 max-w-3xl mx-auto leading-relaxed">
          Discover the practical steps to build a stronger online presence, attract more clients, and grow your health or wellness business.
        </p>
        <button
          type="button"
          data-guide-modal-open
          class="btn btn-secondary btn-xl rounded-2xl"
        >
          Get Your Free Guide
          <ArrowRight class="w-6 h-6" />
        </button>
      </div>
    </div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
