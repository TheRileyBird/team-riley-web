          <li><a href="/contact" class="text-gray-400 hover:text-accent-400 transition-colors flex items-center gap-3 group text-lg">
            <span class="w-2 h-2 bg-gray-600 group-hover:bg-accent-400 rounded-full transition-colors"></span>
