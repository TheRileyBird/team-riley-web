---
import {ArrowRight, Menu, X} from '@lucide/astro';
import { Image } from 'astro:assets';
import teamRileyLogo from '../assets/images/team-riley-logo-gradient.png';

const currentPath = Astro.url.pathname;

// Helper function to check if link is active
const isActive = (path: string) => {
  if (path === '/' && currentPath === '/') return true;
  if (path !== '/' && currentPath.startsWith(path)) return true;
  return false;
};
---

<nav
  class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-sm border-b border-transparent transition-[border-color,box-shadow] duration-200"
  x-data="{
    mobileMenuOpen: false,
    scrolled: false,
    init() {
      this.scrolled = window.scrollY > 8;
    }
  }"
  @scroll.window="scrolled = window.scrollY > 8"
  :class="scrolled ? 'border-gray-100 shadow-sm' : 'border-transparent'"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <!-- Logo -->
      <div class="flex-shrink-0">
        <a href="/" class="flex items-center gap-3">
          <Image src={teamRileyLogo} alt="Team Riley logo" class="h-10 w-10 object-contain" />
          <span class="text-xl font-bold animated-gradient-text">Team Riley</span>
        </a>
      </div>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-8">
        <a href="/services" class={`text-sm font-medium transition-colors ${isActive('/services') ? 'text-primary-700 font-semibold' : 'text-gray-600 hover:text-primary-700'}`}>Services</a>
        <!--<a href="/platform" class={`text-sm font-medium transition-colors ${isActive('/platform') ? 'text-primary-700 font-semibold' : 'text-gray-600 hover:text-primary-700'}`}>Platform</a>-->
        <a href="/pricing" class={`text-sm font-medium transition-colors ${isActive('/pricing') ? 'text-primary-700 font-semibold' : 'text-gray-600 hover:text-primary-700'}`}>Pricing</a>
        <a href="/portfolio" class={`text-sm font-medium transition-colors ${isActive('/portfolio') ? 'text-primary-700 font-semibold' : 'text-gray-600 hover:text-primary-700'}`}>Portfolio</a>
        <a href="/about" class={`text-sm font-medium transition-colors ${isActive('/about') ? 'text-primary-700 font-semibold' : 'text-gray-600 hover:text-primary-700'}`}>About</a>
        <a href="/contact" class={`text-sm font-medium transition-colors ${isActive('/contact') ? 'text-primary-700 font-semibold' : 'text-gray-600 hover:text-primary-700'}`}>Contact</a>
      </div>

      <!-- CTA Button -->
      <div class="hidden md:block">
        <a href="/#book-a-call"
          data-booking-modal-open
          class="btn btn-primary btn-sm hover:!translate-y-0">
          Get Started
          <ArrowRight class="w-4 h-4" />
        </a>
      </div>

      <!-- Mobile menu button -->
      <button
        @click="mobileMenuOpen = !mobileMenuOpen"
        class="md:hidden p-2 rounded-lg text-gray-600 hover:bg-gray-100 transition-colors">
        <Menu class="w-6 h-6" x-show="!mobileMenuOpen" />
        <X class="w-6 h-6" x-show="mobileMenuOpen" x-cloak />
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div x-show="mobileMenuOpen"
       x-cloak
       x-transition:enter="transition ease-out duration-200"
       x-transition:enter-start="opacity-0 -translate-y-2"
       x-transition:enter-end="opacity-100 translate-y-0"
       class="md:hidden border-t border-gray-100 bg-white">
    <div class="px-4 py-6 space-y-4">
      <a href="/services" class={`block text-base font-medium ${isActive('/services') ? 'text-primary-700 font-semibold' : 'text-gray-700 hover:text-primary-700'}`}>Services</a>
      <a href="/platform" class={`block text-base font-medium ${isActive('/platform') ? 'text-primary-700 font-semibold' : 'text-gray-700 hover:text-primary-700'}`}>Platform</a>
      <a href="/pricing" class={`block text-base font-medium ${isActive('/pricing') ? 'text-primary-700 font-semibold' : 'text-gray-700 hover:text-primary-700'}`}>Pricing</a>
      <a href="/portfolio" class={`block text-base font-medium ${isActive('/portfolio') ? 'text-primary-700 font-semibold' : 'text-gray-700 hover:text-primary-700'}`}>Portfolio</a>
      <a href="/about" class={`block text-base font-medium ${isActive('/about') ? 'text-primary-700 font-semibold' : 'text-gray-700 hover:text-primary-700'}`}>About</a>
      <a href="/contact" class={`block text-base font-medium ${isActive('/contact') ? 'text-primary-700 font-semibold' : 'text-gray-700 hover:text-primary-700'}`}>Contact</a>
      <a href="/#book-a-call"
        data-booking-modal-open
        class="btn btn-primary btn-sm w-full justify-center hover:!translate-y-0">
        Get Started
        <ArrowRight class="w-4 h-4" />
      </a>
    </div>
  </div>
</nav>

<style>
  [x-cloak] {
    display: none !important;
  }

  .animated-gradient-text {
    background: linear-gradient(90deg, #1e40af, #0891b2, #8b5cf6, #1e40af);
    background-size: 300% 100%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: gradient-shift 8s ease infinite;
  }

  @keyframes gradient-shift {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }
</style>
