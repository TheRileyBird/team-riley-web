---
import { Menu, X } from 'lucide-astro';
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-sm border-b border-gray-100"
     x-data="{ mobileMenuOpen: false }">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <!-- Logo -->
      <div class="flex-shrink-0">
        <a href="/" class="text-xl font-bold bg-gradient-to-r from-primary-800 via-primary-700 to-accent-500 bg-clip-text text-transparent">
          Team Riley Wellness
        </a>
      </div>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-8">
        <a href="#services" class="text-sm font-medium text-gray-600 hover:text-primary-700 transition-colors">Services</a>
        <a href="#pricing" class="text-sm font-medium text-gray-600 hover:text-primary-700 transition-colors">Pricing</a>
        <a href="#process" class="text-sm font-medium text-gray-600 hover:text-primary-700 transition-colors">Process</a>
        <a href="#contact" class="text-sm font-medium text-gray-600 hover:text-primary-700 transition-colors">Contact</a>
      </div>

      <!-- CTA Button -->
      <div class="hidden md:block">
        <a href="#get-started"
           class="inline-flex items-center px-5 py-2.5 text-sm font-semibold text-white bg-gradient-to-r from-primary-700 to-primary-600 rounded-lg shadow-medium hover:shadow-large hover:scale-105 transition-all duration-200">
          Get Started
        </a>
      </div>

      <!-- Mobile menu button -->
      <button
        @click="mobileMenuOpen = !mobileMenuOpen"
        class="md:hidden p-2 rounded-lg text-gray-600 hover:bg-gray-100 transition-colors">
        <Menu class="w-6 h-6" x-show="!mobileMenuOpen" />
        <X class="w-6 h-6" x-show="mobileMenuOpen" x-cloak />
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div x-show="mobileMenuOpen"
       x-cloak
       x-transition:enter="transition ease-out duration-200"
       x-transition:enter-start="opacity-0 -translate-y-2"
       x-transition:enter-end="opacity-100 translate-y-0"
       class="md:hidden border-t border-gray-100 bg-white">
    <div class="px-4 py-6 space-y-4">
      <a href="#services" class="block text-base font-medium text-gray-700 hover:text-primary-700">Services</a>
      <a href="#pricing" class="block text-base font-medium text-gray-700 hover:text-primary-700">Pricing</a>
      <a href="#process" class="block text-base font-medium text-gray-700 hover:text-primary-700">Process</a>
      <a href="#contact" class="block text-base font-medium text-gray-700 hover:text-primary-700">Contact</a>
      <a href="#get-started"
         class="block text-center px-5 py-2.5 text-sm font-semibold text-white bg-gradient-to-r from-primary-700 to-primary-600 rounded-lg shadow-medium">
        Get Started
      </a>
    </div>
  </div>
</nav>

<style>
  [x-cloak] {
    display: none !important;
  }
</style>
